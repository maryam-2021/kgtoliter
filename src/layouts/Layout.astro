---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  canonical?: string;
  schema?: Record<string, any> | Record<string, any>[];
  ogImage?: string;
  image?: string;
  article?: boolean;
  locale?: string;
  noIndex?: boolean;
  ogType?: string;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <slot />
</BaseLayout>
