---
// src/layouts/BaseLayout.astro
import '../styles/global.css';

import { useI18n } from '@utils/i18n';
import { defaultLocale, getLocaleDirection } from '@i18n/config';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import OrganizationSchema from '@components/schemas/OrganizationSchema.astro';
import BreadcrumbSchema, { type BreadcrumbItem } from '@components/schemas/BreadcrumbSchema.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  ogImage?: string;
  locale?: string;
  canonical?: string;
  canonicalUrl?: string;
  noIndex?: boolean;
  ogType?: string;
  article?: boolean;
  schema?: Record<string, any> | Record<string, any>[];
  breadcrumbs?: BreadcrumbItem[];
}

const {
  title,
  description,
  image = '/og-image.png',
  ogImage,
  locale = defaultLocale,
  canonical = Astro.url.href,
  canonicalUrl,
  noIndex = false,
  ogType = 'website',
  article = false,
  schema,
  breadcrumbs,
} = Astro.props;

const { t, isRTL } = useI18n(locale);
const siteUrl = 'https://kgtoliter.com';
const siteName = 'Kg to Litre';

// Compute automatic breadcrumbs for schema if not explicitly provided
const defaultBreadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', url: `${siteUrl}/` },
];

const pathSegments = Astro.url.pathname.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
if (pathSegments.length > 0) {
  let accumulatedPath = '';
  pathSegments.forEach((segment) => {
    accumulatedPath += `/${segment}`;
    const formattedName = segment
      .replace(/-/g, ' ')
      .replace(/\b\w/g, (c) => c.toUpperCase());
    defaultBreadcrumbs.push({
      name: formattedName,
      url: `${siteUrl}${accumulatedPath}/`,
    });
  });
}

const effectiveBreadcrumbs = breadcrumbs || defaultBreadcrumbs;

const effectiveImage = ogImage || image;
const fullImageUrl = effectiveImage.startsWith('http')
  ? effectiveImage
  : `${siteUrl}${effectiveImage}`;

const effectiveCanonical = canonicalUrl
  ? canonicalUrl.startsWith('http')
    ? canonicalUrl
    : `${siteUrl}${canonicalUrl}`
  : canonical;

const localeDir = getLocaleDirection(locale);

// Social links
const socialLinks = [
  'https://facebook.com/kgtoliter',
  'https://twitter.com/kgtoliter',
  'https://linkedin.com/company/kgtoliter',
  'https://pinterest.com/kgtoliter',
];

const hasBrandInTitle = /kg\s*to\s*litres?|kgtoliter\.com/i.test(title);
const pageTitle = hasBrandInTitle ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang={locale} dir={localeDir} class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={effectiveCanonical} />

    <!-- Robots -->
    {
      noIndex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <>
          <meta name="robots" content="index, follow" />
          <meta
            name="googlebot"
            content="index, follow, max-snippet:-1, max-image-preview:large"
          />
        </>
      )
    }

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={effectiveCanonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:type" content={article ? 'article' : ogType} />

    <!-- Twitter -->
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563eb" />

    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <BreadcrumbSchema items={effectiveBreadcrumbs} />

    <OrganizationSchema site={{ name: siteName, url: siteUrl, description, socialLinks }} />
  </head>
  <body class="bg-surface-950 text-slate-100 flex flex-col min-h-screen bg-mesh">
    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-brand-500 focus:text-white focus:rounded-xl focus:shadow-xl font-semibold text-xs transition-all"
    >
      Skip to main content
    </a>

    <Header locale={locale} t={t} isRTL={isRTL} />

    <main id="main-content" tabindex="-1" class="min-h-screen flex-grow relative outline-none">
      <slot />
    </main>

    <Footer
      locale={locale}
      t={t}
      isRTL={isRTL}
      socialLinks={socialLinks}
      currentYear={new Date().getFullYear()}
    />

    <!-- Intersection Observer for Section Reveal Animations -->
    <script is:inline>
      function setupRevealObserver() {
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('.reveal-section, .stagger-children').forEach((el) => {
            el.classList.add('revealed');
          });
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: '0px 0px 50px 0px' }
        );

        document.querySelectorAll('.reveal-section, .stagger-children').forEach((el) => {
          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupRevealObserver);
      } else {
        setupRevealObserver();
      }
      document.addEventListener('astro:page-load', setupRevealObserver);
    </script>

    <!-- PWA Service Worker -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/service-worker.js').catch((error) => {
            console.error('Service worker registration failed.', error);
          });
        });
      }
    </script>
  </body>
</html>
