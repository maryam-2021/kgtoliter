---
import { catalogItems, getCatalogItem } from '../data/catalog';
import TemperatureDisclaimer from './TemperatureDisclaimer.astro';
import CustomDensityInput from './CustomDensityInput.astro';

export interface Props {
  defaultSubstanceId?: string;
}

const { defaultSubstanceId = 'water' } = Astro.props;
const defaultSubstance = getCatalogItem(defaultSubstanceId) ?? catalogItems[0];
const initialVolume = 1 / defaultSubstance.density;

const categoriesList = [
  { id: 'all', name: 'All' },
  { id: 'cooking', name: '🍳 Cooking' },
  { id: 'fuels', name: '⛽ Fuel' },
  { id: 'industrial', name: '🧪 Chemical' },
  { id: 'automotive', name: '🚗 Auto' },
  { id: 'construction', name: '🏗️ Construction' },
  { id: 'agriculture', name: '🌾 Agri' },
];
---

<div
  class="glass-card rounded-2xl p-4 sm:p-8 border border-slate-800 shadow-xl max-w-4xl mx-auto space-y-6"
  id="calculator-root"
>
  <!-- Converter Controls Bar: Direction Mode, Swap & Reset -->
  <div
    class="flex items-center justify-between gap-3 pb-3 border-b border-slate-800"
  >
    <!-- Mode Toggle (kg -> L vs L -> kg) -->
    <div
      class="inline-flex p-1 rounded-xl bg-slate-900 border border-slate-800"
      role="group"
      aria-label="Conversion direction"
    >
      <button
        id="mode-kg-to-l"
        type="button"
        aria-pressed="true"
        class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-brand-500 text-slate-950 shadow-md transition-all cursor-pointer"
      >
        kg &rarr; litre
      </button>
      <button
        id="mode-l-to-kg"
        type="button"
        aria-pressed="false"
        class="px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition-all cursor-pointer"
      >
        litre &rarr; kg
      </button>
    </div>

    <!-- Quick Action Controls: Swap & Reset -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        id="swap-direction-btn"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-medium text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all cursor-pointer shadow-sm"
        title="Swap conversion direction (kg ↔ L)"
        aria-label="Swap conversion direction"
      >
        <svg class="w-3.5 h-3.5 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
        </svg>
        <span>Swap ↔</span>
      </button>

      <button
        type="button"
        id="reset-btn"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-medium text-slate-400 hover:text-white hover:border-slate-700 transition-all cursor-pointer shadow-sm"
        title="Reset calculator to defaults"
        aria-label="Reset calculator"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Reset</span>
      </button>
    </div>
  </div>

  <div class="space-y-5">
    <!-- Value Input & Quick Presets -->
    <div>
      <div class="flex items-center justify-between mb-1.5">
        <label
          id="input-label"
          for="mass"
          class="block text-xs font-semibold text-slate-300 uppercase tracking-wider font-mono"
        >
          Mass in Kilograms (kg)
        </label>
        <span id="input-helper-text" class="text-[11px] text-slate-400">Enter weight to convert</span>
      </div>

      <div class="relative">
        <input
          type="number"
          id="mass"
          name="mass"
          step="any"
          min="0"
          value="1"
          placeholder="1.0"
          class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-mono text-lg sm:text-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition-all"
        />
        <span
          id="input-unit"
          class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400 font-mono bg-slate-800 px-2 py-1 rounded"
        >
          kg
        </span>
      </div>

      <!-- Quick Amount Preset Buttons -->
      <div class="flex flex-wrap items-center gap-1.5 pt-2">
        <span class="text-[11px] text-slate-400 font-mono">Presets:</span>
        <button type="button" class="quick-amt text-xs px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-brand-500/20 hover:text-brand-300 text-slate-300 transition-colors border border-white/[0.04] cursor-pointer font-mono" data-val="1">1</button>
        <button type="button" class="quick-amt text-xs px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-brand-500/20 hover:text-brand-300 text-slate-300 transition-colors border border-white/[0.04] cursor-pointer font-mono" data-val="5">5</button>
        <button type="button" class="quick-amt text-xs px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-brand-500/20 hover:text-brand-300 text-slate-300 transition-colors border border-white/[0.04] cursor-pointer font-mono" data-val="10">10</button>
        <button type="button" class="quick-amt text-xs px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-brand-500/20 hover:text-brand-300 text-slate-300 transition-colors border border-white/[0.04] cursor-pointer font-mono" data-val="25">25</button>
        <button type="button" class="quick-amt text-xs px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-brand-500/20 hover:text-brand-300 text-slate-300 transition-colors border border-white/[0.04] cursor-pointer font-mono" data-val="100">100</button>
        <button type="button" class="quick-amt text-xs px-2.5 py-1 rounded-lg bg-slate-800/80 hover:bg-brand-500/20 hover:text-brand-300 text-slate-300 transition-colors border border-white/[0.04] cursor-pointer font-mono" data-val="1000">1,000</button>
      </div>
    </div>

    <!-- Substance Search & Selection Module -->
    <div class="space-y-2">
      <div class="flex items-center justify-between">
        <label
          for="substance-search"
          class="block text-xs font-semibold text-slate-300 uppercase tracking-wider font-mono"
        >
          Select Material / Substance
        </label>
        <span id="substance-count-chip" class="text-[11px] text-slate-400 font-mono">700+ Available</span>
      </div>

      <!-- Search Input Filter -->
      <div class="relative">
        <input
          type="text"
          id="substance-search"
          placeholder="Type to filter substances (e.g. diesel, milk, olive oil, acetone, concrete)..."
          class="w-full pl-9 pr-8 py-2.5 rounded-xl bg-slate-900/90 border border-slate-700 text-white text-xs sm:text-sm focus:ring-2 focus:ring-brand-500 outline-none transition-all placeholder:text-slate-500"
        />
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <button
          type="button"
          id="clear-search-btn"
          class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 p-1 text-slate-400 hover:text-white rounded cursor-pointer"
          title="Clear search filter"
        >
          &times;
        </button>
      </div>

      <!-- Common Substance Preset Chips -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar text-xs">
        <span class="text-[11px] text-slate-400 font-mono shrink-0">Common:</span>
        <button type="button" class="substance-chip px-2.5 py-1 rounded-lg bg-brand-500/20 text-brand-300 border border-brand-500/40 transition-all shrink-0 cursor-pointer font-medium text-xs flex items-center gap-1 active:scale-95" data-id="water" data-density="1.000">💧 Water</button>
        <button type="button" class="substance-chip px-2.5 py-1 rounded-lg bg-slate-800/90 hover:bg-brand-500/20 hover:text-brand-300 text-slate-300 border border-white/[0.06] transition-all shrink-0 cursor-pointer font-medium text-xs flex items-center gap-1 active:scale-95" data-id="milk" data-density="1.030">🥛 Milk</button>
        <button type="button" class="substance-chip px-2.5 py-1 rounded-lg bg-slate-800/90 hover:bg-brand-500/20 hover:text-brand-300 text-slate-300 border border-white/[0.06] transition-all shrink-0 cursor-pointer font-medium text-xs flex items-center gap-1 active:scale-95" data-id="olive-oil" data-density="0.910">🫒 Oil</button>
        <button type="button" class="substance-chip px-2.5 py-1 rounded-lg bg-slate-800/90 hover:bg-brand-500/20 hover:text-brand-300 text-slate-300 border border-white/[0.06] transition-all shrink-0 cursor-pointer font-medium text-xs flex items-center gap-1 active:scale-95" data-id="diesel" data-density="0.832">⛽ Diesel</button>
        <button type="button" class="substance-chip px-2.5 py-1 rounded-lg bg-slate-800/90 hover:bg-brand-500/20 hover:text-brand-300 text-slate-300 border border-white/[0.06] transition-all shrink-0 cursor-pointer font-medium text-xs flex items-center gap-1 active:scale-95" data-id="petrol" data-density="0.748">🚗 Gasoline</button>
        <button type="button" class="substance-chip px-2.5 py-1 rounded-lg bg-slate-800/90 hover:bg-brand-500/20 hover:text-brand-300 text-slate-300 border border-white/[0.06] transition-all shrink-0 cursor-pointer font-medium text-xs flex items-center gap-1 active:scale-95" data-id="honey" data-density="1.420">🍯 Honey</button>
      </div>

      <!-- Quick Category Pills -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar">
        {categoriesList.map((cat) => (
          <button
            type="button"
            class="category-filter-btn text-[11px] px-2.5 py-1 rounded-lg bg-slate-900 border border-slate-800 text-slate-400 hover:text-white hover:border-slate-700 transition-all shrink-0 cursor-pointer"
            data-category={cat.id}
          >
            {cat.name}
          </button>
        ))}
      </div>

      <!-- Substance Dropdown -->
      <div class="relative">
        <select
          id="substance"
          name="substance"
          class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:ring-2 focus:ring-brand-500 outline-none appearance-none cursor-pointer font-mono"
        >
          {
            (
              <option
                value={defaultSubstance.density}
                data-name={defaultSubstance.name}
                data-note={defaultSubstance.notes}
                data-id={defaultSubstance.id}
                data-catalog-key={defaultSubstance.catalogKey}
                data-temperature={defaultSubstance.temperature}
                data-category={defaultSubstance.category}
                selected
              >
                {defaultSubstance.name} ({defaultSubstance.density} kg/L)
              </option>
            )
          }
        </select>
        <div class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400">
          ▼
        </div>
      </div>

      <!-- Custom Density Override Section -->
      <CustomDensityInput initialDensity={defaultSubstance.density} />
    </div>

    <!-- Conversion Result Card -->
    <div
      class="converter-result-expanded p-5 sm:p-6 rounded-2xl border border-brand-500/30 flex flex-col gap-4 shadow-lg shadow-brand-500/5"
    >
      <div class="result-main flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-white/[0.08]">
        <div class="space-y-1">
          <p
            id="result-label"
            class="text-xs font-semibold text-slate-400 uppercase tracking-wider font-mono"
          >
            Resulting Volume:
          </p>
          <p class="flex items-baseline gap-2.5">
            <span id="result" class="result-value text-3xl sm:text-4xl font-extrabold text-brand-400 font-mono tracking-tight">{initialVolume.toFixed(3)}</span>
            <span id="resultValue" class="hidden">{initialVolume.toFixed(3)}</span>
            <span id="result-unit" class="result-unit text-base sm:text-lg font-bold text-slate-300 font-mono">Litres</span>
          </p>
          <p id="density-note" class="text-xs text-slate-400">
            Based on {defaultSubstance.name} density {defaultSubstance.density} kg/L ({
              defaultSubstance.notes
            })
          </p>
        </div>

        <!-- Action Buttons: Copy & Share -->
        <div class="flex items-center gap-2 w-full sm:w-auto shrink-0 pt-2 sm:pt-0">
          <!-- Copy Button -->
          <button
            type="button"
            id="copy-btn"
            class="flex-1 sm:flex-initial px-3.5 py-2.5 rounded-xl bg-brand-500 hover:bg-brand-400 text-slate-950 font-bold text-xs flex items-center justify-center gap-2 transition-all shadow-md active:scale-95 cursor-pointer"
            title="Copy formatted result to clipboard"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
              ></path>
            </svg>
            <span id="copy-text">Copy Result</span>
          </button>

          <!-- Share Result Link Button -->
          <button
            type="button"
            id="share-btn"
            class="flex-1 sm:flex-initial px-3.5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs flex items-center justify-center gap-2 border border-slate-700 transition-all active:scale-95 cursor-pointer"
            title="Copy link to this exact calculation"
          >
            <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
            </svg>
            <span id="share-text">Share Link</span>
          </button>
        </div>
      </div>

      <!-- Real-World Variability & Tolerance Range Box -->
      <div id="range-result-box" class="p-3 rounded-xl bg-slate-950/80 border border-brand-500/20 text-xs font-mono flex flex-col sm:flex-row items-start sm:items-center justify-between gap-1">
        <span class="text-slate-400 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-brand-400"></span>
          <span>Real-World Tolerance Span:</span>
        </span>
        <span id="range-result-value" class="text-brand-300 font-bold">
          {(1 / (defaultSubstance.densityRange?.max || defaultSubstance.density * 1.03)).toFixed(3)} L – {(1 / (defaultSubstance.densityRange?.min || defaultSubstance.density * 0.97)).toFixed(3)} L
        </span>
      </div>

      <!-- Expanded Conversions Section -->
      <div class="space-y-2 pt-1">
        <div class="flex items-center justify-between text-[11px] font-mono text-slate-400 uppercase tracking-wider">
          <span>Alternative Units &amp; Equivalents:</span>
        </div>
        <div class="result-conversions">
          <div class="conversion-item">
            <span class="conversion-label" id="conv-label-1">Millilitres</span>
            <span class="conversion-value" id="resultML">{(initialVolume * 1000).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}</span>
          </div>
          <div class="conversion-item">
            <span class="conversion-label" id="conv-label-2">US Gallons</span>
            <span class="conversion-value" id="resultGal">{(initialVolume / 3.78541).toFixed(3)}</span>
          </div>
          <div class="conversion-item">
            <span class="conversion-label" id="conv-label-3">UK Gallons</span>
            <span class="conversion-value" id="resultUKGal">{(initialVolume / 4.54609).toFixed(3)}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Physical Property Cards -->
    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1 text-xs">
      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-3">
        <dt class="text-slate-500 uppercase tracking-wider font-mono">Reference Density</dt>
        <dd id="converter-density" class="text-brand-400 font-mono font-bold mt-1">
          {defaultSubstance.density.toFixed(3)} kg/L
        </dd>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-3">
        <dt class="text-slate-500 uppercase tracking-wider font-mono">Density Range</dt>
        <dd id="converter-density-range" class="text-white font-mono font-bold mt-1">
          {defaultSubstance.densityRange ? `${defaultSubstance.densityRange.min.toFixed(3)}–${defaultSubstance.densityRange.max.toFixed(3)}` : `${(defaultSubstance.density * 0.97).toFixed(3)}–${(defaultSubstance.density * 1.03).toFixed(3)}`} kg/L
        </dd>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-3">
        <dt class="text-slate-500 uppercase tracking-wider font-mono">Standard Temp</dt>
        <dd id="converter-temperature" class="text-slate-300 font-mono font-bold mt-1">
          {defaultSubstance.temperature}°C
        </dd>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-3">
        <dt class="text-slate-500 uppercase tracking-wider font-mono">Active Formula</dt>
        <dd id="converter-formula" class="text-emerald-400 font-mono font-bold mt-1">V = m ÷ ρ</dd>
      </div>
    </dl>
    <TemperatureDisclaimer />
  </div>
</div>

<!-- Mobile Sticky Result Bar (Slides up when scrolling past the calculator) -->
<aside
  id="mobile-sticky-bar"
  class="fixed bottom-0 inset-x-0 z-40 bg-surface-950/95 backdrop-blur-xl border-t border-brand-500/30 px-4 py-2.5 sm:hidden shadow-2xl transition-transform duration-300 translate-y-full flex items-center justify-between gap-3"
  aria-label="Conversion Result"
>
  <div class="min-w-0 flex-1">
    <div class="text-[11px] text-slate-400 font-mono truncate" id="sticky-summary">
      1 kg of Water =
    </div>
    <div class="text-base font-extrabold text-brand-400 font-mono tracking-tight flex items-baseline gap-1">
      <span id="sticky-result-val">1.000</span>
      <span id="sticky-result-unit" class="text-xs text-slate-300">Litres</span>
    </div>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <button
      type="button"
      id="sticky-copy-btn"
      class="px-3.5 py-1.5 rounded-lg bg-brand-500 text-slate-950 font-bold text-xs shadow hover:bg-brand-400 active:scale-95 transition-all cursor-pointer"
    >
      Copy
    </button>
    <a
      href="#calculator-root"
      class="p-1.5 rounded-lg bg-slate-800 text-slate-300 hover:text-white border border-slate-700 text-xs flex items-center justify-center cursor-pointer"
      title="Scroll to Calculator"
      aria-label="Scroll to Calculator"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
      </svg>
    </a>
  </div>
</aside>

<script>
  import type { CatalogItem } from '../data/catalog';
  import { loadSubstancesCatalog } from '../utils/catalogLoader';

  const liquidColors: Record<string, string> = {
    water: '#60a5fa',
    milk: '#f3f4f6',
    'cooking-oil': '#facc15',
    diesel: '#475569',
    flour: '#fef3c7',
  };

  document.addEventListener('DOMContentLoaded', () => {
    let mode = 'kg-to-l';
    let fullCatalog: CatalogItem[] = [];
    let activeCategory = 'all';

    const massInput = document.getElementById('mass') as HTMLInputElement;
    const substanceSelect = document.getElementById('substance') as HTMLSelectElement;
    const substanceSearchInput = document.getElementById('substance-search') as HTMLInputElement;
    const clearSearchBtn = document.getElementById('clear-search-btn') as HTMLButtonElement;
    const substanceCountChip = document.getElementById('substance-count-chip') as HTMLSpanElement;
    const resultDisplay = document.getElementById('result') as HTMLSpanElement;
    const resultValue = document.getElementById('resultValue') as HTMLSpanElement;
    const resultML = document.getElementById('resultML') as HTMLSpanElement;
    const resultGal = document.getElementById('resultGal') as HTMLSpanElement;
    const resultUKGal = document.getElementById('resultUKGal') as HTMLSpanElement;
    const convLabel1 = document.getElementById('conv-label-1') as HTMLSpanElement;
    const convLabel2 = document.getElementById('conv-label-2') as HTMLSpanElement;
    const convLabel3 = document.getElementById('conv-label-3') as HTMLSpanElement;
    const resultUnit = document.getElementById('result-unit') as HTMLSpanElement;
    const resultLabel = document.getElementById('result-label') as HTMLParagraphElement;
    const noteDisplay = document.getElementById('density-note') as HTMLParagraphElement;
    const inputLabel = document.getElementById('input-label') as HTMLLabelElement;
    const inputUnit = document.getElementById('input-unit') as HTMLSpanElement;
    const inputHelperText = document.getElementById('input-helper-text') as HTMLSpanElement;
    const densityDisplay = document.getElementById('converter-density');
    const densityRangeDisplay = document.getElementById('converter-density-range');
    const temperatureDisplay = document.getElementById('converter-temperature');
    const formulaDisplay = document.getElementById('converter-formula');
    const rangeResultValue = document.getElementById('range-result-value');

    const modeKgToLBtn = document.getElementById('mode-kg-to-l');
    const modeLToKgBtn = document.getElementById('mode-l-to-kg');
    const swapDirectionBtn = document.getElementById('swap-direction-btn');
    const resetBtn = document.getElementById('reset-btn');
    const quickBtns = document.querySelectorAll('.quick-amt');
    const substanceChips = document.querySelectorAll('.substance-chip');
    const copyBtn = document.getElementById('copy-btn');
    const copyText = document.getElementById('copy-text');
    const shareBtn = document.getElementById('share-btn');
    const shareText = document.getElementById('share-text');
    const categoryFilterBtns = document.querySelectorAll('.category-filter-btn');

    // Mobile Sticky Bar Elements
    const mobileStickyBar = document.getElementById('mobile-sticky-bar');
    const stickySummary = document.getElementById('sticky-summary');
    const stickyResultVal = document.getElementById('sticky-result-val');
    const stickyResultUnit = document.getElementById('sticky-result-unit');
    const stickyCopyBtn = document.getElementById('sticky-copy-btn');

    const customDensityToggle = document.getElementById('customDensityToggle') as HTMLInputElement;
    const customDensityInput = document.getElementById('customDensityInput') as HTMLDivElement;
    const customDensityValue = document.getElementById('customDensityValue') as HTMLInputElement;
    const customDensityUnit = document.getElementById('customDensityUnit') as HTMLSelectElement;
    const customDensityNote = document.getElementById('customDensityNote') as HTMLSpanElement;

    if (!massInput || !substanceSelect || !resultDisplay) {
      return;
    }

    function updateConversions(volumeL: number) {
      if (mode === 'kg-to-l') {
        // Millilitres
        if (resultML) {
          resultML.textContent = (volumeL * 1000).toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 0,
          });
        }
        // US Gallons (1 US gal = 3.78541 L)
        if (resultGal) {
          resultGal.textContent = (volumeL / 3.78541).toFixed(3);
        }
        // UK Gallons (1 UK gal = 4.54609 L)
        if (resultUKGal) {
          resultUKGal.textContent = (volumeL / 4.54609).toFixed(3);
        }
        if (convLabel1) convLabel1.textContent = 'Millilitres';
        if (convLabel2) convLabel2.textContent = 'US Gallons';
        if (convLabel3) convLabel3.textContent = 'UK Gallons';
      } else {
        const massKg = volumeL;
        // Grams
        if (resultML) {
          resultML.textContent = (massKg * 1000).toLocaleString('en-US', {
            minimumFractionDigits: 0,
            maximumFractionDigits: 0,
          });
        }
        // Pounds (1 lb = 0.45359237 kg)
        if (resultGal) {
          resultGal.textContent = (massKg / 0.45359237).toFixed(3);
        }
        // Ounces (1 oz = 0.028349523 kg)
        if (resultUKGal) {
          resultUKGal.textContent = (massKg / 0.028349523).toFixed(2);
        }
        if (convLabel1) convLabel1.textContent = 'Grams (g)';
        if (convLabel2) convLabel2.textContent = 'Pounds (lbs)';
        if (convLabel3) convLabel3.textContent = 'Ounces (oz)';
      }
    }

    function calculateAndBroadcast() {
      const mass = parseFloat(massInput?.value || '0') || 0;
      const selectedOption = substanceSelect.options[substanceSelect.selectedIndex];
      let density = parseFloat(substanceSelect?.value || '1.000') || 1.0;
      let substanceId = selectedOption?.dataset.id || 'water';
      let substanceName = selectedOption?.dataset.name || 'Water';
      let densityNote = selectedOption?.dataset.note || '';
      let temperature = selectedOption?.dataset.temperature || '20';
      let minDensity = selectedOption?.dataset.min ? parseFloat(selectedOption.dataset.min) : density * 0.97;
      let maxDensity = selectedOption?.dataset.max ? parseFloat(selectedOption.dataset.max) : density * 1.03;

      if (customDensityToggle?.checked) {
        const rawVal = parseFloat(customDensityValue?.value || '1.0') || 1.0;
        const unit = customDensityUnit?.value || 'kg/L';
        const unitConversions: Record<string, number> = {
          'kg/L': 1,
          'g/mL': 1,
          'lb/ft3': 0.0160185,
          'kg/m3': 0.001,
        };
        const densityInKgL = rawVal * (unitConversions[unit] || 1);

        density = densityInKgL > 0 ? densityInKgL : 1.0;
        minDensity = density * 0.98;
        maxDensity = density * 1.02;
        substanceId = 'custom';
        substanceName = 'Custom Substance';
        densityNote = `Custom input: ${rawVal} ${unit}`;
        if (customDensityNote) {
          customDensityNote.textContent = `Density: ${rawVal} ${unit} = ${densityInKgL.toFixed(3)} kg/L`;
        }
      }

      const liquidColor = liquidColors[substanceId] || '#60a5fa';

      if (densityDisplay) densityDisplay.textContent = `${density.toFixed(3)} kg/L`;
      if (densityRangeDisplay) densityRangeDisplay.textContent = `${minDensity.toFixed(3)}–${maxDensity.toFixed(3)} kg/L`;
      if (temperatureDisplay) temperatureDisplay.textContent = `${temperature}°C`;

      if (mode === 'kg-to-l') {
        const volume = density > 0 ? mass / density : 0;
        const minVol = maxDensity > 0 ? mass / maxDensity : 0;
        const maxVol = minDensity > 0 ? mass / minDensity : 0;

        if (resultDisplay) resultDisplay.textContent = volume.toFixed(3);
        if (resultValue) resultValue.textContent = volume.toFixed(3);
        if (resultUnit) resultUnit.textContent = 'Litres';
        if (resultLabel) resultLabel.textContent = 'Resulting Volume:';

        // Update expanded conversions
        updateConversions(volume);

        if (rangeResultValue) {
          rangeResultValue.textContent = `${minVol.toFixed(3)} L – ${maxVol.toFixed(3)} L (at ${minDensity.toFixed(3)}–${maxDensity.toFixed(3)} kg/L)`;
        }
        if (noteDisplay)
          noteDisplay.textContent = `Based on ${substanceName} density ${density} kg/L (${densityNote})`;
        if (formulaDisplay) formulaDisplay.textContent = 'V = m ÷ ρ';

        window.dispatchEvent(
          new CustomEvent('kg-conversion-update', {
            detail: {
              mass: mass,
              density: density,
              volume: volume,
              substanceId: substanceId,
              substanceName: substanceName,
              liquidColor: liquidColor,
            },
          }),
        );
      } else {
        const massVal = mass * density;
        const volume = mass;
        const minMass = mass * minDensity;
        const maxMass = mass * maxDensity;

        if (resultDisplay) resultDisplay.textContent = massVal.toFixed(3);
        if (resultValue) resultValue.textContent = massVal.toFixed(3);
        if (resultUnit) resultUnit.textContent = 'Kilograms';
        if (resultLabel) resultLabel.textContent = 'Resulting Mass:';

        // Update expanded conversions (Mass)
        updateConversions(massVal);

        if (rangeResultValue) {
          rangeResultValue.textContent = `${minMass.toFixed(3)} kg – ${maxMass.toFixed(3)} kg (at ${minDensity.toFixed(3)}–${maxDensity.toFixed(3)} kg/L)`;
        }
        if (noteDisplay)
          noteDisplay.textContent = `Based on ${substanceName} density ${density} kg/L (${densityNote})`;
        if (formulaDisplay) formulaDisplay.textContent = 'm = V × ρ';

        window.dispatchEvent(
          new CustomEvent('kg-conversion-update', {
            detail: {
              mass: massVal,
              density: density,
              volume: volume,
              substanceId: substanceId,
              substanceName: substanceName,
              liquidColor: liquidColor,
            },
          }),
        );
      }

      // Update mobile sticky result bar
      if (stickySummary) {
        stickySummary.textContent = `${mass} ${mode === 'kg-to-l' ? 'kg' : 'L'} of ${substanceName} =`;
      }
      if (stickyResultVal && resultDisplay) {
        stickyResultVal.textContent = resultDisplay.textContent;
      }
      if (stickyResultUnit && resultUnit) {
        stickyResultUnit.textContent = resultUnit.textContent;
      }
    }

    function setMode(newMode: 'kg-to-l' | 'l-to-kg') {
      mode = newMode;
      if (mode === 'kg-to-l') {
        if (modeKgToLBtn)
          modeKgToLBtn.className =
            'px-3 py-1.5 text-xs font-semibold rounded-lg bg-brand-500 text-slate-950 shadow-md transition-all cursor-pointer';
        if (modeLToKgBtn)
          modeLToKgBtn.className =
            'px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition-all cursor-pointer';
        if (inputLabel) inputLabel.textContent = 'Mass in Kilograms (kg)';
        if (inputUnit) inputUnit.textContent = 'kg';
        if (inputHelperText) inputHelperText.textContent = 'Enter weight to convert';
        modeKgToLBtn?.setAttribute('aria-pressed', 'true');
        modeLToKgBtn?.setAttribute('aria-pressed', 'false');
      } else {
        if (modeLToKgBtn)
          modeLToKgBtn.className =
            'px-3 py-1.5 text-xs font-semibold rounded-lg bg-brand-500 text-slate-950 shadow-md transition-all cursor-pointer';
        if (modeKgToLBtn)
          modeKgToLBtn.className =
            'px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition-all cursor-pointer';
        if (inputLabel) inputLabel.textContent = 'Volume in Litres (L)';
        if (inputUnit) inputUnit.textContent = 'L';
        if (inputHelperText) inputHelperText.textContent = 'Enter volume to convert';
        modeLToKgBtn?.setAttribute('aria-pressed', 'true');
        modeKgToLBtn?.setAttribute('aria-pressed', 'false');
      }
      calculateAndBroadcast();
    }

    modeKgToLBtn?.addEventListener('click', () => setMode('kg-to-l'));
    modeLToKgBtn?.addEventListener('click', () => setMode('l-to-kg'));
    swapDirectionBtn?.addEventListener('click', () => {
      setMode(mode === 'kg-to-l' ? 'l-to-kg' : 'kg-to-l');
    });

    massInput?.addEventListener('input', calculateAndBroadcast);
    substanceSelect?.addEventListener('change', calculateAndBroadcast);

    customDensityToggle?.addEventListener('change', () => {
      const isCustom = customDensityToggle.checked;
      customDensityInput?.classList.toggle('hidden', !isCustom);
      if (substanceSelect) {
        substanceSelect.disabled = isCustom;
        substanceSelect.classList.toggle('opacity-50', isCustom);
        substanceSelect.classList.toggle('cursor-not-allowed', isCustom);
      }
      calculateAndBroadcast();
    });
    customDensityValue?.addEventListener('input', calculateAndBroadcast);
    customDensityUnit?.addEventListener('change', calculateAndBroadcast);

    // Search and filtering
    function filterOptions() {
      const query = (substanceSearchInput?.value || '').toLowerCase().trim();
      if (clearSearchBtn) {
        clearSearchBtn.classList.toggle('hidden', query.length === 0);
      }

      const filtered = fullCatalog.filter((item) => {
        const matchesCategory =
          activeCategory === 'all' || item.category.toLowerCase().includes(activeCategory);
        const matchesQuery =
          query.length === 0 ||
          item.name.toLowerCase().includes(query) ||
          item.category.toLowerCase().includes(query) ||
          item.id.toLowerCase().includes(query);
        return matchesCategory && matchesQuery;
      });

      const currentSelectedKey =
        substanceSelect.options[substanceSelect.selectedIndex]?.dataset.catalogKey;
      const frag = document.createDocumentFragment();

      filtered.forEach((item) => {
        const option = document.createElement('option');
        option.value = item.density.toString();
        option.textContent = `${item.name} (${item.density} kg/L)`;
        option.dataset.name = item.name;
        option.dataset.note = item.notes;
        option.dataset.id = item.id;
        option.dataset.catalogKey = item.catalogKey;
        option.dataset.temperature = item.temperature.toString();
        option.dataset.category = item.category;
        const minD = item.densityRange ? item.densityRange.min : item.density * 0.97;
        const maxD = item.densityRange ? item.densityRange.max : item.density * 1.03;
        option.dataset.min = minD.toString();
        option.dataset.max = maxD.toString();
        if (item.catalogKey === currentSelectedKey) {
          option.selected = true;
        }
        frag.appendChild(option);
      });

      substanceSelect.replaceChildren(frag);
      if (substanceCountChip) {
        substanceCountChip.textContent = `${filtered.length} of ${fullCatalog.length} matched`;
      }

      if (substanceSelect.options.length > 0 && !substanceSelect.value) {
        substanceSelect.selectedIndex = 0;
      }
      calculateAndBroadcast();
    }

    substanceSearchInput?.addEventListener('input', filterOptions);
    clearSearchBtn?.addEventListener('click', () => {
      if (substanceSearchInput) substanceSearchInput.value = '';
      filterOptions();
    });

    categoryFilterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        categoryFilterBtns.forEach((b) => {
          b.classList.remove('bg-brand-500/20', 'text-brand-300', 'border-brand-500/40');
          b.classList.add('bg-slate-900', 'text-slate-400', 'border-slate-800');
        });
        btn.classList.add('bg-brand-500/20', 'text-brand-300', 'border-brand-500/40');
        btn.classList.remove('bg-slate-900', 'text-slate-400', 'border-slate-800');
        activeCategory = btn.getAttribute('data-category') || 'all';
        filterOptions();
      });
    });

    let catalogLoaded = false;
    let catalogLoading = false;

    // Populate catalog
    async function loadCatalog() {
      if (catalogLoaded || catalogLoading) return;
      catalogLoading = true;
      try {
        fullCatalog = await loadSubstancesCatalog();
        catalogLoaded = true;
        filterOptions();

        const urlParams = new URLSearchParams(window.location.search);
        const paramSub = urlParams.get('substance') || urlParams.get('material');

        if (paramSub) {
          const match = fullCatalog.find(
            (c) =>
              c.id.toLowerCase() === paramSub.toLowerCase() ||
              c.catalogKey.toLowerCase() === paramSub.toLowerCase() ||
              c.name.toLowerCase().includes(paramSub.toLowerCase()),
          );
          if (match) {
            substanceSelect.value = match.density.toString();
            const opt = Array.from(substanceSelect.options).find(
              (o) => o.dataset.catalogKey === match.catalogKey,
            );
            if (opt) opt.selected = true;
            calculateAndBroadcast();
          }
        }
      } catch (error) {
        console.error('Converter catalogue could not be loaded.', error);
      } finally {
        catalogLoading = false;
      }
    }

    quickBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-val');
        if (val) {
          massInput.value = val;
          calculateAndBroadcast();
        }
      });
    });

    // Copy Result
    copyBtn?.addEventListener('click', async () => {
      const selectedOption = substanceSelect.options[substanceSelect.selectedIndex];
      const textToCopy = `${massInput.value} ${mode === 'kg-to-l' ? 'kg' : 'L'} of ${selectedOption?.dataset.name} = ${resultDisplay.textContent} ${resultUnit.textContent} (density: ${selectedOption?.value} kg/L)`;
      try {
        await navigator.clipboard.writeText(textToCopy);
        if (copyText) copyText.textContent = 'Copied!';
        setTimeout(() => {
          if (copyText) copyText.textContent = 'Copy Result';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });

    // Share Result Link
    shareBtn?.addEventListener('click', async () => {
      const selectedOption = substanceSelect.options[substanceSelect.selectedIndex];
      const subId = selectedOption?.dataset.id || 'water';
      const fromUnit = mode === 'kg-to-l' ? 'kg' : 'liter';
      const shareUrl = `${window.location.origin}${window.location.pathname}?mass=${massInput.value}&from=${fromUnit}&substance=${subId}`;

      try {
        await navigator.clipboard.writeText(shareUrl);
        if (shareText) shareText.textContent = 'Link Copied!';
        setTimeout(() => {
          if (shareText) shareText.textContent = 'Share Link';
        }, 2000);
      } catch (err) {
        console.error('Failed to share', err);
      }
    });

    // Listen for slider updates from FormulaPlayground
    window.addEventListener('fp-slider-update', (e: Event) => {
      const detail = (e as CustomEvent<{ mass: number; density: number }>).detail;
      if (massInput) massInput.value = detail.mass.toString();

      const options = Array.from(substanceSelect.options);
      if (options.length > 0 && Number.isFinite(detail.density)) {
        const nearestOption = options.reduce((nearest, option) => {
          const nearestDistance = Math.abs(parseFloat(nearest.value) - detail.density);
          const optionDistance = Math.abs(parseFloat(option.value) - detail.density);
          return optionDistance < nearestDistance ? option : nearest;
        });
        substanceSelect.value = nearestOption.value;
        nearestOption.selected = true;
      }

      calculateAndBroadcast();
    });

    // Active substance chip styling helper
    function updateActiveSubstanceChip(substanceId: string) {
      substanceChips.forEach((chip) => {
        const isMatch = (chip.getAttribute('data-id') || '').toLowerCase() === substanceId.toLowerCase();
        if (isMatch) {
          chip.classList.add('bg-brand-500/20', 'text-brand-300', 'border-brand-500/40');
          chip.classList.remove('bg-slate-800/90', 'text-slate-300', 'border-white/[0.06]');
        } else {
          chip.classList.remove('bg-brand-500/20', 'text-brand-300', 'border-brand-500/40');
          chip.classList.add('bg-slate-800/90', 'text-slate-300', 'border-white/[0.06]');
        }
      });
    }

    // Substance Preset Chips click
    substanceChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const chipId = chip.getAttribute('data-id') || '';
        const chipDensity = chip.getAttribute('data-density');
        const chipName = chip.textContent?.trim().replace(/^[^\s]+\s+/, '') || chipId;

        if (customDensityToggle && customDensityToggle.checked) {
          customDensityToggle.checked = false;
          customDensityToggle.dispatchEvent(new Event('change'));
        }
        if (substanceSearchInput && substanceSearchInput.value) {
          substanceSearchInput.value = '';
          if (catalogLoaded) filterOptions();
        }

        let matchOpt = Array.from(substanceSelect.options).find(
          (o) => (o.dataset.id || '').toLowerCase() === chipId.toLowerCase() || o.dataset.catalogKey === chipId
        );

        if (matchOpt) {
          substanceSelect.value = matchOpt.value;
          matchOpt.selected = true;
        } else if (chipDensity) {
          // Preset clicked before full catalog loaded into select
          matchOpt = document.createElement('option');
          matchOpt.value = chipDensity;
          matchOpt.textContent = `${chipName} (${chipDensity} kg/L)`;
          matchOpt.dataset.name = chipName;
          matchOpt.dataset.id = chipId;
          matchOpt.dataset.category = 'common';
          substanceSelect.appendChild(matchOpt);
          substanceSelect.value = chipDensity;
          matchOpt.selected = true;
        }

        updateActiveSubstanceChip(chipId);
        calculateAndBroadcast();
      });
    });

    // Reset Calculator Button
    resetBtn?.addEventListener('click', () => {
      if (massInput) massInput.value = '1';
      setMode('kg-to-l');
      if (customDensityToggle && customDensityToggle.checked) {
        customDensityToggle.checked = false;
        customDensityToggle.dispatchEvent(new Event('change'));
      }
      if (substanceSearchInput) substanceSearchInput.value = '';
      activeCategory = 'all';
      categoryFilterBtns.forEach((b) => {
        b.classList.remove('bg-brand-500/20', 'text-brand-300', 'border-brand-500/40');
        b.classList.add('bg-slate-900', 'text-slate-400', 'border-slate-800');
      });
      const waterOpt = Array.from(substanceSelect.options).find(
        (o) => (o.dataset.id || '').toLowerCase() === 'water'
      );
      if (waterOpt) {
        substanceSelect.value = waterOpt.value;
        waterOpt.selected = true;
      }
      updateActiveSubstanceChip('water');
      filterOptions();
      calculateAndBroadcast();
    });

    // Mobile Sticky Bar Intersection Observer
    const calcRoot = document.getElementById('calculator-root');
    if (calcRoot && mobileStickyBar && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              mobileStickyBar.classList.add('translate-y-full');
            } else {
              mobileStickyBar.classList.remove('translate-y-full');
            }
          });
        },
        { threshold: 0.1 }
      );
      observer.observe(calcRoot);
    }

    // Mobile Sticky Bar Copy Button
    stickyCopyBtn?.addEventListener('click', async () => {
      const selectedOption = substanceSelect.options[substanceSelect.selectedIndex];
      const textToCopy = `${massInput.value} ${mode === 'kg-to-l' ? 'kg' : 'L'} of ${selectedOption?.dataset.name || 'Water'} = ${resultDisplay.textContent} ${resultUnit.textContent} (density: ${selectedOption?.value} kg/L)`;
      try {
        await navigator.clipboard.writeText(textToCopy);
        stickyCopyBtn.textContent = 'Copied!';
        setTimeout(() => {
          stickyCopyBtn.textContent = 'Copy';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });

    substanceSelect?.addEventListener('change', () => {
      const selectedOpt = substanceSelect.options[substanceSelect.selectedIndex];
      updateActiveSubstanceChip(selectedOpt?.dataset.id || '');
    });

    // Check immediate URL search parameters for initial values
    const urlParams = new URLSearchParams(window.location.search);
    const paramVal = urlParams.get('mass') || urlParams.get('volume') || urlParams.get('val');
    const paramFrom = urlParams.get('from') || urlParams.get('unit');
    const paramSub = urlParams.get('substance') || urlParams.get('material');

    if (paramVal && massInput) {
      massInput.value = paramVal;
    }
    if (paramFrom === 'l' || paramFrom === 'liter' || paramFrom === 'litres') {
      setMode('l-to-kg');
    } else if (paramFrom === 'kg') {
      setMode('kg-to-l');
    }

    calculateAndBroadcast();

    // If deep-linked substance was specified in URL, load immediately
    if (paramSub) {
      void loadCatalog();
    } else {
      // Lazy-load catalog when user focuses/interacts with search or dropdown
      substanceSearchInput?.addEventListener('focus', () => void loadCatalog(), { once: true });
      substanceSearchInput?.addEventListener('input', () => void loadCatalog(), { once: true });
      substanceSelect?.addEventListener('focus', () => void loadCatalog(), { once: true });
      substanceSelect?.addEventListener('mousedown', () => void loadCatalog(), { once: true });
      categoryFilterBtns.forEach((btn) => {
        btn.addEventListener('click', () => void loadCatalog(), { once: true });
      });

      // Background prefetch during browser idle time (does not block initial render)
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(() => void loadCatalog(), { timeout: 3000 });
      } else {
        setTimeout(() => void loadCatalog(), 2500);
      }
    }
  });
</script>
