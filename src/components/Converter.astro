---
import { substances } from '../data/densities.ts';

export interface Props {
  defaultSubstanceId?: string;
}

const { defaultSubstanceId = 'water' } = Astro.props;
const defaultSubstance = substances.find((sub) => sub.id === defaultSubstanceId) ?? substances[0];
const initialVolume = 1 / defaultSubstance.density_kg_per_l;
---

<div
  class="glass-card rounded-2xl p-6 sm:p-8 border border-slate-800 shadow-xl max-w-4xl mx-auto"
  id="calculator-root"
>
  <div
    class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-800"
  >
    <div>
      <h3 class="text-xl font-bold text-white">Kg to Litre Converter</h3>
      <p class="text-xs text-slate-400 mt-1">
        Select mass and substance for instant volume calculation
      </p>
    </div>

    <!-- Mode Toggle -->
    <div class="inline-flex p-1 rounded-xl bg-slate-900 border border-slate-800">
      <button
        id="mode-kg-to-l"
        type="button"
        class="px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-brand-500 text-slate-950 shadow-md transition-all"
      >
        Kg &rarr; Litres
      </button>
      <button
        id="mode-l-to-kg"
        type="button"
        class="px-3.5 py-1.5 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition-all"
      >
        Litres &rarr; Kg
      </button>
    </div>
  </div>

  <div class="space-y-4">
    <div>
      <label
        id="input-label"
        for="mass"
        class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1"
        >Mass (kg)</label
      >
      <div class="relative">
        <input
          type="number"
          id="mass"
          name="mass"
          step="0.01"
          min="0"
          value="1"
          class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-mono text-lg focus:ring-2 focus:ring-brand-500 outline-none"
        />
        <span
          id="input-unit"
          class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400 font-mono"
        >
          kg
        </span>
      </div>

      <!-- Quick Amount Preset Buttons -->
      <div class="flex items-center gap-1.5 pt-2">
        <span class="text-[11px] text-slate-400 font-mono">Quick:</span>
        <button
          type="button"
          class="quick-amt text-xs px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors"
          data-val="1">1</button
        >
        <button
          type="button"
          class="quick-amt text-xs px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors"
          data-val="5">5</button
        >
        <button
          type="button"
          class="quick-amt text-xs px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors"
          data-val="10">10</button
        >
        <button
          type="button"
          class="quick-amt text-xs px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors"
          data-val="25">25</button
        >
        <button
          type="button"
          class="quick-amt text-xs px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors"
          data-val="100">100</button
        >
      </div>
    </div>

    <div>
      <label
        for="substance"
        class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1"
        >Substance</label
      >
      <div class="relative">
        <select
          id="substance"
          name="substance"
          class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:ring-2 focus:ring-brand-500 outline-none appearance-none cursor-pointer"
        >
          {
            substances.map((sub) => (
              <option
                value={sub.density_kg_per_l}
                data-name={sub.name}
                data-note={sub.density_note}
                data-id={sub.id}
                selected={sub.id === defaultSubstance.id}
              >
                {sub.name} ({sub.density_kg_per_l} kg/L)
              </option>
            ))
          }
        </select>
        <div class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400">
          ▼
        </div>
      </div>
    </div>

    <div
      class="mt-6 p-4 rounded-xl bg-slate-900/90 border border-brand-500/30 flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <div>
        <p
          id="result-label"
          class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1"
        >
          Resulting Volume:
        </p>
        <p class="text-3xl font-extrabold text-brand-400 font-mono">
          <span id="result">{initialVolume.toFixed(3)}</span>
          <span id="result-unit" class="text-base font-bold text-slate-300 font-mono">Litres</span>
        </p>
        <p id="density-note" class="text-xs text-slate-400 mt-1">
          Based on {defaultSubstance.name} density {defaultSubstance.density_kg_per_l} kg/L ({
            defaultSubstance.density_note
          })
        </p>
      </div>

      <button
        type="button"
        id="copy-btn"
        class="px-4 py-2.5 rounded-xl bg-brand-500 hover:bg-brand-400 text-slate-950 font-bold text-xs flex items-center gap-2 transition-all shadow-md active:scale-95"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
          ></path>
        </svg>
        <span id="copy-text">Copy Result</span>
      </button>
    </div>
  </div>
</div>

<script>
  // Liquid color map by substance ID
  const liquidColors: Record<string, string> = {
    water: '#60a5fa', // blue-400
    milk: '#f3f4f6', // gray-100
    'cooking-oil': '#facc15', // yellow-400
    diesel: '#475569', // slate-600
    flour: '#fef3c7', // amber-100
  };

  document.addEventListener('DOMContentLoaded', () => {
    let mode = 'kg-to-l';

    const massInput = document.getElementById('mass') as HTMLInputElement;
    const substanceSelect = document.getElementById('substance') as HTMLSelectElement;
    const resultDisplay = document.getElementById('result') as HTMLSpanElement;
    const resultUnit = document.getElementById('result-unit') as HTMLSpanElement;
    const resultLabel = document.getElementById('result-label') as HTMLParagraphElement;
    const noteDisplay = document.getElementById('density-note') as HTMLParagraphElement;
    const inputLabel = document.getElementById('input-label') as HTMLLabelElement;
    const inputUnit = document.getElementById('input-unit') as HTMLSpanElement;

    // Guard clause: If critical elements aren't found, stop execution safely
    if (!massInput || !substanceSelect || !resultDisplay) {
      console.warn('Converter elements not found. Skipping initialization.');
      return;
    }

    const modeKgToLBtn = document.getElementById('mode-kg-to-l');
    const modeLToKgBtn = document.getElementById('mode-l-to-kg');
    const quickBtns = document.querySelectorAll('.quick-amt');
    const copyBtn = document.getElementById('copy-btn');
    const copyText = document.getElementById('copy-text');

    function calculateAndBroadcast() {
      const mass = parseFloat(massInput?.value || '0') || 0;
      const density = parseFloat(substanceSelect?.value || '1.000') || 1.0;
      const selectedOption = substanceSelect.options[substanceSelect.selectedIndex];
      const substanceId = selectedOption?.dataset.id || 'water';
      const substanceName = selectedOption?.dataset.name || 'Water';
      const densityNote = selectedOption?.dataset.note || '';
      const liquidColor = liquidColors[substanceId] || '#60a5fa';

      if (mode === 'kg-to-l') {
        const volume = density > 0 ? mass / density : 0;
        if (resultDisplay) resultDisplay.textContent = volume.toFixed(3);
        if (resultUnit) resultUnit.textContent = 'Litres';
        if (resultLabel) resultLabel.textContent = 'Resulting Volume:';
        if (noteDisplay)
          noteDisplay.textContent = `Based on ${substanceName} density ${density} kg/L (${densityNote})`;

        // Broadcast custom event to all listening diagrams
        window.dispatchEvent(
          new CustomEvent('kg-conversion-update', {
            detail: {
              mass: mass,
              density: density,
              volume: volume,
              substanceId: substanceId,
              substanceName: substanceName,
              liquidColor: liquidColor,
            },
          }),
        );
      } else {
        const massVal = mass * density;
        const volume = mass;
        if (resultDisplay) resultDisplay.textContent = massVal.toFixed(3);
        if (resultUnit) resultUnit.textContent = 'Kilograms';
        if (resultLabel) resultLabel.textContent = 'Resulting Mass:';
        if (noteDisplay)
          noteDisplay.textContent = `Based on ${substanceName} density ${density} kg/L (${densityNote})`;

        window.dispatchEvent(
          new CustomEvent('kg-conversion-update', {
            detail: {
              mass: massVal,
              density: density,
              volume: volume,
              substanceId: substanceId,
              substanceName: substanceName,
              liquidColor: liquidColor,
            },
          }),
        );
      }
    }

    modeKgToLBtn?.addEventListener('click', () => {
      mode = 'kg-to-l';
      modeKgToLBtn.className =
        'px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-brand-500 text-slate-950 shadow-md transition-all';
      if (modeLToKgBtn)
        modeLToKgBtn.className =
          'px-3.5 py-1.5 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition-all';
      if (inputLabel) inputLabel.textContent = 'Mass (kg)';
      if (inputUnit) inputUnit.textContent = 'kg';
      calculateAndBroadcast();
    });

    modeLToKgBtn?.addEventListener('click', () => {
      mode = 'l-to-kg';
      modeLToKgBtn.className =
        'px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-brand-500 text-slate-950 shadow-md transition-all';
      if (modeKgToLBtn)
        modeKgToLBtn.className =
          'px-3.5 py-1.5 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition-all';
      if (inputLabel) inputLabel.textContent = 'Volume (L)';
      if (inputUnit) inputUnit.textContent = 'L';
      calculateAndBroadcast();
    });

    massInput?.addEventListener('input', calculateAndBroadcast);
    substanceSelect?.addEventListener('change', calculateAndBroadcast);

    quickBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-val');
        if (val) {
          massInput.value = val;
          calculateAndBroadcast();
        }
      });
    });

    copyBtn?.addEventListener('click', async () => {
      const selectedOption = substanceSelect.options[substanceSelect.selectedIndex];
      const textToCopy = `${massInput.value} ${mode === 'kg-to-l' ? 'kg' : 'L'} of ${selectedOption?.dataset.name} = ${resultDisplay.textContent} ${resultUnit.textContent}`;
      try {
        await navigator.clipboard.writeText(textToCopy);
        if (copyText) copyText.textContent = 'Copied!';
        setTimeout(() => {
          if (copyText) copyText.textContent = 'Copy Result';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });

    // Listen for slider updates from FormulaPlayground (bidirectional sync)
    window.addEventListener('fp-slider-update', (e: Event) => {
      const detail = (e as CustomEvent).detail;
      if (massInput) massInput.value = detail.mass.toString();
      // Match nearest option or custom density
      calculateAndBroadcast();
    });

    calculateAndBroadcast();
  });
</script>
