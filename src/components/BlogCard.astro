---
// src/components/BlogCard.astro
import type { CollectionEntry } from 'astro:content';
import { useI18n } from '@utils/i18n';

export interface Props {
  post: CollectionEntry<'blog'>;
  locale?: string;
}

const { post, locale = 'en' } = Astro.props;

const formattedDate = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(post.data.date);

const postUrl = useI18n(locale).getLocalizedPath(`blog/${post.id}`);
---

<article class="flex flex-col bg-surface-900/60 border border-white/[0.08] hover:border-brand-500/40 rounded-xl overflow-hidden shadow-lg transition-all duration-300 hover:-translate-y-1 group">
  {post.data.image && (
    <div class="aspect-video w-full overflow-hidden bg-surface-950">
      <img
        src={post.data.image}
        alt={post.data.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    </div>
  )}

  <div class="flex flex-col flex-1 p-5">
    <div class="flex items-center gap-2 mb-3">
      <span class="px-2.5 py-0.5 text-xs font-medium rounded-full bg-brand-500/10 text-brand-400 border border-brand-500/20">
        {post.data.category}
      </span>
      {post.data.readingTime && (
        <span class="text-xs text-slate-400">
          • {post.data.readingTime} min read
        </span>
      )}
    </div>

    <h2 class="text-lg font-bold text-slate-100 group-hover:text-brand-400 transition-colors line-clamp-2 mb-2">
      <a href={postUrl} class="focus:outline-none">
        {post.data.title}
      </a>
    </h2>

    <p class="text-sm text-slate-400 line-clamp-3 mb-4 flex-1">
      {post.data.description}
    </p>

    <div class="flex items-center justify-between text-xs text-slate-400 pt-3 border-t border-white/[0.06]">
      <span>{post.data.author}</span>
      <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
    </div>
  </div>
</article>
