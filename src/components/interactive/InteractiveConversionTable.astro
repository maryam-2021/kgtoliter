---
import { catalogItems, type CatalogItem } from '../../data/catalog';
import { categories } from '../../data/substances';

const PAGE_SIZE = 50;
const initialItems = catalogItems.slice(0, PAGE_SIZE);

function densityDisplay(item: CatalogItem): string {
  return item.densityRange
    ? `${item.densityRange.min} - ${item.densityRange.max} kg/L`
    : `${item.density} kg/L`;
}
---

<div
  class="glass-card rounded-2xl p-6 sm:p-8 border border-slate-800 shadow-xl max-w-5xl mx-auto"
  role="region"
  aria-label="Interactive Density Directory"
>
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
    <div>
      <h2 class="text-2xl font-extrabold text-white">Interactive Density Directory</h2>
      <p class="text-xs text-slate-400 mt-1">
        Search, sort, or filter {catalogItems.length} substances by density, category, or notes
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
      <div class="w-full sm:w-56">
        <select
          id="table-filter-select"
          aria-label="Filter by category"
          class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white text-xs font-mono outline-none cursor-pointer"
        >
          <option value="all">Show: All Categories ({catalogItems.length})</option>
          {categories.map((category) => <option value={category.id}>Show: {category.name}</option>)}
        </select>
      </div>

      <div class="w-full sm:w-48">
        <input
          id="table-search"
          type="search"
          placeholder="Search substances..."
          aria-label="Search substance by name, category, source, or notes"
          class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white text-xs font-mono focus:ring-2 focus:ring-brand-500 outline-none"
        />
      </div>
    </div>
  </div>

  <figure class="w-full">
    <figcaption class="sr-only">
      Standard density values in kg/L for liquids, powders, industrial chemicals, and fuels
    </figcaption>
    <div
      class="overflow-auto -mx-4 px-4 md:mx-0 md:px-0 border border-gray-700 rounded-xl max-h-[600px]"
    >
      <table class="w-full text-left border-collapse min-w-[620px]" id="density-table">
        <thead class="sticky top-0 bg-slate-900 z-10 shadow-md">
          <tr
            class="border-b border-gray-700 text-gray-400 text-sm uppercase tracking-wider font-mono select-none"
          >
            <th
              scope="col"
              class="p-4 cursor-pointer hover:text-brand-400 transition-colors"
              data-sort="name">Substance <span class="text-[10px] text-slate-500">↕</span></th
            >
            <th
              scope="col"
              class="p-4 cursor-pointer hover:text-brand-400 transition-colors"
              data-sort="category">Category <span class="text-[10px] text-slate-500">↕</span></th
            >
            <th
              scope="col"
              class="p-4 cursor-pointer text-brand-400 hover:text-brand-300 transition-colors"
              data-sort="density">Density <span class="text-[10px] text-slate-500">↕</span></th
            >
            <th scope="col" class="p-4">1 kg Volume</th>
            <th scope="col" class="p-4 hidden lg:table-cell">Common Use / Notes</th>
            <th scope="col" class="p-4 text-right">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800 font-mono text-sm" id="table-body">
          {
            initialItems.map((item) => (
              <tr class="hover:bg-gray-800/50 transition-colors">
                <td class="p-4 font-medium text-white font-sans">{item.name}</td>
                <td class="p-4">
                  <span class="text-xs text-brand-400 font-sans whitespace-nowrap">
                    {item.categoryLabel}
                  </span>
                </td>
                <td class="p-4 tabular-nums font-bold text-brand-400 whitespace-nowrap">
                  {densityDisplay(item)}
                </td>
                <td class="p-4 text-gray-300 tabular-nums whitespace-nowrap">
                  {(1 / item.density).toFixed(3)} L
                </td>
                <td
                  class="p-4 text-slate-400 font-sans text-xs max-w-xs truncate hidden lg:table-cell"
                  title={item.notes}
                >
                  {item.notes}
                </td>
                <td class="p-4 text-right">
                  <a
                    href={`/${item.categorySlug}/`}
                    class="inline-block px-3 py-1.5 text-xs font-semibold text-white bg-brand-600 rounded-lg hover:bg-brand-500 transition-colors font-sans whitespace-nowrap"
                  >
                    View Category &rarr;
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 mt-4 text-xs">
      <p id="table-status" class="text-slate-400" aria-live="polite">
        Showing {initialItems.length} of {catalogItems.length} substances
      </p>
      <button
        id="table-load-more"
        type="button"
        class="px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-white font-semibold transition-colors"
        >Load 50 more</button
      >
    </div>
  </figure>
</div>

<script>
  import type { CatalogItem } from '../../data/catalog';

  const PAGE_SIZE = 50;

  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('table-search') as HTMLInputElement;
    const filterSelect = document.getElementById('table-filter-select') as HTMLSelectElement;
    const tableBody = document.getElementById('table-body') as HTMLTableSectionElement;
    const status = document.getElementById('table-status') as HTMLParagraphElement;
    const loadMore = document.getElementById('table-load-more') as HTMLButtonElement;
    const sortButtons = document.querySelectorAll<HTMLTableCellElement>('[data-sort]');

    if (!searchInput || !filterSelect || !tableBody || !status || !loadMore) return;

    let items: CatalogItem[] = [];
    let visibleCount = PAGE_SIZE;
    let sortKey: 'name' | 'category' | 'density' = 'name';
    let sortAscending = true;

    function appendCell(row: HTMLTableRowElement, text: string, className: string, title?: string) {
      const cell = document.createElement('td');
      cell.className = className;
      cell.textContent = text;
      if (title) cell.title = title;
      row.appendChild(cell);
    }

    function render() {
      const query = searchInput.value.toLowerCase().trim();
      const category = filterSelect.value;
      const filtered = items
        .filter((item) => category === 'all' || item.category === category)
        .filter(
          (item) =>
            !query ||
            [item.name, item.categoryLabel, item.notes, item.source].some((value) =>
              value.toLowerCase().includes(query),
            ),
        )
        .sort((a, b) => {
          const first = sortKey === 'category' ? a.categoryLabel : a[sortKey];
          const second = sortKey === 'category' ? b.categoryLabel : b[sortKey];
          const comparison =
            typeof first === 'number'
              ? first - (second as number)
              : first.localeCompare(second as string);
          return sortAscending ? comparison : -comparison;
        });

      const visible = filtered.slice(0, visibleCount);
      const fragment = document.createDocumentFragment();

      for (const item of visible) {
        const row = document.createElement('tr');
        row.className = 'hover:bg-gray-800/50 transition-colors';
        appendCell(row, item.name, 'p-4 font-medium text-white font-sans');
        appendCell(row, item.categoryLabel, 'p-4 text-brand-400 font-sans text-xs');
        const density = item.densityRange
          ? `${item.densityRange.min} - ${item.densityRange.max} kg/L`
          : `${item.density} kg/L`;
        appendCell(row, density, 'p-4 tabular-nums font-bold text-brand-400 whitespace-nowrap');
        appendCell(
          row,
          `${(1 / item.density).toFixed(3)} L`,
          'p-4 text-gray-300 tabular-nums whitespace-nowrap',
        );
        appendCell(
          row,
          item.notes,
          'p-4 text-slate-400 font-sans text-xs max-w-xs truncate hidden lg:table-cell',
          item.notes,
        );

        const actionCell = document.createElement('td');
        actionCell.className = 'p-4 text-right';
        const link = document.createElement('a');
        link.href = `/${item.categorySlug}/`;
        link.className =
          'inline-block px-3 py-1.5 text-xs font-semibold text-white bg-brand-600 rounded-lg hover:bg-brand-500 transition-colors font-sans whitespace-nowrap';
        link.textContent = 'View Category →';
        actionCell.appendChild(link);
        row.appendChild(actionCell);
        fragment.appendChild(row);
      }

      tableBody.replaceChildren(fragment);
      status.textContent = `Showing ${visible.length} of ${filtered.length} matching substances (${items.length} total)`;
      loadMore.hidden = visible.length >= filtered.length;
    }

    async function loadCatalog() {
      loadMore.disabled = true;
      try {
        const response = await fetch('/data/substances.json');
        if (!response.ok) throw new Error(`Catalog request failed: ${response.status}`);
        items = (await response.json()) as CatalogItem[];
        render();
      } catch (error) {
        console.error(error);
        status.textContent = 'The full directory could not be loaded. Showing the initial entries.';
        loadMore.hidden = true;
      } finally {
        loadMore.disabled = false;
      }
    }

    searchInput.addEventListener('input', () => {
      visibleCount = PAGE_SIZE;
      render();
    });
    filterSelect.addEventListener('change', () => {
      visibleCount = PAGE_SIZE;
      render();
    });
    loadMore.addEventListener('click', () => {
      visibleCount += PAGE_SIZE;
      render();
    });
    sortButtons.forEach((button) =>
      button.addEventListener('click', () => {
        const nextKey = button.dataset.sort as typeof sortKey;
        if (sortKey === nextKey) sortAscending = !sortAscending;
        else {
          sortKey = nextKey;
          sortAscending = true;
        }
        render();
      }),
    );

    void loadCatalog();
  });
</script>
