---
import { SUBSTANCE_DATABASE, categories, getDensityDisplay } from '../../data/densities.ts';
import TemperatureDisclaimer from '../TemperatureDisclaimer.astro';

export interface Props {
  categorySlug: string;
}

const { categorySlug } = Astro.props;
const categoryObj = categories.find((c) => c.slug === categorySlug || c.id === categorySlug);
const categoryId = categoryObj?.id || categorySlug;
const categoryName = categoryObj?.name || 'Substances';

const categorySubstances = SUBSTANCE_DATABASE.filter((s) => s.category === categoryId);

// Calculate Stats
const totalCount = categorySubstances.length;
const densities = categorySubstances.map((s) => s.density);
const minDensity = densities.length > 0 ? Math.min(...densities) : 0;
const maxDensity = densities.length > 0 ? Math.max(...densities) : 0;
const maxDenseSubstance = categorySubstances.find((s) => s.density === maxDensity)?.name || '';

// Max volume for comparison chart
const volumes = categorySubstances.map((s) => 1 / s.density);
const maxCategoryVolume = volumes.length > 0 ? Math.max(...volumes) : 1;
---

<div class="space-y-12">
  <!-- Hero Section -->
  <section class="max-w-5xl mx-auto text-center space-y-6">
    <div
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-900/30 border border-brand-500/30 text-brand-400 text-xs font-semibold"
    >
      <span class="w-2 h-2 rounded-full bg-brand-400 animate-pulse"></span>
      Category Reference Hub
    </div>
    <h1 class="text-4xl md:text-5xl font-extrabold text-white leading-tight">
      {categoryName}
      <br />
      <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 via-sky-300 to-emerald-400"
      >
        Density & Volume Reference
      </span>
    </h1>
    <p class="text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
      Precise density reference data for {totalCount > 0 ? totalCount : 'all'} common substances. Convert
      mass to volume instantly with exact temperature-calibrated specific gravity values.
    </p>

    <div class="grid grid-cols-3 gap-4 max-w-lg mx-auto pt-4">
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-center">
        <span class="text-2xl font-extrabold text-brand-400 font-mono block">{totalCount}</span>
        <span class="text-xs text-slate-400 font-mono">Substances</span>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-center">
        <span class="text-2xl font-extrabold text-amber-400 font-mono block">20°C</span>
        <span class="text-xs text-slate-400 font-mono">Reference Temp</span>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-center">
        <span class="text-2xl font-extrabold text-emerald-400 font-mono block">&plusmn;0.001</span>
        <span class="text-xs text-slate-400 font-mono">Precision (kg/L)</span>
      </div>
    </div>
  </section>

  <!-- Main Converter Tool -->
  <section class="max-w-4xl mx-auto">
    <div class="glass-card p-6 sm:p-8 rounded-2xl border border-slate-800 shadow-xl space-y-6">
      <div
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4"
      >
        <div>
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span class="text-brand-400">⚖️</span> Kg ↔ Litre Converter ({categoryName})
          </h2>
          <p class="text-xs text-slate-400 mt-1">
            Select substance and input mass for instant conversion
          </p>
        </div>
        <div
          class="inline-flex self-start p-1 rounded-xl bg-slate-900 border border-slate-800"
          role="group"
          aria-label="Conversion direction"
        >
          <button
            id="cat-mode-kg-to-l"
            type="button"
            aria-pressed="true"
            class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-brand-500 text-slate-950 shadow-md transition-all"
            >kg &rarr; litre</button
          >
          <button
            id="cat-mode-l-to-kg"
            type="button"
            aria-pressed="false"
            class="px-3 py-1.5 text-xs font-semibold rounded-lg text-slate-400 hover:text-white transition-all"
            >litre &rarr; kg</button
          >
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-4 items-end">
        <div>
          <label
            for="cat-mass-input"
            id="cat-input-label"
            class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1"
            >Mass (kg)</label
          >
          <div class="relative">
            <input
              type="number"
              id="cat-mass-input"
              value="1.0"
              step="0.1"
              min="0.01"
              class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white font-mono text-lg focus:ring-2 focus:ring-brand-500 outline-none"
            />
            <span
              id="cat-input-unit"
              class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400 font-mono"
              >kg</span
            >
          </div>
        </div>

        <div>
          <label
            for="cat-substance-select"
            class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1"
            >Substance</label
          >
          <div class="relative">
            <select
              id="cat-substance-select"
              class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-700 text-white text-sm focus:ring-2 focus:ring-brand-500 outline-none appearance-none cursor-pointer"
            >
              {
                categorySubstances.map((sub, idx) => (
                  <option
                    value={sub.density}
                    data-name={sub.name}
                    data-temp={sub.temperature}
                    data-notes={sub.notes}
                    selected={idx === 0}
                  >
                    {sub.name} ({getDensityDisplay(sub)})
                  </option>
                ))
              }
            </select>
            <div
              class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-slate-400"
            >
              ▼
            </div>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-slate-900 border border-brand-500/30">
          <span
            id="cat-result-label"
            class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1"
            >Resulting Volume</span
          >
          <p class="text-2xl font-extrabold text-brand-400 font-mono">
            <span id="cat-result-val">1.000</span>
            <span id="cat-result-unit" class="text-sm text-slate-300 font-mono">Litres</span>
          </p>
        </div>
      </div>

      <!-- HTML5 Volume Canvas Explorer -->
      <div class="p-4 bg-slate-950 rounded-xl border border-slate-800 space-y-2">
        <div class="flex justify-between items-center text-xs font-mono text-slate-400">
          <span>HTML5 Canvas Volume Visualization</span>
          <span id="cat-canvas-label" class="text-brand-400 font-bold">1.000 L</span>
        </div>
        <canvas id="volumeCanvas" height="80" class="w-full h-20 rounded-lg bg-slate-900"></canvas>
      </div>

      <div class="grid grid-cols-3 gap-4 pt-4 border-t border-slate-800 text-xs font-mono">
        <div>
          <span class="text-slate-500 block">Density:</span>
          <span id="cat-density-disp" class="text-brand-300 font-bold">1.000 kg/L</span>
        </div>
        <div>
          <span class="text-slate-500 block">Temperature:</span>
          <span id="cat-temp-disp" class="text-amber-400 font-bold">20°C</span>
        </div>
        <div>
          <span class="text-slate-500 block">Formula:</span>
          <span id="cat-formula" class="text-emerald-400 font-bold">V = m &divide; &rho;</span>
        </div>
      </div>
      <TemperatureDisclaimer />
    </div>
  </section>

  <!-- 1 kg Volume Comparison Section -->
  <section class="max-w-5xl mx-auto space-y-6">
    <div>
      <h2 class="text-2xl font-bold text-white flex items-center gap-2">
        <span>📊</span> 1 kg Volume Comparison ({categoryName})
      </h2>
      <p class="text-xs text-slate-400 mt-1">
        See how 1 kg of each substance in this category occupies different volumes
      </p>
    </div>

    <div class="glass-card p-6 rounded-2xl border border-slate-800 space-y-3">
      {
        categorySubstances.map((sub) => {
          const volume = 1 / sub.density;
          const pct = Math.max((volume / maxCategoryVolume) * 100, 6);

          return (
            <div class="chart-bar-container">
              <span class="chart-bar-label">{sub.name}</span>
              <div class="chart-bar-track">
                <div
                  class="chart-bar-fill"
                  style={`width: ${pct}%; background: ${sub.density > 1.2 ? '#ef4444' : sub.density > 0.9 ? '#f59e0b' : '#3b82f6'};`}
                >
                  {volume.toFixed(3)} L
                </div>
              </div>
              <span class="chart-bar-value">{sub.density.toFixed(3)} kg/L</span>
            </div>
          );
        })
      }
    </div>
  </section>

  <!-- Chemical Density Directory -->
  <section class="max-w-5xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-white flex items-center gap-2">
          <span>📋</span>
          {categoryName} Density Directory
        </h2>
        <p class="text-xs text-slate-400 mt-1">Full reference density table for {categoryName}</p>
      </div>

      <div class="flex items-center gap-3 w-full sm:w-auto">
        <input
          type="text"
          id="cat-search-input"
          placeholder="Search in category..."
          aria-label="Search substances in category"
          class="px-3 py-2 rounded-xl bg-slate-900 border border-slate-700 text-white text-xs font-mono focus:ring-2 focus:ring-brand-500 outline-none w-full sm:w-64"
        />
      </div>
    </div>

    <!-- Table -->
    <div
      class="overflow-x-auto border border-gray-700 rounded-xl bg-slate-900/60 max-h-[500px] overflow-y-auto"
    >
      <table class="w-full text-left border-collapse min-w-[650px]">
        <thead class="sticky top-0 bg-slate-900 z-10 shadow-md">
          <tr
            class="border-b border-gray-700 text-gray-400 text-xs uppercase tracking-wider font-mono select-none"
          >
            <th scope="col" class="p-4">Substance</th>
            <th scope="col" class="p-4">Density (kg/L)</th>
            <th scope="col" class="p-4">1 kg Volume</th>
            <th scope="col" class="p-4">Ref Temp</th>
            <th scope="col" class="p-4">Notes / Specification</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800 font-mono text-sm" id="cat-table-body">
          {
            categorySubstances.map((sub) => {
              const vol = (1 / sub.density).toFixed(3);
              const dispDensity = getDensityDisplay(sub);

              return (
                <tr
                  class="cat-table-row hover:bg-gray-800/50 transition-colors"
                  data-name={sub.name.toLowerCase()}
                  data-notes={(sub.notes || '').toLowerCase()}
                >
                  <td class="p-4 font-medium text-white font-sans">{sub.name}</td>
                  <td class="p-4 text-brand-400 font-bold tabular-nums">{dispDensity}</td>
                  <td class="p-4 text-emerald-400 tabular-nums">{vol} L</td>
                  <td class="p-4 text-amber-400 tabular-nums">{sub.temperature}°C</td>
                  <td class="p-4 text-slate-400 font-sans text-xs">{sub.notes}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <!-- Quick Stats Bar -->
    <div
      class="p-4 rounded-xl bg-slate-900/90 border border-slate-800 text-xs font-mono text-slate-400 flex flex-wrap items-center justify-between gap-4"
    >
      <span>Showing {totalCount} substances in {categoryName}</span>
      <span>|</span>
      <span>Density range: {minDensity.toFixed(3)} - {maxDensity.toFixed(3)} kg/L</span>
      <span>|</span>
      <span>Most dense: <strong class="text-white">{maxDenseSubstance}</strong></span>
    </div>
  </section>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const massInput = document.getElementById('cat-mass-input') as HTMLInputElement;
    const subSelect = document.getElementById('cat-substance-select') as HTMLSelectElement;
    const resultVal = document.getElementById('cat-result-val') as HTMLSpanElement;
    const densityDisp = document.getElementById('cat-density-disp') as HTMLSpanElement;
    const tempDisp = document.getElementById('cat-temp-disp') as HTMLSpanElement;
    const canvasLabel = document.getElementById('cat-canvas-label') as HTMLSpanElement;
    const searchInput = document.getElementById('cat-search-input') as HTMLInputElement;
    const volumeCanvas = document.getElementById('volumeCanvas') as HTMLCanvasElement;
    const inputLabel = document.getElementById('cat-input-label');
    const inputUnit = document.getElementById('cat-input-unit');
    const resultLabel = document.getElementById('cat-result-label');
    const resultUnit = document.getElementById('cat-result-unit');
    const formula = document.getElementById('cat-formula');
    const kgToLButton = document.getElementById('cat-mode-kg-to-l');
    const lToKgButton = document.getElementById('cat-mode-l-to-kg');

    if (!massInput || !subSelect || !resultVal) return;

    let mode: 'kg-to-l' | 'l-to-kg' = 'kg-to-l';

    function drawVolumeVisualization(volume: number, density: number) {
      if (!volumeCanvas) return;
      const ctx = volumeCanvas.getContext('2d');
      if (!ctx) return;

      const w = volumeCanvas.offsetWidth || 600;
      const h = 80;
      volumeCanvas.width = w;
      volumeCanvas.height = h;

      ctx.clearRect(0, 0, w, h);

      // Background
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, w, h);

      // Liquid Fill Bar (max 50L scale)
      const maxVolume = 50;
      const fillWidth = Math.min((volume / maxVolume) * (w - 40), w - 40);

      const gradient = ctx.createLinearGradient(0, 0, w, 0);
      gradient.addColorStop(0, '#2563eb');
      gradient.addColorStop(0.5, '#38bdf8');
      gradient.addColorStop(1, '#34d399');

      ctx.fillStyle = gradient;
      ctx.shadowColor = 'rgba(37, 99, 235, 0.4)';
      ctx.shadowBlur = 10;
      ctx.fillRect(20, 15, Math.max(fillWidth, 4), h - 30);
      ctx.shadowBlur = 0;

      // Outer Border
      ctx.strokeStyle = '#38bdf8';
      ctx.lineWidth = 1.5;
      ctx.strokeRect(20, 15, Math.max(fillWidth, 4), h - 30);

      // Text label
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold 12px monospace';
      ctx.textAlign = 'left';
      ctx.fillText(`${volume.toFixed(3)} L`, Math.max(30, fillWidth - 40), h / 2 + 4);

      // Density readout on canvas
      ctx.fillStyle = '#94a3b8';
      ctx.font = '11px monospace';
      ctx.fillText(`ρ = ${density.toFixed(3)} kg/L`, 20, h - 3);
    }

    function calculate() {
      const amount = parseFloat(massInput?.value || '1.0') || 0;
      const density = parseFloat(subSelect?.value || '1.000') || 1.0;
      const volume = mode === 'kg-to-l' ? (density > 0 ? amount / density : 0) : amount;
      const mass = mode === 'kg-to-l' ? amount : amount * density;

      const selectedOpt = subSelect.options[subSelect.selectedIndex];
      const temp = selectedOpt?.dataset.temp || '20';

      if (resultVal) resultVal.textContent = (mode === 'kg-to-l' ? volume : mass).toFixed(3);
      if (resultUnit) resultUnit.textContent = mode === 'kg-to-l' ? 'Litres' : 'Kilograms';
      if (resultLabel)
        resultLabel.textContent = mode === 'kg-to-l' ? 'Resulting Volume' : 'Resulting Mass';
      if (formula) formula.textContent = mode === 'kg-to-l' ? 'V = m ÷ ρ' : 'm = V × ρ';
      if (densityDisp) densityDisp.textContent = `${density.toFixed(3)} kg/L`;
      if (tempDisp) tempDisp.textContent = `${temp}°C`;
      if (canvasLabel) canvasLabel.textContent = `${volume.toFixed(3)} L`;

      drawVolumeVisualization(volume, density);
    }

    function setMode(nextMode: 'kg-to-l' | 'l-to-kg') {
      mode = nextMode;
      const reverse = mode === 'l-to-kg';
      if (inputLabel) inputLabel.textContent = reverse ? 'Volume (L)' : 'Mass (kg)';
      if (inputUnit) inputUnit.textContent = reverse ? 'L' : 'kg';
      kgToLButton?.setAttribute('aria-pressed', String(!reverse));
      lToKgButton?.setAttribute('aria-pressed', String(reverse));
      kgToLButton?.classList.toggle('bg-brand-500', !reverse);
      kgToLButton?.classList.toggle('text-slate-950', !reverse);
      kgToLButton?.classList.toggle('text-slate-400', reverse);
      lToKgButton?.classList.toggle('bg-brand-500', reverse);
      lToKgButton?.classList.toggle('text-slate-950', reverse);
      lToKgButton?.classList.toggle('text-slate-400', !reverse);
      calculate();
    }

    function filterTable() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      const rows = document.querySelectorAll('.cat-table-row');

      rows.forEach((r) => {
        const name = r.getAttribute('data-name') || '';
        const notes = r.getAttribute('data-notes') || '';
        if (!query || name.includes(query) || notes.includes(query)) {
          (r as HTMLElement).style.display = '';
        } else {
          (r as HTMLElement).style.display = 'none';
        }
      });
    }

    massInput.addEventListener('input', calculate);
    subSelect.addEventListener('change', calculate);
    kgToLButton?.addEventListener('click', () => setMode('kg-to-l'));
    lToKgButton?.addEventListener('click', () => setMode('l-to-kg'));
    if (searchInput) searchInput.addEventListener('input', filterTable);

    calculate();
  });
</script>
