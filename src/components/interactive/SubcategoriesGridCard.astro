---
import { catalogItems, getCatalogStats } from '../../data/catalog';
import { categories } from '../../data/substances';

const stats = getCatalogStats();
const icons: Record<string, string> = {
  industrial: '🏭',
  automotive: '🛢️',
  food: '🛒',
  beverages: '🥤',
  cleaning: '🧼',
  'personal-care': '🧴',
  construction: '🏗️',
  'metals-molten': '⚙️',
  agriculture: '🌱',
  viscous: '💧',
  petroleum: '⛽',
  solvents: '🧪',
  acids: '⚗️',
  bases: '🧼',
  specialty: '⭐',
  'transmission-oils': '⚙️',
  'brake-fluids': '🚗',
  coolants: '❄️',
  'auto-additives': '🔧',
  dairy: '🥛',
  'cooking-oils': '🫒',
  sweeteners: '🍯',
  condiments: '🌶️',
  'baking-ingredients': '🍞',
  'beverages-full': '🧃',
  'produce-processing': '🥕',
  'concrete-cement': '🏗️',
  'aggregates-fill': '🪨',
  'wood-lumber': '🪵',
  'insulation-materials': '🛡️',
  'masonry-block': '🧱',
  'roofing-materials': '🏠',
  'paints-coatings': '🎨',
  'adhesives-mortars': '🔩',
};
const borderColors = [
  'border-l-blue-500',
  'border-l-amber-500',
  'border-l-purple-500',
  'border-l-red-500',
  'border-l-emerald-500',
  'border-l-cyan-500',
];

const subcategories = categories.flatMap((category, index) => {
  const categoryStats = stats[category.id];
  if (!categoryStats?.count) return [];

  return [
    {
      ...category,
      count: categoryStats.count,
      density: `${categoryStats.minDensity.toFixed(3)} - ${categoryStats.maxDensity.toFixed(3)} kg/L`,
      colorBorder: borderColors[index % borderColors.length],
      icon: icons[category.id] ?? '◆',
    },
  ];
});

const totalChemicalsCount = catalogItems.length;
---

<div class="space-y-8">
  <!-- Horizontal Subcategory Filter Pills -->
  <div
    class="flex flex-wrap gap-2 justify-center max-w-6xl mx-auto p-4 bg-slate-950/60 border border-slate-800 rounded-2xl"
  >
    <button
      class="subcat-pill active px-3.5 py-1.5 rounded-full text-xs font-semibold bg-blue-600 text-white shadow-md transition-all cursor-pointer flex items-center gap-1.5"
      data-filter="all"
      aria-pressed="true"
      aria-controls="subcategoriesGrid"
    >
      <span>All</span>
      <span class="bg-blue-800 text-white text-[10px] px-1.5 py-0.5 rounded-full font-mono"
        >{totalChemicalsCount}</span
      >
    </button>

    {
      subcategories.map((cat) => (
        <button
          class="subcat-pill px-3 py-1.5 rounded-full text-xs font-semibold bg-slate-900 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-800 transition-all cursor-pointer flex items-center gap-1.5"
          data-filter={cat.id}
          aria-pressed="false"
          aria-controls="subcategoriesGrid"
        >
          <span class="text-xs">{cat.icon}</span>
          <span>{cat.name}</span>
          <span class="bg-slate-800 text-slate-400 text-[10px] px-1.5 py-0.5 rounded-full font-mono">
            {cat.count}
          </span>
        </button>
      ))
    }
  </div>

  <!-- Category Cards Grid (6 Columns on Desktop) -->
  <div
    id="subcategoriesGrid"
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3.5"
  >
    {
      subcategories.map((cat) => (
        <a
          href={`/${cat.slug}/`}
          class={`subcat-card block bg-slate-900/80 hover:bg-slate-900 border border-slate-800/80 ${cat.colorBorder} border-l-4 rounded-xl p-3.5 transition-all duration-300 transform hover:-translate-y-1 shadow-md group`}
          data-category={cat.id}
        >
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-xl group-hover:scale-110 transition-transform">{cat.icon}</span>
            <span class="text-[10px] font-mono font-medium text-slate-400 bg-slate-800 px-2 py-0.5 rounded-md">
              {cat.count} chemicals
            </span>
          </div>
          <h4 class="text-xs sm:text-sm font-bold text-white group-hover:text-brand-300 transition-colors truncate mb-1">
            {cat.name}
          </h4>
          <p class="text-[10px] font-mono text-slate-400 truncate">{cat.density}</p>
        </a>
      ))
    }
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pills = document.querySelectorAll('.subcat-pill');
    const cards = document.querySelectorAll('.subcat-card');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const filter = pill.getAttribute('data-filter');

        pills.forEach((p) => {
          p.classList.remove('active', 'bg-blue-600', 'text-white');
          p.classList.add('bg-slate-900', 'text-slate-300');
          p.setAttribute('aria-pressed', 'false');
        });

        pill.classList.remove('bg-slate-900', 'text-slate-300');
        pill.classList.add('active', 'bg-blue-600', 'text-white');
        pill.setAttribute('aria-pressed', 'true');

        cards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            (card as HTMLElement).style.display = 'block';
            card.classList.add('animate-fade-in');
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>
