---
import { getCatalogItem } from '../../data/catalog';

const comparisonKeys = [
  'acetone',
  'ethanol',
  'isopropyl-alcohol',
  'methanol',
  'glycerin',
  'ethylene-glycol',
  'propylene-glycol',
  'toluene',
  'xylene',
  'mineral-spirits',
  'turpentine',
  'ammonia-28',
  'hydrogen-peroxide-30',
  'sulfuric-acid-98',
  'hydrochloric-acid-37',
  'nitric-acid-68',
  'sodium-hydroxide-50',
];

const items = comparisonKeys.flatMap((key) => {
  const item = getCatalogItem(key);
  if (!item) return [];
  const color = item.density < 1 ? 'blue' : item.density < 1.3 ? 'orange' : 'red';
  return [{ name: item.name, volume: 1 / item.density, density: item.density, color }];
});

const maxVolume = Math.max(...items.map((item) => item.volume));

const colorClasses: Record<string, string> = {
  blue: 'bg-blue-600 shadow-blue-500/20',
  orange: 'bg-amber-500 shadow-amber-500/20',
  red: 'bg-red-500 shadow-red-500/20',
};
---

<div
  class="glass-card bg-slate-950/90 border border-slate-800 rounded-2xl p-5 sm:p-8 shadow-2xl overflow-hidden"
>
  <!-- Card Header -->
  <div class="flex items-start gap-3 mb-6">
    <span class="text-2xl sm:text-3xl leading-none">📊</span>
    <div>
      <h3 class="text-lg sm:text-2xl font-bold text-white tracking-tight">
        1 kg Volume Comparison <span class="text-slate-400 font-normal text-sm sm:text-base"
          >(Industrial Chemicals & Solvents)</span
        >
      </h3>
      <p class="text-slate-400 text-xs sm:text-sm mt-1">
        See how 1 kg of each substance in this category occupies different volumes
      </p>
    </div>
  </div>

  <!-- Comparison Rows -->
  <div class="space-y-2.5 sm:space-y-3">
    {
      items.map((item) => {
        const pct = (item.volume / maxVolume) * 100;
        const barColor = colorClasses[item.color] || colorClasses.blue;
        return (
          <div class="grid grid-cols-[130px_1fr_80px] sm:grid-cols-[200px_1fr_95px] items-center gap-2 sm:gap-4 text-xs sm:text-sm">
            {/* Substance Name */}
            <span class="text-slate-200 font-medium truncate" title={item.name}>
              {item.name}
            </span>

            {/* Bar Track */}
            <div class="w-full bg-slate-900/80 rounded-full h-7 sm:h-8 p-0.5 overflow-hidden flex items-center border border-slate-800/60">
              <div
                class={`h-full rounded-full flex items-center px-3 text-white font-mono font-bold text-[11px] sm:text-xs transition-all duration-500 ease-out shadow-sm ${barColor}`}
                style={`width: ${Math.max(pct, 12)}%;`}
              >
                <span class="drop-shadow">{item.volume.toFixed(3)} L</span>
              </div>
            </div>

            {/* Density Label */}
            <span class="text-slate-400 font-mono text-right text-[11px] sm:text-xs">
              {item.density.toFixed(3)} kg/L
            </span>
          </div>
        );
      })
    }
  </div>
</div>
