---
// src/components/schemas/FAQSchema.astro
export interface FAQItem {
  question?: string;
  answer?: string;
  q?: string;
  a?: string;
}

export interface Props {
  faqs: FAQItem[];
}

const { faqs = [] } = Astro.props;

const stripHtml = (html: string) => html.replace(/<[^>]*>?/gm, ' ').replace(/\s+/g, ' ').trim();

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question || faq.q || '',
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripHtml(faq.answer || faq.a || ''),
    },
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
