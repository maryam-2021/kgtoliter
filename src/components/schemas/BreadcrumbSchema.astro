---
// src/components/schemas/BreadcrumbSchema.astro
export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items = [] } = Astro.props;
const siteUrl = Astro.site ? new URL(Astro.site) : new URL('https://kgtoliter.com');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url.startsWith('http') ? item.url : new URL(item.url, siteUrl).href,
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
