---
// src/pages/contact.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import { useI18n } from '@utils/i18n';

const locale = 'en';
const { t } = useI18n(locale);
---

<BaseLayout
  title={`${t('contact.title')} | ${t('site.title')}`}
  description={t('contact.description')}
  locale={locale}
>
  <main class="container mx-auto px-4 py-12 max-w-3xl">
    <div class="mb-10 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-3">{t('contact.title')}</h1>
      <p class="text-slate-400 text-base">{t('contact.description')}</p>
    </div>

    <div class="bg-surface-900/60 border border-white/[0.08] rounded-2xl p-6 sm:p-8 backdrop-blur-sm shadow-xl">
      <form class="space-y-5" onsubmit="return false;">
        <div>
          <label for="name" class="block text-xs font-mono text-slate-300 mb-2">{t('contact.form_name')}</label>
          <input
            type="text"
            id="name"
            required
            class="w-full px-4 py-2.5 rounded-lg bg-surface-950 border border-white/[0.1] text-white focus:border-brand-500 focus:outline-none transition-colors text-sm"
          />
        </div>

        <div>
          <label for="email" class="block text-xs font-mono text-slate-300 mb-2">{t('contact.form_email')}</label>
          <input
            type="email"
            id="email"
            required
            class="w-full px-4 py-2.5 rounded-lg bg-surface-950 border border-white/[0.1] text-white focus:border-brand-500 focus:outline-none transition-colors text-sm"
          />
        </div>

        <div>
          <label for="message" class="block text-xs font-mono text-slate-300 mb-2">{t('contact.form_message')}</label>
          <textarea
            id="message"
            rows="5"
            required
            class="w-full px-4 py-2.5 rounded-lg bg-surface-950 border border-white/[0.1] text-white focus:border-brand-500 focus:outline-none transition-colors text-sm"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3 px-6 rounded-lg bg-brand-500 hover:bg-brand-600 font-semibold text-white transition-colors cursor-pointer text-sm shadow-lg shadow-brand-500/20"
        >
          {t('contact.form_submit')}
        </button>
      </form>
    </div>
  </main>
</BaseLayout>
