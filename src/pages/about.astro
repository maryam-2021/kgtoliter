---
// src/pages/about.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import { useI18n } from '@utils/i18n';

const locale = 'en';
const { t } = useI18n(locale);
---

<BaseLayout
  title={`${t('about.title')} | ${t('site.title')}`}
  description={t('about.description')}
  locale={locale}
>
  <main class="container mx-auto px-4 py-12 max-w-4xl">
    <div class="mb-10 text-center">
      <span class="px-3 py-1 text-xs font-mono font-semibold rounded-full bg-brand-500/10 text-brand-400 border border-brand-500/20 uppercase tracking-wider mb-4 inline-block">
        {t('about.hero_subtitle')}
      </span>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-4">{t('about.hero_title')}</h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        {t('about.content')}
      </p>
    </div>

    <div class="bg-surface-900/60 border border-white/[0.08] rounded-2xl p-6 sm:p-8 backdrop-blur-sm space-y-6">
      <h2 class="text-xl font-bold text-white">Our Mission</h2>
      <p class="text-slate-300 leading-relaxed">
        We provide accurate, peer-reviewed density data and real-time calculation tools for science, engineering, culinary applications, construction, and petroleum logistics.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-white/[0.08]">
        <div class="bg-surface-950 p-4 rounded-xl border border-white/[0.06] text-center">
          <div class="text-2xl font-bold text-brand-400 font-mono">772+</div>
          <div class="text-xs text-slate-400 mt-1">Substances Cataloged</div>
        </div>
        <div class="bg-surface-950 p-4 rounded-xl border border-white/[0.06] text-center">
          <div class="text-2xl font-bold text-brand-400 font-mono">18</div>
          <div class="text-xs text-slate-400 mt-1">Languages Supported</div>
        </div>
        <div class="bg-surface-950 p-4 rounded-xl border border-white/[0.06] text-center">
          <div class="text-2xl font-bold text-brand-400 font-mono">100%</div>
          <div class="text-xs text-slate-400 mt-1">Free & Open Access</div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
