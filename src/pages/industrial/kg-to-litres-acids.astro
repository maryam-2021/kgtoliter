---
// src/pages/industrial/kg-to-litres-acids.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQAccordion from '../../components/interactive/FAQAccordion.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CustomDensitySolver from '../../components/interactive/CustomDensitySolver.astro';

const acidConcentrationData = [
  { name: 'Sulfuric Acid (Concentrated Reagent)', formula: 'H₂SO₄', unNumber: 'UN 1830 (Class 8)', conc: '98.0%', density: 1.836, massPerL: '1.836 kg', volPerKg: '0.545 L' },
  { name: 'Sulfuric Acid (Lead-Acid Battery Grade)', formula: 'H₂SO₄', unNumber: 'UN 2796 (Class 8)', conc: '33.5%', density: 1.250, massPerL: '1.250 kg', volPerKg: '0.800 L' },
  { name: 'Nitric Acid (Concentrated Tech Grade)', formula: 'HNO₃', unNumber: 'UN 2031 (Class 8/5.1)', conc: '68.0%', density: 1.410, massPerL: '1.410 kg', volPerKg: '0.709 L' },
  { name: 'Hydrochloric Acid (Concentrated / Muriatic)', formula: 'HCl', unNumber: 'UN 1789 (Class 8)', conc: '37.0%', density: 1.190, massPerL: '1.190 kg', volPerKg: '0.840 L' },
  { name: 'Hydrochloric Acid (Dilute Industrial Wash)', formula: 'HCl', unNumber: 'UN 1789 (Class 8)', conc: '20.0%', density: 1.098, massPerL: '1.098 kg', volPerKg: '0.911 L' },
  { name: 'Phosphoric Acid (Food / Industrial Grade)', formula: 'H₃PO₄', unNumber: 'UN 1805 (Class 8)', conc: '85.0%', density: 1.685, massPerL: '1.685 kg', volPerKg: '0.593 L' },
  { name: 'Acetic Acid (Glacial Anhydrous)', formula: 'CH₃COOH', unNumber: 'UN 2789 (Class 8/3)', conc: '99.5%', density: 1.049, massPerL: '1.049 kg', volPerKg: '0.953 L' },
  { name: 'Hydrofluoric Acid (Technical Solution)', formula: 'HF', unNumber: 'UN 1790 (Class 8/6.1)', conc: '48.0%', density: 1.150, massPerL: '1.150 kg', volPerKg: '0.870 L' },
];

const faqs = [
  {
    q: 'How many litres is 25 kg of 98% concentrated sulfuric acid?',
    a: '25 kg ÷ 1.836 kg/L = 13.617 Litres. In reverse, a standard 20-litre carboy of 98% sulfuric acid weighs 36.720 kg.'
  },
  {
    q: 'Why does acid density change with concentration?',
    a: 'Concentration measures the weight percentage of heavy acid molecules versus lighter water molecules (1.000 kg/L). For example, pure anhydrous sulfuric acid has a molar mass of 98.08 g/mol and tightly packs via hydrogen bonds, increasing solution density non-linearly from 1.000 kg/L (pure water) to 1.836 kg/L (98% H₂SO₄).'
  },
  {
    q: 'How do chemical engineers verify acid concentration using hydrometers?',
    a: 'Because the relationship between density (or Baumé scale °Bé) and acid concentration (% w/w) is mathematically standardized in ASTM / CRC reference tables, measuring density with a calibrated hydrometer allows instant calculation of exact acid percentage without chemical titration.'
  },
  {
    q: 'What is the golden rule when diluting concentrated acids by volume?',
    a: 'Always add acid to water ("AAA"), never water to acid! Dissolving concentrated sulfuric acid in water generates immense exothermic heat. Pouring water into acid can cause localized boiling and catastrophic corrosive acid splatter.'
  }
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Kg to Litres: Industrial Acids & Corrosive Solutions Guide',
    description: 'Engineering mass to volume conversion guide for industrial mineral acids: H2SO4, HCl, HNO3, H3PO4. Concentration curves, GHS UN hazard classes, and SDS density standards.',
    author: {
      '@type': 'Organization',
      name: 'Kg to Litre Chemical Engineering Review Board',
      url: 'https://kgtoliter.com/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Kg to Litre',
      url: 'https://kgtoliter.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://kgtoliter.com/favicon.svg',
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': 'https://kgtoliter.com/industrial/kg-to-litres-acids/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SpecialAnnouncement',
    name: 'Class 8 Corrosive Chemical Safety Notice',
    text: 'Mineral acids are hazardous, highly corrosive Class 8 dangerous goods. All mass-to-volume dosing calculations must be cross-referenced against the manufacturer Certificate of Analysis and Safety Data Sheet (SDS Section 9). Ensure acid-resistant PPE and containment protocols comply with OSHA/REACH directives.',
    category: 'https://www.wikidata.org/wiki/Q1056580'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<BaseLayout
  title="Kg to Litres: Industrial Acids & Corrosive Solutions Guide"
  description="Convert kg to litres for industrial mineral acids: Sulfuric (1.84 kg/L), Nitric (1.41 kg/L), Hydrochloric (1.19 kg/L), Phosphoric (1.69 kg/L). Concentration curves & SDS data."
  canonicalUrl="https://kgtoliter.com/industrial/kg-to-litres-acids/"
  schema={pageSchema}
>
  <main class="container mx-auto px-4 py-10 max-w-5xl space-y-10">
    <!-- Breadcrumbs -->
    <BreadcrumbNav
      categoryName="Industrial Chemicals"
      categorySlug="industrial"
      substanceName="Acids & Corrosive Solutions"
    />

    <!-- Header Block -->
    <header class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 text-xs font-mono font-semibold rounded-full bg-rose-500/10 text-rose-400 border border-rose-500/20 uppercase tracking-wider">
        <span>🧪 Domain E: Chemical Engineering QDP</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
        Kg to Litres: <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-amber-400">Industrial Acids &amp; Solutions</span>
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        Chemical plant batching, reactor dosing, and logistics calculations for concentrated mineral acids and corrosive reagents. Formulated with verified IUPAC, ASTM, and CRC Handbook physical data.
      </p>
    </header>

    <!-- YMYL E-E-A-T Safety Advisory Banner -->
    <section class="p-5 rounded-2xl bg-rose-950/40 border border-rose-500/40 space-y-2">
      <div class="flex items-center gap-2 text-rose-400 font-bold text-sm uppercase font-mono tracking-wider">
        <span>⚠️ Chemical Safety &amp; Regulatory Compliance Notice</span>
      </div>
      <p class="text-xs text-slate-300 leading-relaxed">
        Mineral acids are hazardous, highly corrosive Class 8 dangerous goods. All mass-to-volume dosing calculations must be cross-referenced against the manufacturer's specific Certificate of Analysis (CoA) and Safety Data Sheet (SDS Section 9). Ensure appropriate acid-resistant PPE and containment protocols comply with OSHA / REACH directives.
      </p>
      <div class="flex flex-wrap items-center gap-3 pt-2 text-[11px] font-mono text-slate-400">
        <span class="px-2 py-0.5 rounded bg-surface-900 border border-white/5 text-slate-300">Reviewed by Chemical Engineering Team</span>
        <span class="px-2 py-0.5 rounded bg-surface-900 border border-white/5 text-slate-300">CRC 104th Ed. / ISO 9001 Standards</span>
      </div>
    </section>

    <!-- Interactive Solver -->
    <section class="space-y-4">
      <CustomDensitySolver />
    </section>

    <!-- Concentration vs Density Master Table -->
    <section class="glass-card bg-surface-950/90 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-4">
      <div>
        <h2 class="text-2xl font-bold text-white mb-1">Industrial Acids Concentration &amp; Density Reference Table</h2>
        <p class="text-xs sm:text-sm text-slate-400">Physical density measured at 20°C (68°F) across standard industrial grades.</p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-white/5">
        <table class="w-full text-left text-sm font-sans">
          <thead class="bg-surface-900 text-xs font-mono uppercase text-slate-400">
            <tr>
              <th class="py-3.5 px-4">Chemical Reagent</th>
              <th class="py-3.5 px-4 text-center">GHS / UN Code</th>
              <th class="py-3.5 px-4 text-center font-mono">Assay (% w/w)</th>
              <th class="py-3.5 px-4 text-right font-mono">Density @ 20°C</th>
              <th class="py-3.5 px-4 text-right font-mono">1 Litre Mass</th>
              <th class="py-3.5 px-4 text-right font-mono">1 kg Volume</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-slate-300 font-mono text-xs sm:text-sm">
            {acidConcentrationData.map((item) => (
              <tr class="hover:bg-white/[0.02]">
                <td class="py-3.5 px-4 font-semibold text-white font-sans">
                  {item.name}
                  <span class="text-slate-500 font-mono text-xs block">{item.formula}</span>
                </td>
                <td class="py-3.5 px-4 text-center text-xs text-rose-400 font-mono">{item.unNumber}</td>
                <td class="py-3.5 px-4 text-center text-slate-300 font-bold">{item.conc}</td>
                <td class="py-3.5 px-4 text-right text-brand-400 font-bold">{item.density.toFixed(3)} kg/L</td>
                <td class="py-3.5 px-4 text-right text-emerald-400 font-bold">{item.massPerL}</td>
                <td class="py-3.5 px-4 text-right text-purple-400 font-bold">{item.volPerKg}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQs -->
    <section class="space-y-4">
      <div class="text-center space-y-2">
        <h2 class="text-2xl font-bold text-white">Frequently Asked Questions</h2>
        <p class="text-xs sm:text-sm text-slate-400">Chemical plant and laboratory mass-to-volume FAQs.</p>
      </div>
      <FAQAccordion faqs={faqs} />
    </section>

  </main>
</BaseLayout>
