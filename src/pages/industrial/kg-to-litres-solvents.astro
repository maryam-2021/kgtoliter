---
// src/pages/industrial/kg-to-litres-solvents.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQAccordion from '../../components/interactive/FAQAccordion.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CustomDensitySolver from '../../components/interactive/CustomDensitySolver.astro';
import { useI18n } from '../../utils/i18n';

const { locale = 'en' } = Astro.params;
const { t } = useI18n(locale);

const solventData = [
  { name: 'Acetone (99.5% HPLC Grade)', formula: 'C₃H₆O', unCode: 'UN 1090 (Class 3)', density: 0.784, massPerL: '0.784 kg', volPer10Kg: '12.755 L', flashPoint: '-20°C', sdsRef: 'SDS Section 9 (CRC 104th Ed)' },
  { name: 'Ethanol (100% Anhydrous)', formula: 'C₂H₅OH', unCode: 'UN 1170 (Class 3)', density: 0.789, massPerL: '0.789 kg', volPer10Kg: '12.674 L', flashPoint: '13°C', sdsRef: 'USP / BP Monograph' },
  { name: 'Ethanol (96% Azeotropic / Rectified)', formula: 'C₂H₅OH / H₂O', unCode: 'UN 1170 (Class 3)', density: 0.806, massPerL: '0.806 kg', volPer10Kg: '12.407 L', flashPoint: '17°C', sdsRef: 'Ph. Eur. Standard' },
  { name: 'Isopropyl Alcohol (IPA 99.8%)', formula: 'C₃H₈O', unCode: 'UN 1219 (Class 3)', density: 0.786, massPerL: '0.786 kg', volPer10Kg: '12.723 L', flashPoint: '12°C', sdsRef: 'ASTM D770 Specification' },
  { name: 'Methanol (Methyl Alcohol 99.9%)', formula: 'CH₃OH', unCode: 'UN 1230 (Class 3/6.1)', density: 0.792, massPerL: '0.792 kg', volPer10Kg: '12.626 L', flashPoint: '9.7°C', sdsRef: 'IMPCA Reference Standard' },
  { name: 'Methyl Ethyl Ketone (MEK / 2-Butanone)', formula: 'C₄H₈O', unCode: 'UN 1193 (Class 3)', density: 0.805, massPerL: '0.805 kg', volPer10Kg: '12.422 L', flashPoint: '-9°C', sdsRef: 'ASTM D740 Standard' },
  { name: 'Ethyl Acetate (99.8% Pure)', formula: 'C₄H₈O₂', unCode: 'UN 1173 (Class 3)', density: 0.902, massPerL: '0.902 kg', volPer10Kg: '11.086 L', flashPoint: '-4°C', sdsRef: 'ISO 4626 Solvent Standard' },
  { name: 'Tetrahydrofuran (THF Anhydrous)', formula: 'C₄H₈O', unCode: 'UN 2056 (Class 3)', density: 0.889, massPerL: '0.889 kg', volPer10Kg: '11.249 L', flashPoint: '-14°C', sdsRef: 'Sigma-Aldrich SDS' },
  { name: 'Toluene (Methylbenzene 99.8%)', formula: 'C₇H₈', unCode: 'UN 1294 (Class 3)', density: 0.867, massPerL: '0.867 kg', volPer10Kg: '11.534 L', flashPoint: '4°C', sdsRef: 'ASTM D841 Standard' },
  { name: 'Xylene (Mixed Isomers 99%)', formula: 'C₈H₁₀', unCode: 'UN 1307 (Class 3)', density: 0.864, massPerL: '0.864 kg', volPer10Kg: '11.574 L', flashPoint: '27°C', sdsRef: 'ASTM D843 Standard' },
  { name: 'n-Hexane (95% Tech Grade)', formula: 'C₆H₁₄', unCode: 'UN 1208 (Class 3)', density: 0.659, massPerL: '0.659 kg', volPer10Kg: '15.175 L', flashPoint: '-22°C', sdsRef: 'ASTM D1836 Standard' },
  { name: 'Dichloromethane (DCM / Methylene Chloride)', formula: 'CH₂Cl₂', unCode: 'UN 1593 (Class 6.1)', density: 1.326, massPerL: '1.326 kg', volPer10Kg: '7.541 L', flashPoint: 'None (Non-flam)', sdsRef: 'IUPAC Technical Report' },
  { name: 'Chloroform (Trichloromethane)', formula: 'CHCl₃', unCode: 'UN 1888 (Class 6.1)', density: 1.489, massPerL: '1.489 kg', volPer10Kg: '6.716 L', flashPoint: 'None (Non-flam)', sdsRef: 'ACS Reagent Grade' },
  { name: 'Acetonitrile (HPLC / LC-MS Grade)', formula: 'C₂H₃N', unCode: 'UN 1648 (Class 3)', density: 0.786, massPerL: '0.786 kg', volPer10Kg: '12.723 L', flashPoint: '2°C', sdsRef: 'Merck Millipore SDS' },
  { name: 'Dimethyl Sulfoxide (DMSO 99.9%)', formula: 'C₂H₆OS', unCode: 'Non-Regulated', density: 1.100, massPerL: '1.100 kg', volPer10Kg: '9.091 L', flashPoint: '87°C', sdsRef: 'Ph. Eur. Monograph' },
];

const faqs = [
  {
    q: 'How many litres is 10 kg of pure acetone?',
    a: '10 kg ÷ 0.784 kg/L = 12.755 Litres (12,755 mL). Acetone is 21.6% lighter than water, so 10 kg expands into nearly 12.8 litres of volume.'
  },
  {
    q: 'Why does ethanol density increase as purity drops from 100% to 96%?',
    a: 'Pure anhydrous ethanol has a density of 0.789 kg/L. Rectified azeotropic ethanol contains 4% dissolved water (1.000 kg/L). Because water molecules form tight hydrogen bonds between ethanol molecules, the volume contracts and solution density rises to 0.806 kg/L.'
  },
  {
    q: 'Why is Dichloromethane (DCM) so much denser than hydrocarbon solvents?',
    a: 'Dichloromethane (CH₂Cl₂) contains two heavy chlorine atoms (atomic mass 35.45 u each), raising its molecular density to 1.326 kg/L. Unlike acetone or hexane, DCM sinks to the bottom of water separation funnels.'
  },
  {
    q: 'What is the safety implication of solvent vapour density vs liquid density?',
    a: 'While liquid solvents are mostly lighter than water (0.65–0.90 kg/L), their volatile solvent vapours are 2 to 4 times heavier than atmospheric air (air = 1.0; acetone vapour = 2.0; hexane vapour = 2.97). Evaporated solvent vapours sink and travel along floors to distant ignition sources, requiring low-level explosion-proof exhaust ventilation.'
  }
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Kg to Litres: Industrial Solvents Technical Reference Guide',
    description: 'Engineering mass-to-volume guide for the top 15 industrial solvents: Acetone, Ethanol, IPA, MEK, Toluene, Xylene, DCM, and Hexane. SDS Section 9 physical densities, UN codes, and flash points.',
    author: {
      '@type': 'Organization',
      name: 'Kg to Litre Chemical Engineering Review Board',
      url: 'https://kgtoliter.com/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Kg to Litre',
      url: 'https://kgtoliter.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://kgtoliter.com/favicon.svg',
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': 'https://kgtoliter.com/industrial/kg-to-litres-solvents/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<BaseLayout
  title="Kg to Litres: Industrial Solvents Guide (Top 15 Solvents)"
  description="Convert kg to litres for industrial solvents: Acetone (0.784 kg/L), Ethanol (0.789 kg/L), IPA (0.786 kg/L), Toluene (0.867 kg/L), DCM (1.326 kg/L). SDS & UN data."
  locale={locale}
  canonicalUrl="https://kgtoliter.com/industrial/kg-to-litres-solvents/"
  schema={pageSchema}
>
  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-12">
    
    <!-- Breadcrumbs -->
    <BreadcrumbNav
      categoryName="Industrial Chemicals"
      categorySlug="industrial"
      substanceName="Industrial Solvents Conversion Guide"
    />

    <!-- Header Block (H1) -->
    <header class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 text-xs font-mono font-semibold rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 uppercase tracking-wider">
        <span>🧪 Domain E: Chemical Engineering QDP</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
        Kg to Litres: <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-brand-400">Industrial Solvents Guide</span> (Top 15 Solvents)
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        Chemical synthesis batching, reactor solvent dosing, and hazardous packaging mass-to-volume calculations across the top 15 volatile industrial and laboratory solvents.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/industrial/kg-to-litres-acids/"
          class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-surface-900 text-slate-300 hover:text-white border border-white/10 transition-all"
        >
          Industrial Acids Guide &rarr;
        </a>
        <a
          href="/physics/density-vs-specific-gravity/"
          class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-surface-900 text-slate-300 hover:text-white border border-white/10 transition-all"
        >
          Density vs Specific Gravity &rarr;
        </a>
      </div>
    </header>

    <!-- Chemical Safety & E-E-A-T Badge -->
    <section class="p-5 rounded-2xl bg-cyan-950/40 border border-cyan-500/40 space-y-2">
      <div class="flex items-center gap-2 text-cyan-400 font-bold text-sm uppercase font-mono tracking-wider">
        <span>⚠️ Chemical Safety &amp; Metrology Notice</span>
      </div>
      <p class="text-xs text-slate-300 leading-relaxed">
        All solvent densities are standardized at 20°C (68°F) per IUPAC / CRC Handbook 104th Edition and cross-verified against Section 9 of representative Manufacturer Safety Data Sheets (SDS). Volatile organic solvents present flammable and toxic hazards; always follow GHS workplace handling directives.
      </p>
      <div class="flex flex-wrap items-center gap-3 pt-2 text-[11px] font-mono text-slate-400">
        <span class="px-2 py-0.5 rounded bg-surface-900 border border-white/5 text-slate-300">Reviewed by Chemical Engineering Team</span>
        <span class="px-2 py-0.5 rounded bg-surface-900 border border-white/5 text-slate-300">ISO 9001 / ACS Reagent Standards</span>
      </div>
    </section>

    <!-- Interactive Solver -->
    <section class="space-y-4">
      <CustomDensitySolver />
    </section>

    <!-- Top 15 Solvents Master Table -->
    <section class="glass-card bg-surface-950/90 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-6">
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-1">
          Top 15 Industrial Solvents Density &amp; Conversion Matrix
        </h2>
        <p class="text-xs sm:text-sm text-slate-400">
          Physical liquid density, UN transport classification, flash points, and SDS references.
        </p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-white/5">
        <table class="w-full text-left text-sm font-sans">
          <thead class="bg-surface-900 text-xs font-mono uppercase text-slate-400">
            <tr>
              <th class="py-3.5 px-4">Solvent Compound</th>
              <th class="py-3.5 px-4 text-center">UN / Class</th>
              <th class="py-3.5 px-4 text-right font-mono">Density @ 20°C</th>
              <th class="py-3.5 px-4 text-right font-mono">1 Litre Mass</th>
              <th class="py-3.5 px-4 text-right font-mono">10 kg Volume</th>
              <th class="py-3.5 px-4 text-center">Flash Point</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-slate-300 font-mono text-xs sm:text-sm">
            {solventData.map((sd) => (
              <tr class="hover:bg-white/[0.02]">
                <td class="py-3.5 px-4 font-semibold text-white font-sans">
                  {sd.name}
                  <span class="text-slate-500 font-mono text-xs block">{sd.formula}</span>
                </td>
                <td class="py-3.5 px-4 text-center text-xs text-cyan-400 font-mono">{sd.unCode}</td>
                <td class="py-3.5 px-4 text-right text-brand-400 font-bold">{sd.density.toFixed(3)} kg/L</td>
                <td class="py-3.5 px-4 text-right text-emerald-400 font-bold">{sd.massPerL}</td>
                <td class="py-3.5 px-4 text-right text-purple-400 font-bold">{sd.volPer10Kg}</td>
                <td class="py-3.5 px-4 text-center text-slate-400 text-xs">{sd.flashPoint}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQs -->
    <section class="space-y-6" id="faq">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Frequently Asked Questions</h2>
        <p class="text-slate-400 text-sm">Industrial chemistry and solvent mass-to-volume FAQs.</p>
      </div>
      <FAQAccordion faqs={faqs} />
    </section>

  </main>
</BaseLayout>
