---
// src/pages/cooking/condiments-density-guide.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQAccordion from '../../components/interactive/FAQAccordion.astro';
import CalculatorWidget from '../../components/CalculatorWidget.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CustomDensitySolver from '../../components/interactive/CustomDensitySolver.astro';

const condimentsList = [
  { name: 'Tomato Ketchup', density: 1.150, brix: '30–33° Bx', massPerL: '1.150 kg', volPerKg: '0.870 L', note: 'Non-Newtonian shear-thinning fluid' },
  { name: 'Mayonnaise (Real)', density: 0.940, brix: 'N/A', massPerL: '0.940 kg', volPerKg: '1.064 L', note: 'High oil emulsion (floats on water)' },
  { name: 'Soy Sauce (Regular)', density: 1.160, brix: 'N/A', massPerL: '1.160 kg', volPerKg: '0.862 L', note: 'High dissolved salt (15–18% NaCl)' },
  { name: 'Yellow Mustard (Prepared)', density: 1.052, brix: 'N/A', massPerL: '1.052 kg', volPerKg: '0.951 L', note: 'Aqueous vinegar suspension' },
  { name: 'Hot Chili Sauce (Sriracha)', density: 1.120, brix: '25° Bx', massPerL: '1.120 kg', volPerKg: '0.893 L', note: 'Chili purée with sugar & vinegar' },
  { name: 'Barbecue Sauce (Sweet)', density: 1.220, brix: '42° Bx', massPerL: '1.220 kg', volPerKg: '0.820 L', note: 'Molasses and high fructose corn syrup' },
  { name: 'Distilled White Vinegar (5%)', density: 1.006, brix: 'N/A', massPerL: '1.006 kg', volPerKg: '0.994 L', note: 'Dilute acetic acid in water' },
  { name: 'Balsamic Vinegar of Modena', density: 1.240, brix: '50–60° Bx', massPerL: '1.240 kg', volPerKg: '0.806 L', note: 'Concentrated grape must reduction' },
  { name: 'Worcestershire Sauce', density: 1.162, brix: 'N/A', massPerL: '1.162 kg', volPerKg: '0.861 L', note: 'Fermented tamarind & anchovy extract' },
];

const faqs = [
  {
    q: 'How many litres is 1 kg of tomato ketchup?',
    a: '1 kg of tomato ketchup equals 0.870 litres (870 mL) because ketchup has a density of 1.150 kg/L. In reverse, 1 litre of ketchup weighs 1.150 kg.'
  },
  {
    q: 'Why is mayonnaise lighter than water per litre?',
    a: 'Real commercial mayonnaise consists of 70% to 80% vegetable oil (density ~0.92 kg/L) emulsified with egg yolk. Because oil is lighter than water, the emulsion has a net density of ~0.940 kg/L (1 litre weighs only 940 grams).'
  },
  {
    q: 'Why is balsamic vinegar so much denser than white vinegar?',
    a: 'White distilled vinegar is 95% water and 5% acetic acid (density 1.006 kg/L). Traditional balsamic vinegar undergoes years of barrel aging and water evaporation, concentrating natural grape sugars up to 60° Brix, raising density to 1.240 kg/L.'
  },
  {
    q: 'What is the difference between viscosity and density in sauces?',
    a: 'Viscosity measures a fluid\'s resistance to flow (thickness), while density measures mass per unit volume. Ketchup has high viscosity (flows slowly) and medium density (1.15 kg/L). Heavy motor oil is thick but has low density (0.88 kg/L). Never confuse thickness with weight.'
  }
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Kg to Litres: Condiments & Sauces Density Reference Guide',
    description: 'Comprehensive mass-to-volume guide for condiments and sauces: ketchup, mayonnaise, soy sauce, mustard, vinegar, and barbecue sauce densities.',
    author: {
      '@type': 'Organization',
      name: 'Kg to Litre Food Science Team',
      url: 'https://kgtoliter.com/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Kg to Litre',
      url: 'https://kgtoliter.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://kgtoliter.com/favicon.svg',
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': 'https://kgtoliter.com/cooking/condiments-density-guide/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<BaseLayout
  title="Condiments & Sauces Density Guide: kg to Litres Conversions"
  description="Master mass-to-volume conversions for condiments & sauces. Density reference table for ketchup (1.15 kg/L), mayo (0.94 kg/L), soy sauce (1.16 kg/L), and vinegars."
  canonicalUrl="https://kgtoliter.com/cooking/condiments-density-guide/"
  schema={pageSchema}
>
  <main class="container mx-auto px-4 py-10 max-w-5xl space-y-10">
    <!-- Breadcrumbs -->
    <BreadcrumbNav
      categoryName="Cooking & Food"
      categorySlug="cooking"
      substanceName="Condiments & Sauces Density Guide"
    />

    <!-- Header Block -->
    <header class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 text-xs font-mono font-semibold rounded-full bg-purple-500/10 text-purple-400 border border-purple-500/20 uppercase tracking-wider">
        <span>🍳 Domain B: Food & Culinary Grouped QDP</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
        Kg to Litres: <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-brand-400">Condiments &amp; Sauces Guide</span>
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        Commercial catering and food processing guide for converting mass (<strong class="text-white">kg</strong>) to volume (<strong class="text-white">litres</strong>) across viscous condiments, emulsions, brine solutions, and aged vinegars.
      </p>
    </header>

    <!-- Interactive Solver -->
    <section class="space-y-4">
      <CustomDensitySolver />
    </section>

    <!-- Master Comparative Table -->
    <section class="glass-card bg-surface-950/90 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-4">
      <h2 class="text-2xl font-bold text-white">Master Condiments Density &amp; Conversion Matrix</h2>
      <div class="overflow-x-auto rounded-xl border border-white/5">
        <table class="w-full text-left text-sm font-sans">
          <thead class="bg-surface-900 text-xs font-mono uppercase text-slate-400">
            <tr>
              <th class="py-3.5 px-4">Condiment / Sauce</th>
              <th class="py-3.5 px-4 text-center font-mono">Density @ 20°C</th>
              <th class="py-3.5 px-4 text-center font-mono">Sugar (Brix)</th>
              <th class="py-3.5 px-4 text-right font-mono">1 Litre Mass</th>
              <th class="py-3.5 px-4 text-right font-mono">1 kg Volume</th>
              <th class="py-3.5 px-4">Characteristics</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-slate-300 font-mono text-xs sm:text-sm">
            {condimentsList.map((item) => (
              <tr class="hover:bg-white/[0.02]">
                <td class="py-3.5 px-4 font-semibold text-white font-sans">{item.name}</td>
                <td class="py-3.5 px-4 text-center text-brand-400 font-bold">{item.density.toFixed(3)} kg/L</td>
                <td class="py-3.5 px-4 text-center text-slate-400">{item.brix}</td>
                <td class="py-3.5 px-4 text-right text-emerald-400 font-bold">{item.massPerL}</td>
                <td class="py-3.5 px-4 text-right text-purple-400 font-bold">{item.volPerKg}</td>
                <td class="py-3.5 px-4 text-slate-400 font-sans text-xs">{item.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Individual QDH Headings for Key Condiments -->
    <div class="space-y-8">
      
      <!-- QDH 1: Tomato Ketchup -->
      <section class="glass-card bg-surface-950/70 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-3" id="ketchup-density">
        <h2 class="text-2xl font-bold text-white flex items-center gap-2">
          <span>🍅</span> 1. Tomato Ketchup kg to Litres (1.150 kg/L)
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Standard commercial tomato ketchup (Heinz grade) contains 30% to 33% tomato and sugar solids dissolved in vinegar and water, yielding a density of <strong>1.150 kg/L</strong>. 
          To convert 10 kg of bulk commercial ketchup into litres: <code>10 kg ÷ 1.150 kg/L = 8.696 Litres</code>. In reverse, a 5-litre restaurant dispenser tub of ketchup weighs <code>5.750 kg</code>.
        </p>
      </section>

      <!-- QDH 2: Mayonnaise -->
      <section class="glass-card bg-surface-950/70 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-3" id="mayo-density">
        <h2 class="text-2xl font-bold text-white flex items-center gap-2">
          <span>🥚</span> 2. Mayonnaise kg to Litres (0.940 kg/L)
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Because authentic mayonnaise consists primarily of refined vegetable oils (density 0.92 kg/L) suspended in an egg-emulsion matrix with microscopic trapped air micro-bubbles, mayonnaise is lighter than water with a density of <strong>0.940 kg/L</strong>. 
          Therefore, 1 kg of mayonnaise occupies <strong>1.064 Litres (1,064 mL)</strong>.
        </p>
      </section>

      <!-- QDH 3: Soy Sauce -->
      <section class="glass-card bg-surface-950/70 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-3" id="soy-sauce-density">
        <h2 class="text-2xl font-bold text-white flex items-center gap-2">
          <span>🥢</span> 3. Soy Sauce kg to Litres (1.160 kg/L)
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Naturally brewed soy sauce contains 15% to 18% dissolved sodium chloride (NaCl) along with wheat and hydrolyzed soy proteins, raising fluid density to <strong>1.160 kg/L</strong>. 
          When purchasing a 20-litre food service drum of soy sauce, its net liquid mass is <code>20 L × 1.160 kg/L = 23.200 kg</code>.
        </p>
      </section>

      <!-- QDH 4: Vinegars -->
      <section class="glass-card bg-surface-950/70 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-3" id="vinegar-density">
        <h2 class="text-2xl font-bold text-white flex items-center gap-2">
          <span>🍇</span> 4. Vinegar Varieties: White (1.006 kg/L) vs Balsamic (1.240 kg/L)
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          While distilled white vinegar closely matches pure water at <strong>1.006 kg/L</strong>, artisanal and commercial balsamic vinegars are thickened through grape must reduction up to 60° Brix, increasing density to <strong>1.240 kg/L</strong> (over 23% heavier than white vinegar).
        </p>
      </section>

    </div>

    <!-- FAQs -->
    <section class="space-y-4">
      <div class="text-center space-y-2">
        <h2 class="text-2xl font-bold text-white">Frequently Asked Questions</h2>
        <p class="text-xs sm:text-sm text-slate-400">Questions about condiment mass and volume calculations.</p>
      </div>
      <FAQAccordion faqs={faqs} />
    </section>

  </main>
</BaseLayout>
