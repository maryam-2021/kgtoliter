---
// src/pages/kg-to-litres/index.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CalculatorWidget from '../../components/CalculatorWidget.astro';
import FAQAccordion from '../../components/interactive/FAQAccordion.astro';

const quickConversions = [
  { name: 'Water', result: '1 kg = 1.000 L', density: '1.000 kg/L', icon: '💧' },
  { name: 'Milk', result: '1 kg = 0.971 L', density: '1.030 kg/L', icon: '🥛' },
  { name: 'Olive Oil', result: '1 kg = 1.099 L', density: '0.910 kg/L', icon: '🫒' },
  { name: 'Honey', result: '1 kg = 0.704 L', density: '1.420 kg/L', icon: '🍯' },
  { name: 'Diesel', result: '1 kg = 1.202 L', density: '0.832 kg/L', icon: '⛽' },
  { name: 'Gasoline', result: '1 kg = 1.337 L', density: '0.748 kg/L', icon: '🚗' },
];

const faqs = [
  {
    q: 'How do you convert kg to litres?',
    a: "Divide the mass in kilograms by the substance's density in kg/L. Formula: Volume (L) = Mass (kg) ÷ Density (kg/L)."
  },
  {
    q: 'Is 1 kg always equal to 1 litre?',
    a: 'No, 1 kg equals 1 litre only for water at 20°C (density 1.000 kg/L). Lighter substances yield more than 1 litre per kg, while heavier substances yield less.'
  },
  {
    q: 'How many litres is 1 kg of olive oil?',
    a: '1 kg of olive oil equals 1.099 litres because olive oil has a density of 0.910 kg/L (1 ÷ 0.910 = 1.099 L).'
  }
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Kg to Litres Converter - Mass to Volume Reference',
    description: 'Free online kg to litres converter. Convert kilograms (kg) to litres (L) with formulas, density factors, and quick conversion tables.',
    url: 'https://kgtoliter.com/kg-to-litres/',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<BaseLayout 
  title="Kg to Litres Converter | Mass to Volume Calculator"
  description="Free online kg to litres converter. Convert kilograms (kg) to litres (L) with formulas, density factors, and quick conversion tables for 772+ substances."
  canonicalUrl="https://kgtoliter.com/kg-to-litres/"
  schema={pageSchema}
>
  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-10">
    <BreadcrumbNav
      categoryName="Universal Hubs"
      categorySlug="convert"
      substanceName="Kg to Litres Converter"
    />

    <div class="mb-6 text-center space-y-3">
      <span class="px-3 py-1 text-xs font-mono font-semibold rounded-full bg-brand-500/10 text-brand-400 border border-brand-500/20 uppercase tracking-wider inline-block">
        Conversion Reference
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white section-title">
        Kg to Litres Converter
      </h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        Use our <strong class="text-white">kg to litres converter</strong> to calculate the exact physical relationship between mass in kilograms (<strong class="text-white">kg</strong>) and spatial volume in litres (<strong class="text-white">L</strong>) using verified material density values.
      </p>
    </div>

    <!-- Live Calculator -->
    <div class="space-y-4">
      <CalculatorWidget defaultMass={1} defaultSubstanceId="water" />
    </div>

    <!-- Quick Reference Card -->
    <div class="glass-card p-6 sm:p-8 rounded-2xl border border-white/[0.08] shadow-xl space-y-4">
      <h2 class="text-xl sm:text-2xl font-bold text-white">Standard 1 Kg to Litres Conversions</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {
          quickConversions.map((item) => (
            <div class="bg-surface-950/80 p-4 rounded-xl border border-white/[0.06] text-center hover:border-brand-500/30 transition-colors">
              <div class="text-2xl mb-1">{item.icon}</div>
              <div class="text-sm font-semibold text-slate-300">{item.name}</div>
              <div class="font-bold text-base sm:text-lg text-brand-400 font-mono mt-1">{item.result}</div>
              <div class="text-[11px] text-slate-500 font-mono mt-0.5">({item.density})</div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Details -->
    <div class="space-y-8 text-slate-300">
      <section class="glass-card p-6 sm:p-8 rounded-2xl border border-white/[0.08] space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-white">How the Kg to Litres Converter Works</h2>
        <p class="leading-relaxed">
          Converting kilograms (kg) to litres (L) requires knowing the substance's density (&rho;). Because kilograms measure the amount of matter (mass) while litres measure three-dimensional volume, the conversion depends on how tightly packed the molecules are.
        </p>
        <div class="p-5 rounded-xl bg-surface-950/90 border border-brand-500/20 text-center font-mono text-lg sm:text-xl font-bold text-brand-400">
          Volume (L) = Mass (kg) ÷ Density (kg/L)
        </div>
      </section>

      <!-- UK & International SI Spelling Guide -->
      <section class="glass-card p-6 sm:p-8 rounded-2xl border border-white/[0.08] space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-white">UK &amp; Commonwealth Spelling: Litre vs. Liter</h2>
        <p class="leading-relaxed">
          In the United Kingdom, Canada, Australia, New Zealand, Ireland, and across the Commonwealth, the standard official spelling is <strong class="text-white">litre</strong> (plural: <strong class="text-white">litres</strong>), which adheres to the International System of Units (SI) and BIPM standard. In the United States, the customary spelling is <strong class="text-white">liter</strong>.
        </p>
        <p class="leading-relaxed text-sm text-slate-400">
          Both terms represent the identical physical metric volume (1 cubic decimetre, or 1,000 cm³). If you are working with UK Imperial gallons, note that 1 UK (Imperial) gallon = 4.54609 litres, which differs significantly from the US liquid gallon (3.78541 litres).
        </p>
      </section>

      <!-- FAQs -->
      <section class="space-y-6" id="faq">
        <div class="text-center space-y-2">
          <h2 class="text-2xl font-extrabold text-white">Frequently Asked Questions</h2>
        </div>
        <FAQAccordion faqs={faqs} />
      </section>

      <div class="pt-4 text-center flex flex-wrap justify-center gap-3">
        <a href="/kg-to-litres-guide/" class="btn-primary inline-flex items-center gap-2">
          <span>Complete Conversion Guide &rarr;</span>
        </a>
        <a href="/density-reference/" class="btn-secondary inline-flex items-center gap-2">
          <span>772+ Density Reference &rarr;</span>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
