---
// src/pages/kg-to-litres/index.astro
import BaseLayout from '@layouts/BaseLayout.astro';

const quickConversions = [
  { name: 'Water', result: '1 kg = 1.000 L', density: '1.000 kg/L', icon: '💧' },
  { name: 'Milk', result: '1 kg = 0.971 L', density: '1.030 kg/L', icon: '🥛' },
  { name: 'Olive Oil', result: '1 kg = 1.099 L', density: '0.910 kg/L', icon: '🫒' },
  { name: 'Honey', result: '1 kg = 0.704 L', density: '1.420 kg/L', icon: '🍯' },
  { name: 'Diesel', result: '1 kg = 1.202 L', density: '0.832 kg/L', icon: '⛽' },
  { name: 'Gasoline', result: '1 kg = 1.337 L', density: '0.748 kg/L', icon: '🚗' },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Kg to Litres - Mass to Volume Conversion Reference',
  description: 'Learn how to convert kg to litres. Formulas, density factors, and quick conversion tables for liquids and bulk materials.',
  url: 'https://kgtoliter.com/kg-to-litres/',
};
---

<BaseLayout 
  title="Kg to Litres - Mass to Volume Conversion Reference"
  description="Learn how to convert kg to litres. Formulas, density factors, and quick conversion tables for liquids and bulk materials."
  canonicalUrl="https://kgtoliter.com/kg-to-litres/"
  schema={pageSchema}
>
  <div class="container mx-auto px-4 py-12 max-w-4xl">
    <div class="mb-10 text-center">
      <span class="px-3 py-1 text-xs font-mono font-semibold rounded-full bg-brand-500/10 text-brand-400 border border-brand-500/20 uppercase tracking-wider mb-4 inline-block">
        Educational Reference
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4 section-title">
        Kg to Litres Conversion
      </h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        Understand the physical relationship between mass and spatial volume using material density factors.
      </p>
    </div>

    <!-- Quick Reference Card -->
    <div class="glass-card p-6 sm:p-8 rounded-2xl mb-10 border border-white/[0.08] shadow-xl">
      <h2 class="text-xl font-bold text-white mb-4">Standard 1 Kg Conversions</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {
          quickConversions.map((item) => (
            <div class="bg-surface-950/80 p-4 rounded-xl border border-white/[0.06] text-center hover:border-brand-500/30 transition-colors">
              <div class="text-2xl mb-1">{item.icon}</div>
              <div class="text-sm font-semibold text-slate-300">{item.name}</div>
              <div class="font-bold text-base sm:text-lg text-brand-400 font-mono mt-1">{item.result}</div>
              <div class="text-[11px] text-slate-500 font-mono mt-0.5">({item.density})</div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Details -->
    <div class="space-y-8 text-slate-300">
      <section class="glass-card p-6 sm:p-8 rounded-2xl border border-white/[0.08] space-y-4">
        <h2 class="text-xl sm:text-2xl font-bold text-white">How Kg Converts to Litres</h2>
        <p class="leading-relaxed">
          Converting kilograms (kg) to litres (L) requires knowing the substance's density ($\rho$). Because kilograms measure the amount of matter (mass) while litres measure three-dimensional volume, the conversion depends on how tightly packed the molecules are.
        </p>
        <div class="p-5 rounded-xl bg-surface-950/90 border border-brand-500/20 text-center font-mono text-lg sm:text-xl font-bold text-brand-400">
          Volume (L) = Mass (kg) ÷ Density (kg/L)
        </div>
      </section>

      <div class="pt-4 text-center flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary inline-flex items-center gap-2">
          <span>Open Main Converter</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
        </a>
        <a href="/kg-to-litres-guide/" class="btn-secondary inline-flex items-center gap-2">
          <span>Full Conversion Guide &rarr;</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
