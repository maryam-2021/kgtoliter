---
// src/pages/construction/kg-to-litres-aggregates.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQAccordion from '../../components/interactive/FAQAccordion.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CustomDensitySolver from '../../components/interactive/CustomDensitySolver.astro';

const aggregateData = [
  { name: 'Sharp Sand (Dry / Loose)', bulkDensity: 1.600, solidDensity: 2.650, volPerTonne: '625 Litres', massPerM3: '1,600 kg', note: 'Concreting sand, coarse angular grains' },
  { name: 'Building Sand / Soft Sand', bulkDensity: 1.550, solidDensity: 2.650, volPerTonne: '645 Litres', massPerM3: '1,550 kg', note: 'Bricklaying mortar sand' },
  { name: 'Crushed Gravel (20mm / 3/4" Aggregate)', bulkDensity: 1.520, solidDensity: 2.700, volPerTonne: '658 Litres', massPerM3: '1,520 kg', note: 'Standard drainage & concrete aggregate' },
  { name: 'MOT Type 1 Sub-Base (Crushed Limestone)', bulkDensity: 2.100, solidDensity: 2.700, volPerTonne: '476 Litres', massPerM3: '2,100 kg', note: 'Compacted granular road base' },
  { name: 'Crushed Granite / Ballast', bulkDensity: 1.680, solidDensity: 2.750, volPerTonne: '595 Litres', massPerM3: '1,680 kg', note: 'Heavy railway ballast & high-strength concrete' },
  { name: 'Topsoil (Dry / Screened)', bulkDensity: 1.250, solidDensity: 2.600, volPerTonne: '800 Litres', massPerM3: '1,250 kg', note: 'Landscape grade loam with organic matter' },
  { name: 'Expanded Clay Aggregate (Lightweight)', bulkDensity: 0.450, solidDensity: 1.200, volPerTonne: '2,222 Litres', massPerM3: '450 kg', note: 'Lightweight fill & green roof substrate' },
];

const faqs = [
  {
    q: 'What is the difference between bulk density and solid particle density for aggregates?',
    a: 'Solid particle density (typically 2.65 kg/L for quartz/limestone) measures the mass of solid mineral excluding all air voids. Bulk density (1.50–1.65 kg/L) measures the mass divided by total volume, including the empty void spaces between loose aggregate stones.'
  },
  {
    q: 'How many litres are in a 1-tonne (1000 kg) bulk bag of sand?',
    a: '1,000 kg ÷ 1.600 kg/L = 625 Litres (0.625 m³). For gravel (bulk density 1.52 kg/L), 1 tonne equals 658 Litres.'
  },
  {
    q: 'How does moisture content affect sand bulk density (bulking of sand)?',
    a: 'Adding 4% to 8% surface moisture creates surface tension film around sand grains, pushing them apart. This paradoxical "bulking" increases volume by up to 25% and lowers loose bulk density before moisture begins saturating voids.'
  }
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Kg to Litres: Sand, Gravel & Aggregates Builder\'s Guide',
    description: 'Civil engineering mass to volume guide for sand, gravel, MOT Type 1, and aggregates. Bulk density vs solid particle density per ASTM C29.',
    author: {
      '@type': 'Organization',
      name: 'Kg to Litre Civil Engineering Review Board',
      url: 'https://kgtoliter.com/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Kg to Litre',
      url: 'https://kgtoliter.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://kgtoliter.com/favicon.svg',
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': 'https://kgtoliter.com/construction/kg-to-litres-aggregates/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<BaseLayout
  title="Kg to Litres: Sand, Gravel & Aggregates Guide (Bulk Density)"
  description="Convert kg to litres for construction aggregates: Sharp sand (1.60 kg/L), Gravel (1.52 kg/L), MOT Type 1 (2.10 kg/L). Bulk bag volume calculations & ASTM C29 specs."
  canonicalUrl="https://kgtoliter.com/construction/kg-to-litres-aggregates/"
  schema={pageSchema}
>
  <main class="container mx-auto px-4 py-10 max-w-5xl space-y-10">
    <!-- Breadcrumbs -->
    <BreadcrumbNav
      categoryName="Construction Materials"
      categorySlug="construction"
      substanceName="Sand, Gravel & Aggregates"
    />

    <!-- Header Block -->
    <header class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 text-xs font-mono font-semibold rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20 uppercase tracking-wider">
        <span>🏗️ Domain F: Construction Materials QDP</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
        Kg to Litres: <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-brand-400">Sand, Gravel &amp; Aggregates</span>
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        Civil engineering calculations for concrete mix designs, bulk bag sizing, trench backfill volume, and compacted foundation base density.
      </p>
    </header>

    <!-- Interactive Solver -->
    <section class="space-y-4">
      <CustomDensitySolver />
    </section>

    <!-- Master Comparative Table -->
    <section class="glass-card bg-surface-950/90 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-4">
      <h2 class="text-2xl font-bold text-white">Aggregates Bulk Density &amp; Volume per Tonne Matrix</h2>
      <div class="overflow-x-auto rounded-xl border border-white/5">
        <table class="w-full text-left text-sm font-sans">
          <thead class="bg-surface-900 text-xs font-mono uppercase text-slate-400">
            <tr>
              <th class="py-3.5 px-4">Aggregate Material</th>
              <th class="py-3.5 px-4 text-right font-mono">Bulk Density</th>
              <th class="py-3.5 px-4 text-right font-mono">Solid Particle Density</th>
              <th class="py-3.5 px-4 text-right font-mono">1 Tonne Volume</th>
              <th class="py-3.5 px-4">Standard Use Case</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-slate-300 font-mono text-xs sm:text-sm">
            {aggregateData.map((item) => (
              <tr class="hover:bg-white/[0.02]">
                <td class="py-3.5 px-4 font-semibold text-white font-sans">{item.name}</td>
                <td class="py-3.5 px-4 text-right text-brand-400 font-bold">{item.bulkDensity.toFixed(3)} kg/L</td>
                <td class="py-3.5 px-4 text-right text-slate-400">{item.solidDensity.toFixed(3)} kg/L</td>
                <td class="py-3.5 px-4 text-right text-emerald-400 font-bold">{item.volPerTonne}</td>
                <td class="py-3.5 px-4 text-slate-400 font-sans text-xs">{item.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQs -->
    <section class="space-y-4">
      <div class="text-center space-y-2">
        <h2 class="text-2xl font-bold text-white">Frequently Asked Questions</h2>
        <p class="text-xs sm:text-sm text-slate-400">Civil engineering and bulk bag calculations.</p>
      </div>
      <FAQAccordion faqs={faqs} />
    </section>

  </main>
</BaseLayout>
