---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import AdvancedBatchConverter from '../components/interactive/AdvancedBatchConverter.astro';
import FAQAccordion from '../components/interactive/FAQAccordion.astro';

const title = 'Batch Mass to Volume Converter & CSV Bulk Upload';
const description =
  'Convert multiple substances from kg to litres or litres to kg simultaneously. Features CSV bulk file upload, custom density override, and instant data export.';

const batchFaqs = [
  {
    q: 'How does the batch converter handle multiple substances with different densities?',
    a: 'Each row independently evaluates the material density against the mass or volume entered. The total aggregate volume is calculated by summing individual substance volumes: V_total = Σ(m_i / ρ_i).',
  },
  {
    q: 'What CSV file formats are supported for bulk conversion upload?',
    a: 'The bulk parser accepts .csv, .tsv, and plain text files with comma, semicolon, or tab delimiters. Columns are automatically mapped for Substance Name, Mass (kg), and Density (kg/L).',
  },
  {
    q: 'Can I override the reference density for custom blends or formulations?',
    a: 'Yes. You can directly edit the density field in each row or supply a custom density column in your uploaded CSV.',
  },
  {
    q: 'Can I export the calculated conversions back into CSV or JSON?',
    a: 'Yes. Once calculations are complete, click "Export CSV" or "Export JSON" to download the enriched dataset with calculated volumes and densities.',
  },
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Batch Mass to Volume Converter & CSV Bulk Upload',
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Any',
    description: description,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: batchFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<BaseLayout title={title} description={description} schema={pageSchema} canonicalUrl="/batch-converter/">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-16 space-y-12">
    <!-- Breadcrumbs -->
    <BreadcrumbNav categoryName="Tools" categorySlug="tools" substanceName="Batch & CSV Converter" />

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto space-y-4 animate-fade-in-up">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/20 mb-2">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
        <span class="text-xs font-semibold text-brand-400 font-mono">Bulk Conversion Engine</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Batch Converter &amp; CSV Bulk Processor
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Calculate mass-to-volume conversions across multiple materials in real time, or upload spreadsheets for automated batch processing.
      </p>
    </header>

    <!-- Main Interactive Component -->
    <section class="reveal-section">
      <AdvancedBatchConverter />
    </section>

    <!-- How it Works Guide -->
    <section class="reveal-section glass-card p-6 sm:p-8 rounded-2xl space-y-6">
      <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-brand-500/15 text-brand-400 flex items-center justify-center text-sm font-bold">
          ⚡
        </span>
        <span>How Bulk &amp; Batch Processing Works</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="p-5 rounded-xl bg-surface-900/60 border border-white/[0.04] space-y-2">
          <div class="w-7 h-7 rounded-full bg-brand-500/20 text-brand-400 font-bold text-xs flex items-center justify-center font-mono">
            01
          </div>
          <h3 class="text-sm font-bold text-white">Add Rows or Upload File</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Select substances from 700+ catalogue items or drop your custom CSV file containing material and mass entries.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-surface-900/60 border border-white/[0.04] space-y-2">
          <div class="w-7 h-7 rounded-full bg-brand-500/20 text-brand-400 font-bold text-xs flex items-center justify-center font-mono">
            02
          </div>
          <h3 class="text-sm font-bold text-white">Automatic Density Matching</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            The engine automatically pairs each material with standard reference density values, with full support for manual density overrides.
          </p>
        </div>

        <div class="p-5 rounded-xl bg-surface-900/60 border border-white/[0.04] space-y-2">
          <div class="w-7 h-7 rounded-full bg-brand-500/20 text-brand-400 font-bold text-xs flex items-center justify-center font-mono">
            03
          </div>
          <h3 class="text-sm font-bold text-white">Instant Export &amp; Totals</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Inspect aggregate mass and volume totals instantly, and export results directly to CSV or JSON with a single click.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQs -->
    <section class="reveal-section space-y-6">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="badge badge-brand">Knowledge Base</span>
        <h2 class="text-2xl font-bold text-white">Frequently Asked Questions</h2>
      </div>
      <FAQAccordion faqs={batchFaqs} />
    </section>
  </div>
</BaseLayout>
