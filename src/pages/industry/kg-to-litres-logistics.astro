---
// src/pages/industry/kg-to-litres-logistics.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQAccordion from '../../components/interactive/FAQAccordion.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CustomDensitySolver from '../../components/interactive/CustomDensitySolver.astro';
import { useI18n } from '../../utils/i18n';

const { locale = 'en' } = Astro.params;
const { t } = useI18n(locale);

const containerData = [
  { type: 'Standard 20ft ISO Tank (T11)', capacityLitres: '24,000–26,000 L', maxGrossMass: '36,000 kg', maxPayloadMass: '31,500 kg', note: 'Standard bulk liquid intermodal container' },
  { type: 'Standard 20ft ISO Tank (Heavy)', capacityLitres: '14,000–17,500 L', maxGrossMass: '36,000 kg', maxPayloadMass: '32,000 kg', note: 'Dedicated for high-density acids (H₂SO₄, HNO₃)' },
  { type: 'Standard 1,000L IBC Tote', capacityLitres: '1,000 L', maxGrossMass: '1,500–2,000 kg', maxPayloadMass: '1,850 kg', note: 'Rigid composite intermediate bulk container' },
  { type: 'Standard 208L (55 US gal) Drum', capacityLitres: '208 L', maxGrossMass: '200–350 kg', maxPayloadMass: '320 kg', note: 'UN 1A1 / 1A2 steel drum packaging' },
  { type: 'European Road Tanker (Tri-Axle)', capacityLitres: '36,000–42,000 L', maxGrossMass: '44,000 kg (GVW)', maxPayloadMass: '29,000 kg', note: 'Multi-compartment petroleum & chemical road tanker' },
];

const faqs = [
  {
    q: 'What is the 80/95 ullage rule in liquid tank container logistics?',
    a: 'Under international dangerous goods regulations (ADR / IMDG / RID), portable tanks and ISO tank containers transporting liquids must never be filled below 80% capacity (to prevent dangerous liquid sloshing and vehicle rollover surges) and never above 95% capacity (to leave sufficient thermal expansion vapor space or ullage).'
  },
  {
    q: 'Why does a 24,000L ISO tank "weigh out" before it "cubes out" for dense chemicals?',
    a: 'A 24,000L tank carrying light gasoline (0.75 kg/L) contains 18,000 kg payload (cubed out by volume). However, filling that same 24,000L tank with concentrated sulfuric acid (1.84 kg/L) would generate 44,160 kg of payload—severely exceeding the 31,500 kg maximum permissible container rating and 44-tonne road transport axle limits. Heavy chemicals require smaller 14,000L tanks to prevent overloading.'
  },
  {
    q: 'How does air freight chargeable volumetric weight differ from liquid mass?',
    a: 'IATA air freight calculates volumetric weight as: Volume (m³) × 167 kg/m³ (or length × width × height in cm ÷ 6000). For liquids denser than 0.167 kg/L (virtually all commercial liquids), cargo is charged by actual physical gross mass (kg) on the cargo scale rather than dimensional cube.'
  },
  {
    q: 'How do customs declarations handle net mass vs billed volume?',
    a: 'Harmonized System (HS) customs tariffs and excise duty declarations require net mass in kilograms (excluding pallet and drum tare). Converting billed fuel volume at variable temperatures back to certified net mass requires applying ASTM Table 54B standards at 15°C.'
  }
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Kg to Litres in Logistics, Freight & Dangerous Goods Transport',
    description: 'Practical logistics guide on converting mass to volume for ISO tanks, IBC totes, ADR road transport, IMDG sea freight, and 80/95 ullage compliance.',
    author: {
      '@type': 'Organization',
      name: 'Kg to Litre Freight & Logistics Engineering Team',
      url: 'https://kgtoliter.com/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Kg to Litre',
      url: 'https://kgtoliter.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://kgtoliter.com/favicon.svg',
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': 'https://kgtoliter.com/industry/kg-to-litres-logistics/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<BaseLayout
  title="Kg to Litres for Logistics & Freight: ISO Tanks, ADR & Ullage"
  description="Master mass-to-volume freight calculations: ISO tank containers, 80/95 ullage rules, road tanker axle limits, ADR/IMDG dangerous goods & customs net mass."
  locale={locale}
  canonicalUrl="https://kgtoliter.com/industry/kg-to-litres-logistics/"
  schema={pageSchema}
>
  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-12">
    
    <!-- Breadcrumbs -->
    <BreadcrumbNav
      categoryName="B2B Industry Guides"
      categorySlug="industry"
      substanceName="Logistics & Freight Transport"
    />

    <!-- Hero Header (H1) -->
    <header class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 text-xs font-mono font-semibold rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 uppercase tracking-wider">
        <span>🚚 B2B Logistics Authority Guide</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
        Kg to Litres for <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-brand-400">Logistics &amp; Freight Transport</span>
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        Intermodal liquid freight operations bridge two conflicting constraints: <strong class="text-white">gross weight limits</strong> (axle weighbridges and container payload ratings in kg) vs <strong class="text-white">volumetric capacity</strong> (tank compartment litres and thermal ullage allowances).
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/industry/kg-to-litres-fuel-management/"
          class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-surface-900 text-slate-300 hover:text-white border border-white/10 transition-all"
        >
          Fuel Logistics Guide &rarr;
        </a>
        <a
          href="/physics/temperature-and-density/"
          class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-surface-900 text-slate-300 hover:text-white border border-white/10 transition-all"
        >
          Temperature &amp; Density Physics &rarr;
        </a>
      </div>
    </header>

    <!-- Interactive Solver -->
    <section class="space-y-4">
      <CustomDensitySolver />
    </section>

    <!-- Main Content -->
    <article class="space-y-12">
      
      <!-- Weighing Out vs Cubing Out -->
      <section class="glass-card bg-surface-950/80 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
          "Weighing Out" vs. "Cubing Out" in Liquid Bulk Transport
        </h2>
        <p class="text-slate-300 leading-relaxed">
          Every freight dispatcher must calculate whether a liquid consignment will fill the spatial volume of the container first (<em>cube out</em>) or exceed legal road and container payload weight limits first (<em>weigh out</em>):
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
          <div class="p-5 rounded-xl bg-surface-900/60 border border-amber-500/20 space-y-2">
            <h3 class="text-base font-bold text-amber-300">Light Liquids: "Cube Out" (&rho; &lt; 1.0 kg/L)</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              When shipping ethanol (0.789 kg/L), diesel (0.832 kg/L), or acetone (0.784 kg/L) in a 24,000L ISO tank, filling to 95% capacity (22,800L) produces a payload of only ~18,900 kg—well below the container's 31,500 kg maximum payload limit. Check out <a href="/fuels/kg-to-litres-diesel/" class="text-amber-300 underline">diesel volume to mass calculations</a>.
            </p>
          </div>

          <div class="p-5 rounded-xl bg-surface-900/60 border border-rose-500/20 space-y-2">
            <h3 class="text-base font-bold text-rose-300">Heavy Liquids: "Weigh Out" (&rho; &gt; 1.3 kg/L)</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              When shipping liquid caustic soda (1.525 kg/L) or concentrated sulfuric acid (1.836 kg/L), a 24,000L tank reaches maximum legal road weight (31,500 kg payload) at only <strong>17,150 Litres</strong> (71% volume), creating severe surge instability unless specialized baffles or smaller 17,500L heavy-acid tanks are used.
            </p>
          </div>
        </div>
      </section>

      <!-- ISO Tank & Container Matrix -->
      <section class="glass-card bg-surface-950/80 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-1">
            Standard Liquid Freight Packaging &amp; Payload Limits
          </h2>
          <p class="text-xs sm:text-sm text-slate-400">
            Capacity standards and tare specifications for intermodal chemical transport.
          </p>
        </div>

        <div class="overflow-x-auto rounded-xl border border-white/5">
          <table class="w-full text-left text-sm font-sans">
            <thead class="bg-surface-900 text-xs font-mono uppercase text-slate-400">
              <tr>
                <th class="py-3.5 px-4">Container Type</th>
                <th class="py-3.5 px-4 text-center font-mono">Volumetric Capacity</th>
                <th class="py-3.5 px-4 text-right font-mono">Max Gross Mass</th>
                <th class="py-3.5 px-4 text-right font-mono">Max Net Payload</th>
                <th class="py-3.5 px-4">Logistics Application</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5 text-slate-300 text-xs sm:text-sm">
              {containerData.map((cd) => (
                <tr class="hover:bg-white/[0.02]">
                  <td class="py-3.5 px-4 font-semibold text-white font-sans">{cd.type}</td>
                  <td class="py-3.5 px-4 text-center text-blue-400 font-mono">{cd.capacityLitres}</td>
                  <td class="py-3.5 px-4 text-right text-slate-400 font-mono">{cd.maxGrossMass}</td>
                  <td class="py-3.5 px-4 text-right text-emerald-400 font-bold font-mono">{cd.maxPayloadMass}</td>
                  <td class="py-3.5 px-4 text-slate-400 font-sans text-xs">{cd.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Dangerous Goods & Ullage Rules -->
      <section class="glass-card bg-surface-950/80 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-4">
        <h2 class="text-2xl font-bold text-white">ADR / IMDG Ullage Regulation (The 80/95 Rule)</h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          Liquid cargo in transit experiences dynamic inertial sloshing during vehicle braking and cornering. Dangerous Goods regulations (<strong class="text-white">ADR Section 4.2.1.9.6</strong> for European road transport and <strong class="text-white">IMDG Code</strong> for international maritime transport) mandate:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
          <div class="p-4 bg-surface-900 rounded-xl border border-white/5 space-y-1">
            <span class="text-amber-400 font-bold block uppercase">Minimum Fill Level: 80%</span>
            <p class="text-slate-300 font-sans">Tanks without transverse baffles must not be transported between 20% and 80% capacity to prevent catastrophic dynamic fluid hammer and rollover.</p>
          </div>
          <div class="p-4 bg-surface-900 rounded-xl border border-white/5 space-y-1">
            <span class="text-emerald-400 font-bold block uppercase">Maximum Fill Level: 95% (Ullage)</span>
            <p class="text-slate-300 font-sans">Tanks must leave at least 5% vapor headspace to accommodate thermal expansion as cargo heats up during tropical transit without hydrostatic shell rupture.</p>
          </div>
        </div>
      </section>

      <!-- FAQs -->
      <section class="space-y-6" id="faq">
        <div class="text-center space-y-2">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Frequently Asked Questions</h2>
          <p class="text-slate-400 text-sm">Transport, weighbridge, and customs mass-volume FAQs.</p>
        </div>
        <FAQAccordion faqs={faqs} />
      </section>

    </article>
  </main>
</BaseLayout>
