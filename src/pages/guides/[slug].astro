---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { substances } from '../../data/substances';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const relatedSubstances = substances.filter((s) => guide.data.related_tools.includes(s.id));
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.pubDate.toISOString(),
  mainEntityOfPage: `https://kgtolitre.com/guides/${guide.id}/`,
};
---

<Layout
  title={`${guide.data.title} | KgToLitre.com`}
  description={guide.data.description}
  article={true}
  schema={articleSchema}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="mb-10 pb-8 border-b border-slate-800">
      <a
        href="/"
        class="text-xs font-semibold text-brand-400 hover:text-brand-300 transition-colors inline-flex items-center gap-1 mb-6"
      >
        ← Back to Converter
      </a>
      <div class="flex items-center gap-3 text-xs font-mono text-slate-400 mb-3">
        <span
          class="px-2 py-0.5 rounded bg-brand-500/10 text-brand-400 border border-brand-500/20 capitalize font-sans"
          >{guide.data.category}</span
        >
        <span>•</span>
        <span
          >{
            new Date(guide.data.pubDate).toLocaleDateString('en-US', {
              month: 'long',
              day: 'numeric',
              year: 'numeric',
            })
          }</span
        >
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        {guide.data.title}
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        {guide.data.description}
      </p>
    </div>

    <!-- Article Content -->
    <div
      class="prose prose-invert prose-emerald max-w-none prose-headings:text-white prose-p:text-slate-300 prose-p:leading-relaxed prose-a:text-brand-400 hover:prose-a:text-brand-300 prose-code:text-brand-300 prose-pre:bg-slate-900 prose-pre:border prose-pre:border-slate-800 space-y-6"
    >
      <Content />
    </div>

    <!-- Related Converters / Semantic Internal Linking -->
    {
      relatedSubstances.length > 0 && (
        <div class="mt-12 p-6 rounded-2xl glass-card border border-slate-800">
          <h3 class="text-lg font-bold text-white mb-4">Related Substance Calculators</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {relatedSubstances.map((sub) => (
              <a
                href={`/${sub.category}/kg-to-litres-${sub.id}/`}
                class="p-4 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800/80 block transition-colors group"
              >
                <span class="text-xs font-mono text-slate-400 uppercase tracking-wider block">
                  {sub.category}
                </span>
                <span class="font-bold text-white group-hover:text-brand-400 transition-colors block mt-1">
                  {sub.name}
                </span>
                <span class="text-xs text-brand-400 font-mono block mt-1">
                  {sub.density_kg_per_l} kg/L
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    <!-- Converter CTA -->
    <div
      class="mt-12 p-8 rounded-2xl glass-card border border-brand-500/30 text-center space-y-4 glow-brand"
    >
      <h3 class="text-2xl font-bold text-white">Need to calculate liquid weight or volume?</h3>
      <p class="text-slate-300 text-sm max-w-xl mx-auto">
        Use our interactive real-time calculator with built-in substance densities.
      </p>
      <div>
        <a
          href="/"
          class="inline-block px-6 py-3 rounded-xl bg-brand-500 hover:bg-brand-400 text-slate-950 font-bold text-sm shadow-lg shadow-brand-500/20 transition-all"
        >
          Open Live Converter
        </a>
      </div>
    </div>
  </article>
</Layout>
