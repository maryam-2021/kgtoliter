---
// src/pages/blog/[...slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import ArticleSchema from '@components/schemas/ArticleSchema.astro';
import BreadcrumbSchema from '@components/schemas/BreadcrumbSchema.astro';
import { useI18n } from '@utils/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, locale: 'en' },
  }));
}

const { post, locale = 'en' } = Astro.props;
const { t } = useI18n(locale);
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | ${t('site.title')}`}
  description={post.data.description}
  ogImage={post.data.image}
  article={true}
  locale={locale}
>
  <main class="container mx-auto px-4 py-8 max-w-3xl">
    <div class="mb-6">
      <a
        href="/blog/"
        class="text-xs font-semibold text-brand-400 hover:text-brand-300 transition-colors inline-flex items-center gap-1"
      >
        ← {t('common.back') || 'Back'} to {t('nav.blog') || 'Blog'}
      </a>
    </div>

    <article class="prose prose-invert prose-lg max-w-none">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-4">{post.data.title}</h1>
      <div
        class="flex flex-wrap items-center gap-2 sm:gap-4 text-xs sm:text-sm text-slate-400 mb-6 not-prose border-b border-white/[0.08] pb-4"
      >
        <span class="font-medium text-slate-200">{post.data.author}</span>
        <span>•</span>
        <time datetime={post.data.date.toISOString()}
          >{new Date(post.data.date).toLocaleDateString()}</time
        >
        <span>•</span>
        <span
          class="px-2 py-0.5 rounded bg-brand-500/10 text-brand-400 border border-brand-500/20 capitalize font-sans"
          >{post.data.category}</span
        >
        {
          post.data.readingTime && (
            <>
              <span>•</span>
              <span>{post.data.readingTime} min read</span>
            </>
          )
        }
      </div>

      {
        post.data.image && (
          <img
            src={post.data.image}
            alt={post.data.title}
            class="w-full h-auto rounded-lg mb-8 border border-white/[0.08]"
            loading="lazy"
          />
        )
      }

      <div
        class="prose-headings:font-bold prose-headings:tracking-tight prose-a:text-brand-400 hover:prose-a:text-brand-300"
      >
        <Content />
      </div>
    </article>
  </main>

  <ArticleSchema post={post} />
  <BreadcrumbSchema
    items={[
      { name: t('nav.home'), url: useI18n(locale).getLocalizedPath('') },
      { name: t('nav.blog'), url: useI18n(locale).getLocalizedPath('blog') },
      { name: post.data.title, url: Astro.url.href },
    ]}
  />
</BaseLayout>
