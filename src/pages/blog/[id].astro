---
// src/pages/blog/[id].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { useI18n } from '@utils/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const locale = 'en';
const { t } = useI18n(locale);

const formattedDate = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(post.data.date);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: {
    '@type': 'Person',
    name: post.data.author,
  },
  mainEntityOfPage: `https://kgtoliter.com/blog/${post.id}/`,
};
---

<BaseLayout
  title={`${post.data.title} | ${t('site.title')}`}
  description={post.data.description}
  article={true}
  schema={articleSchema}
  locale={locale}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="mb-10 pb-8 border-b border-slate-800">
      <a
        href="/blog/"
        class="text-xs font-semibold text-brand-400 hover:text-brand-300 transition-colors inline-flex items-center gap-1 mb-6"
      >
        ← {t('common.back') || 'Back'} to {t('nav.blog') || 'Blog'}
      </a>

      <div class="flex items-center gap-3 text-xs font-mono text-slate-400 mb-3">
        <span class="px-2 py-0.5 rounded bg-brand-500/10 text-brand-400 border border-brand-500/20 capitalize font-sans">
          {post.data.category}
        </span>
        {post.data.readingTime && (
          <>
            <span>•</span>
            <span>{post.data.readingTime} min read</span>
          </>
        )}
        <span>•</span>
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        {post.data.title}
      </h1>

      <p class="text-base sm:text-lg text-slate-300 font-medium leading-relaxed">
        {post.data.description}
      </p>

      <div class="flex items-center gap-2 mt-4 text-xs text-slate-400">
        <span>By <strong class="text-slate-200">{post.data.author}</strong></span>
      </div>
    </div>

    {post.data.image && (
      <div class="mb-10 rounded-xl overflow-hidden border border-white/[0.08] bg-surface-950">
        <img
          src={post.data.image}
          alt={post.data.title}
          class="w-full h-auto object-cover max-h-[480px]"
        />
      </div>
    )}

    <div class="prose prose-invert prose-brand max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-brand-400 hover:prose-a:text-brand-300">
      <Content />
    </div>

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="mt-12 pt-6 border-t border-slate-800 flex flex-wrap items-center gap-2">
        <span class="text-xs text-slate-400 font-mono">Tags:</span>
        {post.data.tags.map((tag) => (
          <span class="px-2.5 py-1 text-xs rounded-md bg-surface-800 text-slate-300 border border-white/[0.06]">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </article>
</BaseLayout>
