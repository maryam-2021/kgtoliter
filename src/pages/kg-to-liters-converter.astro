---
// src/pages/kg-to-liters-converter.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorWidget from '../components/CalculatorWidget.astro';
import CustomDensitySolver from '../components/interactive/CustomDensitySolver.astro';
import HeroDensityVisualizer from '../components/interactive/HeroDensityVisualizer.astro';
import FAQAccordion from '../components/interactive/FAQAccordion.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import { useI18n } from '../utils/i18n';

const { locale = 'en' } = Astro.params;
const { t } = useI18n(locale);

const keySubstances = [
  { name: 'Pure Water', density: 1.000, category: 'basic', id: 'water', vol1Kg: '1.000 L', vol5Kg: '5.000 L', vol10Kg: '10.000 L', note: 'Standard at 20°C' },
  { name: 'Whole Milk (3.5% fat)', density: 1.030, category: 'basic', id: 'milk', vol1Kg: '0.971 L', vol5Kg: '4.854 L', vol10Kg: '9.709 L', note: 'Dairy standard' },
  { name: 'Extra Virgin Olive Oil', density: 0.910, category: 'cooking', id: 'olive-oil', vol1Kg: '1.099 L', vol5Kg: '5.495 L', vol10Kg: '10.989 L', note: 'Culinary oil' },
  { name: 'Sunflower Cooking Oil', density: 0.920, category: 'cooking', id: 'sunflower-oil', vol1Kg: '1.087 L', vol5Kg: '5.435 L', vol10Kg: '10.870 L', note: 'Frying oil' },
  { name: 'Automotive Diesel (EN 590)', density: 0.832, category: 'fuels', id: 'diesel', vol1Kg: '1.202 L', vol5Kg: '6.010 L', vol10Kg: '12.019 L', note: 'At 15°C baseline' },
  { name: 'Unleaded Gasoline / Petrol', density: 0.748, category: 'fuels', id: 'petrol', vol1Kg: '1.337 L', vol5Kg: '6.684 L', vol10Kg: '13.369 L', note: '95 RON motor fuel' },
  { name: 'Pure Natural Honey', density: 1.420, category: 'cooking', id: 'honey', vol1Kg: '0.704 L', vol5Kg: '3.521 L', vol10Kg: '7.042 L', note: '>80° Brix sweetener' },
  { name: 'Engine Oil (SAE 5W-30)', density: 0.855, category: 'automotive', id: 'engine-oil', vol1Kg: '1.170 L', vol5Kg: '5.848 L', vol10Kg: '11.696 L', note: 'Synthetic lubricant' },
  { name: 'Engine Antifreeze (50/50)', density: 1.065, category: 'automotive', id: 'coolant', vol1Kg: '0.939 L', vol5Kg: '4.695 L', vol10Kg: '9.390 L', note: 'Ethylene glycol' },
  { name: 'Pure Ethanol (100% Alcohol)', density: 0.789, category: 'industrial', id: 'ethanol', vol1Kg: '1.267 L', vol5Kg: '6.337 L', vol10Kg: '12.674 L', note: 'Anhydrous alcohol' },
  { name: 'Acetone (Technical Solvent)', density: 0.784, category: 'industrial', id: 'acetone', vol1Kg: '1.276 L', vol5Kg: '6.378 L', vol10Kg: '12.755 L', note: 'Volatile solvent' },
  { name: 'Sulfuric Acid (98% Reagent)', density: 1.836, category: 'industrial', id: 'sulfuric-acid', vol1Kg: '0.545 L', vol5Kg: '2.723 L', vol10Kg: '5.447 L', note: 'Heavy mineral acid' },
];

const conversionSteps = [1, 2, 3, 5, 10, 15, 20, 25, 50, 100, 250, 500, 1000];

const faqs = [
  {
    q: 'How do you convert kg to liters?',
    a: 'To convert kilograms (kg) to liters (L), divide the mass in kilograms by the density of the substance in kg/L. Formula: Volume (L) = Mass (kg) ÷ Density (kg/L). For example, 10 kg of diesel (density 0.832 kg/L) equals 10 ÷ 0.832 = 12.019 liters.'
  },
  {
    q: 'Is 1 kg always equal to 1 liter?',
    a: 'No. 1 kg equals exactly 1 liter only for pure water at 4°C to 20°C (density 1.000 kg/L). For lighter liquids like gasoline (0.748 kg/L) or olive oil (0.910 kg/L), 1 kg occupies more than 1 liter (1.34 L and 1.10 L respectively). For heavier liquids like honey (1.420 kg/L), 1 kg occupies only 0.704 liters.'
  },
  {
    q: 'What is the difference between liters and litres?',
    a: '"Liter" is the standard American English spelling (US), while "litre" is the official International System of Units (SI) and British / Commonwealth English spelling. Both refer to the identical metric unit of volume equal to 1 cubic decimeter (1 dm³ or 1,000 cm³).'
  },
  {
    q: 'How many liters is 5 kg of water, milk, and cooking oil?',
    a: '5 kg of water equals 5.000 liters. 5 kg of whole milk (1.030 kg/L) equals 4.854 liters. 5 kg of olive oil (0.910 kg/L) equals 5.495 liters.'
  },
  {
    q: 'How do you convert liters back to kg (reverse conversion)?',
    a: 'To convert liters to kilograms, multiply the volume in liters by the substance density: Mass (kg) = Volume (L) × Density (kg/L). For example, 20 liters of milk weighs 20 × 1.030 = 20.60 kg.'
  }
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'KG to Liters Converter',
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Any',
    url: 'https://kgtoliter.com/kg-to-liters-converter/',
    description: 'Free online kg to liters converter. Convert kilograms (kg) to liters (L) instantly across 772+ liquids, gases, and bulk materials with live formulas.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to Convert KG to Liters',
    step: [
      {
        '@type': 'HowToStep',
        name: 'Enter Mass in Kilograms',
        text: 'Input the weight or mass value in kilograms (kg) that you wish to convert.',
      },
      {
        '@type': 'HowToStep',
        name: 'Select Substance or Enter Density',
        text: 'Choose your substance from the dropdown (e.g. water, milk, diesel, oil) or input a custom density in kg/L.',
      },
      {
        '@type': 'HowToStep',
        name: 'Calculate Volume in Liters',
        text: 'The converter calculates volume using the formula Volume (L) = Mass (kg) ÷ Density (kg/L).',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<BaseLayout
  title="KG to Liters Converter | Fast Mass to Volume Calculator"
  description="Convert kilograms (kg) to liters (L) instantly. Free online converter for water, milk, cooking oil, diesel, petrol, and 772+ substances with step-by-step formulas."
  locale={locale}
  canonicalUrl="https://kgtoliter.com/kg-to-liters-converter/"
  schema={pageSchema}
>
  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-12">
    
    <!-- Breadcrumbs -->
    <BreadcrumbNav
      categoryName="Calculators & Converters"
      categorySlug="tools"
      substanceName="KG to Liters Converter"
    />

    <!-- Hero Header (H1) -->
    <header class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 text-xs font-mono font-semibold rounded-full bg-brand-500/10 text-brand-400 border border-brand-500/20 uppercase tracking-wider">
        <span>⚡ Instant Mass to Volume Tool</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
        KG to Liters Converter <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-emerald-400">(Mass to Volume Calculator)</span>
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        Convert kilograms (<strong class="text-white">kg</strong>) to liters (<strong class="text-white">L</strong>) instantly with high accuracy. Select from over <strong class="text-white">772+ verified substances</strong> or enter a custom density.
      </p>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/litre-to-kg/"
          class="px-4 py-2 rounded-xl bg-surface-900 border border-emerald-500/30 text-emerald-400 text-xs font-semibold hover:bg-emerald-500 hover:text-slate-950 transition-all shadow-sm"
        >
          🔄 Reverse: Liters to KG Converter &rarr;
        </a>
        <a
          href="/kg-to-litres-guide/"
          class="px-4 py-2 rounded-xl bg-surface-900 border border-brand-500/30 text-brand-400 text-xs font-semibold hover:bg-brand-500 hover:text-slate-950 transition-all shadow-sm"
        >
          📖 Complete Conversion Guide &rarr;
        </a>
      </div>
    </header>

    <!-- Core Interactive Calculator Widget -->
    <section class="space-y-4">
      <CalculatorWidget defaultMass={1} defaultSubstanceId="water" />
    </section>

    <!-- 3-Way Multi-Unit Solver -->
    <section class="space-y-4">
      <div class="text-center space-y-1">
        <h2 class="text-xl sm:text-2xl font-bold text-white">Custom Density &amp; 3-Way Solver</h2>
        <p class="text-xs sm:text-sm text-slate-400">Calculate Volume, Mass, or Density with temperature correction.</p>
      </div>
      <CustomDensitySolver />
    </section>

    <!-- Conversion Formula & How It Works -->
    <section class="glass-card bg-surface-950/80 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-6">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
        How the KG to Liters Converter Works
      </h2>
      <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
        Because kilograms measure gravitational mass and liters measure three-dimensional volume, the conversion requires the physical density of the substance:
      </p>

      <div class="p-6 rounded-xl bg-surface-900 border border-brand-500/30 text-center space-y-2">
        <div class="text-2xl sm:text-3xl font-mono font-black text-brand-400">
          Volume (Liters) = Mass (kg) &divide; Density (kg/L)
        </div>
        <p class="text-xs text-slate-400 font-mono">
          Or in algebraic form: <span class="text-white">V = m &divide; &rho;</span> (where V = liters, m = kg, &rho; = density in kg/L).
        </p>
      </div>

      <!-- 3 Step Guide -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-mono">
        <div class="p-4 rounded-xl bg-surface-900/60 border border-white/5 space-y-1.5">
          <span class="text-brand-400 font-bold uppercase block font-sans">Step 1: Input Mass</span>
          <p class="text-slate-300 font-sans">Enter the mass in kilograms (kg) you want to convert.</p>
        </div>
        <div class="p-4 rounded-xl bg-surface-900/60 border border-white/5 space-y-1.5">
          <span class="text-emerald-400 font-bold uppercase block font-sans">Step 2: Apply Density</span>
          <p class="text-slate-300 font-sans">Find the substance density in kg/L (e.g. Water = 1.000, Diesel = 0.832).</p>
        </div>
        <div class="p-4 rounded-xl bg-surface-900/60 border border-white/5 space-y-1.5">
          <span class="text-purple-400 font-bold uppercase block font-sans">Step 3: Get Liters</span>
          <p class="text-slate-300 font-sans">Divide mass by density to get the exact volume in liters.</p>
        </div>
      </div>
    </section>

    <!-- Master Quick Lookup Table -->
    <section class="glass-card bg-surface-950/90 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-1">
            KG to Liters Conversion Table (Top Substances)
          </h2>
          <p class="text-xs sm:text-sm text-slate-400">
            Calculated volume in liters for 1 kg, 5 kg, and 10 kg at standard reference temperatures.
          </p>
        </div>
        <a href="/density-reference/" class="text-xs font-semibold text-brand-400 hover:underline">
          View 772+ substances &rarr;
        </a>
      </div>

      <div class="overflow-x-auto rounded-xl border border-white/5">
        <table class="w-full text-left text-sm font-sans">
          <thead class="bg-surface-900 text-xs font-mono uppercase text-slate-400">
            <tr>
              <th class="py-3.5 px-4">Substance Name</th>
              <th class="py-3.5 px-4 text-center font-mono">Density @ 20°C</th>
              <th class="py-3.5 px-4 text-right font-mono">1 kg in Liters</th>
              <th class="py-3.5 px-4 text-right font-mono">5 kg in Liters</th>
              <th class="py-3.5 px-4 text-right font-mono">10 kg in Liters</th>
              <th class="py-3.5 px-4 text-center">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-slate-300 font-mono text-xs sm:text-sm">
            {keySubstances.map((item) => (
              <tr class="hover:bg-white/[0.02]">
                <td class="py-3 px-4 font-semibold text-white font-sans">
                  {item.name}
                  <span class="text-[11px] text-slate-500 block font-normal">{item.note}</span>
                </td>
                <td class="py-3 px-4 text-center text-slate-400">{item.density.toFixed(3)} kg/L</td>
                <td class="py-3 px-4 text-right text-brand-400 font-bold">{item.vol1Kg}</td>
                <td class="py-3 px-4 text-right text-emerald-400 font-bold">{item.vol5Kg}</td>
                <td class="py-3 px-4 text-right text-purple-400 font-bold">{item.vol10Kg}</td>
                <td class="py-3 px-4 text-center font-sans">
                  <a
                    href={`/${item.category}/kg-to-litres-${item.id}/`}
                    class="px-2.5 py-1 rounded bg-brand-500/10 text-brand-400 hover:bg-brand-500 hover:text-slate-950 font-semibold text-xs border border-brand-500/20 transition-all inline-block"
                  >
                    Convert &rarr;
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Quick Quantity Matrix (1 kg to 1,000 kg) -->
    <section class="glass-card bg-surface-950/80 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-4">
      <h2 class="text-xl sm:text-2xl font-bold text-white">Common KG to Liters Quantity Lookups</h2>
      <p class="text-xs sm:text-sm text-slate-400">Click any standard quantity to view dedicated conversion breakdowns:</p>
      
      <div class="flex flex-wrap gap-2 pt-2">
        {conversionSteps.map((qty) => (
          <a
            href={`/convert/${qty}-kg-to-litres/`}
            class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/5 text-slate-300 hover:text-white hover:bg-surface-800 hover:border-brand-500/30 text-xs font-mono transition-all"
          >
            {qty} kg to liters &rarr;
          </a>
        ))}
      </div>
    </section>

    <!-- Interactive Visualizer -->
    <section class="space-y-4">
      <h2 class="text-xl sm:text-2xl font-bold text-white">Visual Density Comparison</h2>
      <HeroDensityVisualizer />
    </section>

    <!-- FAQs -->
    <section class="space-y-6" id="faq">
      <div class="text-center space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Frequently Asked Questions</h2>
        <p class="text-slate-400 text-sm">Everything you need to know about kg to liters conversion.</p>
      </div>
      <FAQAccordion faqs={faqs} />
    </section>

  </main>
</BaseLayout>
