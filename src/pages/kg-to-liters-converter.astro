---
// src/pages/kg-to-liters-converter.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorWidget from '../components/CalculatorWidget.astro';
import CustomDensitySolver from '../components/interactive/CustomDensitySolver.astro';
import HeroDensityVisualizer from '../components/interactive/HeroDensityVisualizer.astro';
import FAQAccordion from '../components/interactive/FAQAccordion.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import { useI18n } from '../utils/i18n';

const { locale = 'en' } = Astro.params;
const { t } = useI18n(locale);

// 1 to 20 kg Comparison Matrix across the 5 benchmark liquids (like Inch Calculator, with high-precision physics)
const oneToTwentyMatrix = Array.from({ length: 20 }, (_, i) => {
  const kg = i + 1;
  return {
    kg,
    water: (kg / 1.000).toFixed(3),
    milk: (kg / 1.030).toFixed(3),
    oil: (kg / 0.910).toFixed(3),
    gasoline: (kg / 0.748).toFixed(3),
    diesel: (kg / 0.832).toFixed(3),
  };
});

const keySubstances = [
  { name: 'Pure Water', density: 1.000, category: 'basic', id: 'water', vol1Kg: '1.000 L', vol5Kg: '5.000 L', vol10Kg: '10.000 L', note: 'Standard at 20°C (1 kg = 1 L)' },
  { name: 'Whole Milk (3.5% fat)', density: 1.030, category: 'basic', id: 'milk', vol1Kg: '0.971 L', vol5Kg: '4.854 L', vol10Kg: '9.709 L', note: 'Dairy standard' },
  { name: 'Extra Virgin Olive Oil', density: 0.910, category: 'cooking', id: 'olive-oil', vol1Kg: '1.099 L', vol5Kg: '5.495 L', vol10Kg: '10.989 L', note: 'Culinary oil' },
  { name: 'Sunflower Cooking Oil', density: 0.920, category: 'cooking', id: 'sunflower-oil', vol1Kg: '1.087 L', vol5Kg: '5.435 L', vol10Kg: '10.870 L', note: 'Frying oil' },
  { name: 'Automotive Diesel (EN 590)', density: 0.832, category: 'fuels', id: 'diesel', vol1Kg: '1.202 L', vol5Kg: '6.010 L', vol10Kg: '12.019 L', note: 'At 15°C baseline' },
  { name: 'Unleaded Gasoline / Petrol', density: 0.748, category: 'fuels', id: 'petrol', vol1Kg: '1.337 L', vol5Kg: '6.684 L', vol10Kg: '13.369 L', note: '95 RON motor fuel' },
  { name: 'Pure Natural Honey', density: 1.420, category: 'cooking', id: 'honey', vol1Kg: '0.704 L', vol5Kg: '3.521 L', vol10Kg: '7.042 L', note: '>80° Brix sweetener' },
  { name: 'Engine Oil (SAE 5W-30)', density: 0.855, category: 'automotive', id: 'engine-oil', vol1Kg: '1.170 L', vol5Kg: '5.848 L', vol10Kg: '11.696 L', note: 'Synthetic lubricant' },
  { name: 'Engine Antifreeze (50/50)', density: 1.065, category: 'automotive', id: 'coolant', vol1Kg: '0.939 L', vol5Kg: '4.695 L', vol10Kg: '9.390 L', note: 'Ethylene glycol' },
  { name: 'Pure Ethanol (100% Alcohol)', density: 0.789, category: 'industrial', id: 'ethanol', vol1Kg: '1.267 L', vol5Kg: '6.337 L', vol10Kg: '12.674 L', note: 'Anhydrous alcohol' },
  { name: 'Acetone (Technical Solvent)', density: 0.784, category: 'industrial', id: 'acetone', vol1Kg: '1.276 L', vol5Kg: '6.378 L', vol10Kg: '12.755 L', note: 'Volatile solvent' },
  { name: 'Sulfuric Acid (98% Reagent)', density: 1.836, category: 'industrial', id: 'sulfuric-acid', vol1Kg: '0.545 L', vol5Kg: '2.723 L', vol10Kg: '5.447 L', note: 'Heavy mineral acid' },
];

const crossUnitConversions = [
  { name: 'Kg to Millilitres (mL)', desc: '1 kg water = 1,000 mL', href: '/physics/density-units-conversion/' },
  { name: 'Kg to Gallons (US / UK)', desc: '1 kg water = 0.264 US gal / 0.220 UK gal', href: '/tools/' },
  { name: 'Kg to Fluid Ounces (fl oz)', desc: '1 kg water = 33.814 fl oz', href: '/tools/' },
  { name: 'Kg to Cups & Tablespoons', desc: 'Culinary volumetric conversion', href: '/industry/kg-to-litres-cooking/' },
  { name: 'Kg to Grams (g) & Pounds (lb)', desc: 'Mass to mass unit scaling', href: '/physics/density-units-conversion/' },
  { name: 'Liters to Kg (Reverse)', desc: 'Calculate weight from liquid volume', href: '/litre-to-kg/' },
];

const faqs = [
  {
    q: 'How do you convert kg to liters?',
    a: 'To convert kilograms (kg) to liters (L), divide the mass in kilograms by the density of the substance in kg/L. Formula: Volume (L) = Mass (kg) ÷ Density (kg/L). For example, 5 kg of diesel (density 0.832 kg/L) equals 5 ÷ 0.832 = 6.010 liters.'
  },
  {
    q: 'Is 1 kg always equal to 1 liter?',
    a: 'No. 1 kg equals exactly 1 liter only for pure water at 4°C to 20°C because water has a density of 1.000 kg/L. For lighter liquids like gasoline (0.748 kg/L) or olive oil (0.910 kg/L), 1 kg occupies more than 1 liter (1.34 L and 1.10 L respectively). For heavier liquids like honey (1.420 kg/L), 1 kg occupies only 0.704 liters.'
  },
  {
    q: 'What is the difference between liters and litres?',
    a: '"Liter" is the standard American English spelling (US), while "litre" is the official International System of Units (SI) and British / Commonwealth English spelling. Both refer to the identical metric unit of volume equal to 1 cubic decimeter (1 dm³ or 1,000 cm³).'
  },
  {
    q: 'How many liters is 5 kg of water, milk, and cooking oil?',
    a: '5 kg of water equals 5.000 liters. 5 kg of whole milk (1.030 kg/L) equals 4.854 liters. 5 kg of olive oil (0.910 kg/L) equals 5.495 liters.'
  },
  {
    q: 'How do you convert liters back to kg (reverse conversion)?',
    a: 'To convert liters to kilograms, multiply the volume in liters by the substance density: Mass (kg) = Volume (L) × Density (kg/L). For example, 20 liters of milk weighs 20 × 1.030 = 20.60 kg.'
  },
  {
    q: 'Why does temperature change the kg to liters calculation?',
    a: 'Thermal expansion causes liquids to expand as they warm up. While the mass in kilograms remains unchanged, the molecules spread out, increasing the volume in liters and lowering physical density. Petroleum fuels expand ~0.85% per 10°C, which is why fuel billing is standardized to 15°C.'
  }
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'kg to Liters Converter - Free Online kg to L Calculator',
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Any',
    url: 'https://kgtoliter.com/kg-to-liters-converter/',
    description: 'Free online kg to liters converter. Convert kilograms (kg) to liters (L) instantly across 772+ liquids, gases, and bulk materials with live formulas.',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'kg to Liters Converter: Free Online kg to L Calculator & Conversion Guide',
    description: 'Convert kilograms to liters for water, milk, cooking oil, fuels, and chemicals. Learn the exact density formula, worked examples, 1-20 kg conversion table, and physics definitions.',
    author: {
      '@type': 'Organization',
      name: 'Kg to Litre Metrology & Engineering Review Board',
      url: 'https://kgtoliter.com/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Kg to Litre',
      url: 'https://kgtoliter.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://kgtoliter.com/favicon.svg',
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': 'https://kgtoliter.com/kg-to-liters-converter/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to Convert kg to Liters',
    step: [
      {
        '@type': 'HowToStep',
        name: 'Enter Mass in Kilograms',
        text: 'Input the weight or mass value in kilograms (kg) that you wish to convert.',
      },
      {
        '@type': 'HowToStep',
        name: 'Select Substance or Enter Density',
        text: 'Choose your substance from the dropdown (e.g. water, milk, diesel, oil) or input a custom density in kg/L.',
      },
      {
        '@type': 'HowToStep',
        name: 'Calculate Volume in Liters',
        text: 'The converter calculates volume using the formula Volume (L) = Mass (kg) ÷ Density (kg/L).',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<BaseLayout
  title="kg to liters Converter - Free Online kg to L Calculator"
  description="Convert kg to liters instantly with our free calculator. 772+ substances. Two-way conversion kg to L and L to kg for water, oil, milk, diesel, gasoline."
  locale={locale}
  canonicalUrl="https://kgtoliter.com/kg-to-liters-converter/"
  schema={pageSchema}
>
  <main class="container mx-auto px-4 py-8 max-w-5xl space-y-12">
    
    <!-- Breadcrumbs -->
    <BreadcrumbNav
      categoryName="Calculators & Converters"
      categorySlug="tools"
      substanceName="KG to Liters Converter"
    />

    <!-- Hero Header (H1) -->
    <header class="text-center space-y-4 max-w-3xl mx-auto" id="idx_page_heading">
      <div class="inline-flex items-center gap-2 px-3 py-1 text-xs font-mono font-semibold rounded-full bg-brand-500/10 text-brand-400 border border-brand-500/20 uppercase tracking-wider">
        <span>⚡ Instant Mass to Volume Calculator</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
        kg to Liters Converter <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 to-emerald-400">(Free Online kg to L Calculator)</span>
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        Use our free <strong class="text-white">kg to liters converter</strong> to calculate the exact volume in liters (<strong class="text-white">L</strong>) from weight in kilograms (<strong class="text-white">kg</strong>). Enter your mass below and select from <strong class="text-white">772+ verified substances</strong> or enter a custom density.
      </p>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/litre-to-kg/"
          class="px-4 py-2 rounded-xl bg-surface-900 border border-emerald-500/30 text-emerald-400 text-xs font-semibold hover:bg-emerald-500 hover:text-slate-950 transition-all shadow-sm"
        >
          🔄 Reverse: Liters to KG Converter &rarr;
        </a>
        <a
          href="/what-is-density/"
          class="px-4 py-2 rounded-xl bg-surface-900 border border-purple-500/30 text-purple-400 text-xs font-semibold hover:bg-purple-500 hover:text-slate-950 transition-all shadow-sm"
        >
          ⚛️ What Is Density? (Physics) &rarr;
        </a>
        <a
          href="/density-reference/"
          class="px-4 py-2 rounded-xl bg-surface-900 border border-brand-500/30 text-brand-400 text-xs font-semibold hover:bg-brand-500 hover:text-slate-950 transition-all shadow-sm"
        >
          📖 772+ Substance Database &rarr;
        </a>
      </div>
    </header>

    <!-- Table of Contents Anchor Box -->
    <nav class="glass-card bg-surface-950/80 border border-white/[0.08] rounded-2xl p-5 text-xs text-slate-300">
      <span class="font-bold text-white uppercase tracking-wider font-mono block mb-2">On this page:</span>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 font-mono">
        <a href="#how-to-convert" class="hover:text-brand-400 hover:underline">1. How to Convert &rarr;</a>
        <a href="#formula" class="hover:text-brand-400 hover:underline">2. Conversion Formula &rarr;</a>
        <a href="#conversion-table" class="hover:text-brand-400 hover:underline">3. 1–20 kg Table &rarr;</a>
        <a href="#when-to-convert" class="hover:text-brand-400 hover:underline">4. Applications &rarr;</a>
        <a href="#what-is-a-kilogram" class="hover:text-brand-400 hover:underline">5. What Is a Kg? &rarr;</a>
        <a href="#what-is-a-liter" class="hover:text-brand-400 hover:underline">6. What Is a Liter? &rarr;</a>
        <a href="#faq" class="hover:text-brand-400 hover:underline">7. FAQ &rarr;</a>
        <a href="#references" class="hover:text-brand-400 hover:underline">8. References &rarr;</a>
      </div>
    </nav>

    <!-- Core Interactive Calculator Widget -->
    <section class="space-y-4" id="calculator-root">
      <CalculatorWidget defaultMass={1} defaultSubstanceId="water" />
    </section>

    <!-- 3-Way Multi-Unit Solver -->
    <section class="space-y-4">
      <div class="text-center space-y-1">
        <h2 class="text-xl sm:text-2xl font-bold text-white">Custom Density &amp; 3-Way Multi-Unit Solver</h2>
        <p class="text-xs sm:text-sm text-slate-400">Calculate Volume, Mass, or Density with temperature correction.</p>
      </div>
      <CustomDensitySolver />
    </section>

    <!-- How to Convert Kilograms to Liters -->
    <section class="glass-card bg-surface-950/80 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-4" id="how-to-convert">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
        How to Convert Kilograms to Liters
      </h2>
      <p class="text-slate-300 leading-relaxed">
        Since <strong class="text-white">kilograms</strong> are a unit of mass and <strong class="text-white">liters</strong> are a unit of volume, they measure completely different physical dimensions. To convert between mass and volume, we must account for the <strong class="text-white">density (&rho;)</strong> of the substance.
      </p>
      <p class="text-slate-300 leading-relaxed text-sm">
        Density represents the amount of mass packed into a given unit of spatial volume. Therefore, to convert kilograms to liters of any liquid, powder, or solid material, you must <strong>divide the mass in kilograms by its density in kg/L</strong>.
      </p>
    </section>

    <!-- Kilograms to Liters Formula -->
    <section class="glass-card bg-surface-950/80 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-6" id="formula">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
        Kilograms to Liters Formula
      </h2>
      <p class="text-slate-300 leading-relaxed text-sm sm:text-base">
        To convert a measurement in kilograms to liters, divide the weight by the density of the ingredient or material in kilograms per liter (kg/L):
      </p>

      <div class="p-6 rounded-xl bg-surface-900 border border-brand-500/30 text-center space-y-2">
        <div class="text-2xl sm:text-3xl font-mono font-black text-brand-400">
          Liters = Kilograms &divide; Density (kg/L)
        </div>
        <p class="text-xs text-slate-400 font-mono">
          SI Algebraic Notation: <span class="text-white">V = m &divide; &rho;</span> (where V = volume in L, m = mass in kg, &rho; = density in kg/L).
        </p>
      </div>

      <!-- Worked Examples -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono">
        <div class="p-5 rounded-xl bg-surface-900/60 border border-emerald-500/20 space-y-2">
          <span class="text-emerald-400 font-bold uppercase block font-sans text-sm">Worked Example 1: 5 kg at Density 0.700 kg/L</span>
          <p class="text-slate-300 font-sans text-xs">
            Liters = 5 kg &divide; 0.700 kg/L = <strong class="text-emerald-400 font-mono">7.1429 Liters</strong>.
          </p>
        </div>
        <div class="p-5 rounded-xl bg-surface-900/60 border border-amber-500/20 space-y-2">
          <span class="text-amber-400 font-bold uppercase block font-sans text-sm">Worked Example 2: 10 kg Diesel (0.832 kg/L)</span>
          <p class="text-slate-300 font-sans text-xs">
            Liters = 10 kg &divide; 0.832 kg/L = <strong class="text-amber-400 font-mono">12.0192 Liters</strong>.
          </p>
        </div>
      </div>
    </section>

    <!-- 1 to 20 kg Conversion Matrix Table (Matching & Beating Competitor) -->
    <section class="glass-card bg-surface-950/90 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-6" id="conversion-table">
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-1">
          Kilogram to Liter Conversion Table (1 kg to 20 kg)
        </h2>
        <p class="text-xs sm:text-sm text-slate-400">
          Side-by-side volume comparisons in liters across 5 benchmark liquids: Water, Milk, Cooking Oil, Gasoline, and Diesel.
        </p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-white/5">
        <table class="w-full text-left text-sm font-sans">
          <thead class="bg-surface-900 text-xs font-mono uppercase text-slate-400">
            <tr>
              <th class="py-3.5 px-4">Weight (kg)</th>
              <th class="py-3.5 px-4 font-mono text-sky-400">Water (1.000 kg/L)</th>
              <th class="py-3.5 px-4 font-mono text-purple-400">Milk (1.030 kg/L)</th>
              <th class="py-3.5 px-4 font-mono text-amber-400">Cooking Oil (0.910 kg/L)</th>
              <th class="py-3.5 px-4 font-mono text-rose-400">Gasoline (0.748 kg/L)</th>
              <th class="py-3.5 px-4 font-mono text-emerald-400">Diesel (0.832 kg/L)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-slate-300 font-mono text-xs sm:text-sm">
            {oneToTwentyMatrix.map((row) => (
              <tr class="hover:bg-white/[0.02]">
                <td class="py-2.5 px-4 font-bold text-white font-mono">{row.kg} kg</td>
                <td class="py-2.5 px-4 text-sky-300 font-bold">{row.water} L</td>
                <td class="py-2.5 px-4 text-purple-300">{row.milk} L</td>
                <td class="py-2.5 px-4 text-amber-300">{row.oil} L</td>
                <td class="py-2.5 px-4 text-rose-300">{row.gasoline} L</td>
                <td class="py-2.5 px-4 text-emerald-300">{row.diesel} L</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- When to Convert Kilograms to Liters -->
    <section class="glass-card bg-surface-950/80 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-6" id="when-to-convert">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
        When to Convert Kilograms to Liters
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
        <div class="p-5 rounded-xl bg-surface-900/60 border border-purple-500/20 space-y-2">
          <h3 class="text-base font-bold text-purple-300">1. Cooking &amp; Professional Baking</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Professional chefs recommend measuring ingredients by weight (kg) rather than volume (liters or cups) to eliminate aeration, compaction, and humidity errors. When converting recipe volumes to digital scale masses, density is required (e.g. NIST Culinary Measurement Guidelines).
          </p>
          <a href="/industry/kg-to-litres-cooking/" class="text-[11px] text-purple-400 font-mono hover:underline block pt-1">
            Chef's Cooking Guide &rarr;
          </a>
        </div>

        <div class="p-5 rounded-xl bg-surface-900/60 border border-cyan-500/20 space-y-2">
          <h3 class="text-base font-bold text-cyan-300">2. Chemical Stoichiometry</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Chemical synthesis requires combining precise molar ratios of reactants. Converting powdered solids (weighed in kg) with liquid reagents (metered in liters) ensures stoichiometric balance and prevents runaway exothermic reactions.
          </p>
          <a href="/industrial/kg-to-litres-solvents/" class="text-[11px] text-cyan-400 font-mono hover:underline block pt-1">
            Industrial Solvents Guide &rarr;
          </a>
        </div>

        <div class="p-5 rounded-xl bg-surface-900/60 border border-emerald-500/20 space-y-2">
          <h3 class="text-base font-bold text-emerald-300">3. Freight &amp; Logistics Transport</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Cargo transport vehicles (trucks, ships, cargo planes) face dual constraints: maximum gross axle weight (kg) and spatial cargo volume (liters / $m^3$). Converting liquid cargo mass ensures vehicles do not exceed legal weighbridge limits while maintaining required ullage headspace.
          </p>
          <a href="/industry/kg-to-litres-logistics/" class="text-[11px] text-emerald-400 font-mono hover:underline block pt-1">
            Logistics &amp; Freight Guide &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- What Is a Kilogram? & What Is a Liter? (Formal Physics Definitions) -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6" id="definitions">
      
      <!-- What Is a Kilogram -->
      <div class="glass-card bg-surface-950/80 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-4" id="what-is-a-kilogram">
        <h2 class="text-xl sm:text-2xl font-bold text-white">What Is a Kilogram?</h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          One kilogram (<strong class="text-white">kg</strong>) equals 1,000 grams, 2.204623 pounds, or 1/1,000 of a metric tonne.
        </p>
        <p class="text-xs text-slate-400 leading-relaxed">
          Under the 2019 International System of Units (SI) revision by the BIPM, the kilogram is defined by fixing the numerical value of the <strong>Planck constant (h = 6.62607015 &times; 10⁻³⁴ J&sdot;s)</strong>. While mass is an intrinsic measure of matter, weight is gravitational force (W = m &sdot; g). An object with a mass of 1 kg exerts approximately 9.80665 Newtons of downward force on Earth.
        </p>
      </div>

      <!-- What Is a Liter -->
      <div class="glass-card bg-surface-950/80 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-4" id="what-is-a-liter">
        <h2 class="text-xl sm:text-2xl font-bold text-white">What Is a Liter?</h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
          A liter (<strong class="text-white">L</strong>, or British spelling <em>litre</em>) is a metric unit of volume equal to <strong>1 cubic decimeter (1 dm³)</strong>, 1,000 cubic centimeters (1,000 cm³), or 0.264172 US liquid gallons.
        </p>
        <p class="text-xs text-slate-400 leading-relaxed">
          The liter is an SI-accepted non-SI unit for volume. Originally defined in 1795 as the volume of 1 kilogram of pure water at melting ice temperature, it is now mathematically tied directly to the cubic meter (1 L = 0.001 m³).
        </p>
      </div>

    </section>

    <!-- Cross-Unit Conversions Hub -->
    <section class="glass-card bg-surface-950/80 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-4" id="cross-unit-conversions">
      <h2 class="text-xl sm:text-2xl font-bold text-white">More Kilogram &amp; Liter Unit Conversions</h2>
      <p class="text-xs sm:text-sm text-slate-400">Explore conversions between kilograms, volume units, and imperial standards:</p>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 pt-2">
        {crossUnitConversions.map((item) => (
          <a
            href={item.href}
            class="p-3.5 rounded-xl bg-surface-900/70 border border-white/5 hover:border-brand-500/30 transition-all block space-y-1"
          >
            <span class="text-xs font-bold text-white block">{item.name} &rarr;</span>
            <span class="text-[11px] text-slate-400 block">{item.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQs -->
    <section class="space-y-6" id="faq">
