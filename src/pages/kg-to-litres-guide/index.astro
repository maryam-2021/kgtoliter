  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const massInput = document.getElementById('calcMass');
      const densityInput = document.getElementById('calcDensity');
      const resultDisplay = document.getElementById('calcResult');
      
      function updateCalculator() {
        if (!massInput || !densityInput || !resultDisplay) return;
        const mass = parseFloat(massInput.value) || 0;
        const density = parseFloat(densityInput.value) || 1;
        const volume = density > 0 ? (mass / density) : 0;
        resultDisplay.textContent = volume.toFixed(3) + ' L';
      }
      
      if (massInput && densityInput) {
        massInput.addEventListener('input', updateCalculator);
        densityInput.addEventListener('input', updateCalculator);
        updateCalculator();
      }
    });
  </script>
