---
// src/pages/kg-to-litres-guide/index.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import FAQAccordion from '@components/interactive/FAQAccordion.astro';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides');

const guideFaqs = [
  {
    q: 'How much is kg to litres?',
    a: 'The conversion depends on density. For water: 1 kg = 1 L. For honey: 1 kg = 0.704 L.',
  },
  {
    q: 'How to convert kg to liters?',
    a: 'Use the formula: Volume (L) = Mass (kg) ÷ Density (kg/L).',
  },
  {
    q: 'How to calculate kg to liter?',
    a: 'Divide the mass in kg by the density in kg/L. Example: 5 kg ÷ 0.910 kg/L = 5.495 L.',
  },
  {
    q: 'Is 1kg = 1 litre?',
    a: 'Only for water. 1 kg water = 1 L. For other substances, 1 kg ≠ 1 L.',
  },
  {
    q: 'How much is 1 kg to 1 liter?',
    a: 'For water: 1 kg = 1 L. For milk: 1 kg = 0.971 L. For honey: 1 kg = 0.704 L.',
  },
  {
    q: 'Are kg and litres the same?',
    a: 'No. kg measures mass, litres measure volume. They are different physical properties.',
  },
  {
    q: 'Is kg equal to litre?',
    a: 'No, kg and litre are not equal. Only for water at 20°C do they have the same numerical value.',
  },
  {
    q: 'What is kg to litres?',
    a: "Kg to litres is the conversion of mass in kilograms to volume in litres using the substance's density.",
  },
  {
    q: 'Can you convert kg to liters?',
    a: 'Yes, using the formula: Volume (L) = Mass (kg) ÷ Density (kg/L).',
  },
  {
    q: 'Are kg and liters the same?',
    a: 'No. kg measures mass, liters measure volume. They are different units.',
  },
  {
    q: 'How many kgs is 1 liter?',
    a: 'For water: 1 L = 1 kg. For honey: 1 L = 1.42 kg. For gasoline: 1 L = 0.748 kg.',
  },
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Kg to Litres Complete Conversion Guide: Formula, Physics, & Tables',
    description: 'The definitive guide to converting kilograms to litres across liquids, fuels, cooking ingredients, and industrial chemicals.',
    author: {
      '@type': 'Organization',
      name: 'Kg to Litre Engineering Team',
      url: 'https://kgtoliter.com/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Kg to Litre',
      url: 'https://kgtoliter.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://kgtoliter.com/favicon.svg',
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': 'https://kgtoliter.com/kg-to-litres-guide/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guideFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<BaseLayout 
  title="Kg to Litres Complete Conversion Guide & Engineering Reference"
  description="Master kg to litres conversion: step-by-step formulas, density lookup tables, gallon/barrel/ml charts, and FAQ answers for 772+ substances."
  canonicalUrl="https://kgtoliter.com/kg-to-litres-guide/"
  schema={pageSchema}
>
  <div class="container mx-auto px-4 py-12 max-w-4xl space-y-12">
    <!-- Header -->
    <header class="text-center space-y-4">
      <span class="px-3 py-1 text-xs font-mono font-semibold rounded-full bg-brand-500/10 text-brand-400 border border-brand-500/20 uppercase tracking-wider inline-block">
        Comprehensive Technical Guide
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white section-title">
        Kg to Litres Conversion Guide
      </h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        Everything you need to convert mass (kg) to volume (litres, gallons, barrels, ml) with exact density formulas and industry standards.
      </p>

      <!-- Quick Nav Anchor Pills -->
      <nav aria-label="Guide quick links" class="flex flex-wrap justify-center gap-2 pt-4">
        <a href="#how-to-convert-kg-to-liters" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">How to Convert</a>
        <a href="#how-to-calculate-kg-to-liter" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">How to Calculate</a>
        <a href="#is-1kg-equal-1-litre" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Is 1kg = 1 Litre?</a>
        <a href="#how-much-1-kg-to-1-liter" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">1 kg to 1 Liter</a>
        <a href="#are-kg-and-litres-same" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Are kg &amp; L Same?</a>
        <a href="#what-is-kg-to-litres" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">What is kg to L?</a>
        <a href="#can-you-convert-kg-to-liters" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Can You Convert?</a>
        <a href="#are-kg-and-liters-same" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Are kg &amp; Liters Same?</a>
        <a href="#how-many-kgs-is-1-liter" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">How Many kgs is 1 L?</a>
        <a href="#litre-to-barrel-gallon" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Barrels &amp; Gallons</a>
        <a href="#litre-of-petrol-diesel" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Petrol &amp; Diesel</a>
        <a href="#kg-litre-water" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Water Guide</a>
        <a href="#general-kg-to-l" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Reference Table</a>
        <a href="#faq" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">FAQ</a>
      </nav>
    </header>

    <!-- Keyword 2: How to Convert kg to Liters -->
    <section class="content-block scroll-mt-24" id="how-to-convert-kg-to-liters">
      <h2 class="text-2xl font-bold text-white">How to Convert kg to Liters</h2>
      
      <div class="step-by-step">
        <div class="step">
          <span class="step-number">1</span>
          <div class="step-content">
            <h4>Identify the Substance</h4>
            <p>Determine what substance you're converting (water, milk, oil, etc.)</p>
          </div>
        </div>
        <div class="step">
          <span class="step-number">2</span>
          <div class="step-content">
            <h4>Find Its Density</h4>
            <p>Look up the density in kg/L from our <a href="/#density-directory">density directory</a></p>
          </div>
        </div>
        <div class="step">
          <span class="step-number">3</span>
          <div class="step-content">
            <h4>Apply the Formula</h4>
            <div class="formula-box">
              Volume (L) = Mass (kg) ÷ Density (kg/L)
            </div>
          </div>
        </div>
        <div class="step">
          <span class="step-number">4</span>
          <div class="step-content">
            <h4>Get Your Result</h4>
            <p>The result is the volume in litres</p>
          </div>
        </div>
      </div>
      
      <div class="example-calculation">
        <h4>Example: Convert 5 kg of Olive Oil</h4>
        <ul>
          <li>Mass = 5 kg</li>
          <li>Density of olive oil = 0.910 kg/L</li>
          <li>Volume = 5 ÷ 0.910 = <strong>5.495 L</strong></li>
        </ul>
        <p class="mt-2 text-brand-400 font-semibold"><strong>Result:</strong> 5 kg of olive oil = 5.495 litres</p>
      </div>
      
      <div class="example-calculation mt-4">
        <h4>Example: Convert 10 kg of Honey</h4>
        <ul>
          <li>Mass = 10 kg</li>
          <li>Density of honey = 1.420 kg/L</li>
          <li>Volume = 10 ÷ 1.420 = <strong>7.042 L</strong></li>
        </ul>
        <p class="mt-2 text-brand-400 font-semibold"><strong>Result:</strong> 10 kg of honey = 7.042 litres</p>
      </div>
    </section>

    <!-- Keyword 3: How to Calculate kg to Liter -->
    <section class="content-block scroll-mt-24" id="how-to-calculate-kg-to-liter">
      <h2 class="text-2xl font-bold text-white">How to Calculate kg to Liter</h2>
      
      <div class="formula-section">
        <h3 class="text-lg font-bold text-white">The Formula</h3>
        <div class="formula-box">
          <strong>Liters = Kilograms ÷ Density (kg/L)</strong>
        </div>
        <p class="text-slate-300 text-sm">This is the fundamental formula for converting mass to volume.</p>
      </div>
      
      <div class="calculation-examples mt-6 space-y-4">
        <h3 class="text-lg font-bold text-white">Step-by-Step Calculation</h3>
        
        <div class="example-calculation">
          <h4>Example 1: Water</h4>
          <ul>
            <li>Mass: 5 kg</li>
            <li>Density of water: 1.000 kg/L</li>
            <li>Calculation: 5 ÷ 1.000 = <strong class="text-brand-400 font-mono">5.000 L</strong></li>
          </ul>
        </div>
        
        <div class="example-calculation">
          <h4>Example 2: Diesel</h4>
          <ul>
            <li>Mass: 10 kg</li>
            <li>Density of diesel: 0.832 kg/L</li>
            <li>Calculation: 10 ÷ 0.832 = <strong class="text-brand-400 font-mono">12.019 L</strong></li>
          </ul>
        </div>
        
        <div class="example-calculation">
          <h4>Example 3: Gasoline</h4>
          <ul>
            <li>Mass: 15 kg</li>
            <li>Density of gasoline: 0.748 kg/L</li>
            <li>Calculation: 15 ÷ 0.748 = <strong class="text-brand-400 font-mono">20.053 L</strong></li>
          </ul>
        </div>
      </div>
      
      <div class="quick-reference mt-6">
        <h3 class="text-lg font-bold text-white mb-2">Quick Calculation Table</h3>
        <div class="overflow-x-auto">
          <table>
            <thead>
              <tr>
                <th>Substance</th>
                <th>Density (kg/L)</th>
                <th>1 kg = ? L</th>
                <th>5 kg = ? L</th>
                <th>10 kg = ? L</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Water</td><td class="font-mono">1.000</td><td class="font-mono text-brand-400">1.000 L</td><td class="font-mono text-brand-400">5.000 L</td><td class="font-mono text-brand-400">10.000 L</td></tr>
              <tr><td>Milk</td><td class="font-mono">1.030</td><td class="font-mono text-brand-400">0.971 L</td><td class="font-mono text-brand-400">4.854 L</td><td class="font-mono text-brand-400">9.709 L</td></tr>
              <tr><td>Olive Oil</td><td class="font-mono">0.910</td><td class="font-mono text-brand-400">1.099 L</td><td class="font-mono text-brand-400">5.495 L</td><td class="font-mono text-brand-400">10.989 L</td></tr>
              <tr><td>Honey</td><td class="font-mono">1.420</td><td class="font-mono text-brand-400">0.704 L</td><td class="font-mono text-brand-400">3.521 L</td><td class="font-mono text-brand-400">7.042 L</td></tr>
              <tr><td>Diesel</td><td class="font-mono">0.832</td><td class="font-mono text-brand-400">1.202 L</td><td class="font-mono text-brand-400">6.010 L</td><td class="font-mono text-brand-400">12.019 L</td></tr>
              <tr><td>Gasoline</td><td class="font-mono">0.748</td><td class="font-mono text-brand-400">1.337 L</td><td class="font-mono text-brand-400">6.684 L</td><td class="font-mono text-brand-400">13.369 L</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Keyword 4: Is 1kg = 1 Litre? -->
    <section class="content-block scroll-mt-24" id="is-1kg-equal-1-litre">
      <h2 class="text-2xl font-bold text-white">Is 1kg = 1 Litre?</h2>
      
      <div class="answer-box">
        <div class="answer-yes">
          <h3>✅ Yes, for Water</h3>
          <p class="text-slate-200"><strong>1 kg of water = 1 litre</strong> at standard room temperature (20°C)</p>
          <p class="text-xs text-slate-400 mt-1">This is because water has a density of exactly 1.000 kg/L</p>
        </div>
        <div class="answer-no">
          <h3>❌ No, for Other Substances</h3>
          <p class="text-slate-200">For all other substances, 1 kg is <strong>not</strong> equal to 1 litre</p>
        </div>
      </div>
      
      <div class="comparison-grid my-4">
        <div class="comparison-item">
          <span class="substance">Water</span>
          <span class="result text-emerald-400">1 kg = 1.000 L ✅</span>
        </div>
        <div class="comparison-item">
          <span class="substance">Milk</span>
          <span class="result text-rose-400">1 kg = 0.971 L ❌</span>
        </div>
        <div class="comparison-item">
          <span class="substance">Olive Oil</span>
          <span class="result text-rose-400">1 kg = 1.099 L ❌</span>
        </div>
        <div class="comparison-item">
          <span class="substance">Honey</span>
          <span class="result text-rose-400">1 kg = 0.704 L ❌</span>
        </div>
        <div class="comparison-item">
          <span class="substance">Diesel</span>
          <span class="result text-rose-400">1 kg = 1.202 L ❌</span>
        </div>
        <div class="comparison-item">
          <span class="substance">Gasoline</span>
          <span class="result text-rose-400">1 kg = 1.337 L ❌</span>
        </div>
      </div>
      
      <div class="key-takeaway">
        <h4 class="font-bold text-white mb-1">Key Takeaway</h4>
        <p class="text-slate-300 text-sm"><strong>1 kg = 1 litre is only true for pure water at 20°C.</strong> For all other substances, the conversion depends on their density.</p>
      </div>
    </section>

    <!-- Keyword 5: How Much is 1 kg to 1 Liter? -->
    <section class="content-block scroll-mt-24" id="how-much-1-kg-to-1-liter">
      <h2 class="text-2xl font-bold text-white">How Much is 1 kg to 1 Liter?</h2>
      
      <div class="conversion-grid">
        <div class="conversion-card highlight">
          <h3 class="font-bold text-white text-base">Water</h3>
          <div class="conversion-value text-brand-400 font-mono font-bold">1 kg = 1.000 L</div>
          <div class="density text-xs text-slate-500 font-mono">(1.000 kg/L)</div>
        </div>
        <div class="conversion-card">
          <h3 class="font-bold text-white text-base">Milk</h3>
          <div class="conversion-value text-brand-400 font-mono font-bold">1 kg = 0.971 L</div>
          <div class="density text-xs text-slate-500 font-mono">(1.030 kg/L)</div>
        </div>
        <div class="conversion-card">
          <h3 class="font-bold text-white text-base">Olive Oil</h3>
          <div class="conversion-value text-brand-400 font-mono font-bold">1 kg = 1.099 L</div>
          <div class="density text-xs text-slate-500 font-mono">(0.910 kg/L)</div>
        </div>
        <div class="conversion-card">
          <h3 class="font-bold text-white text-base">Honey</h3>
          <div class="conversion-value text-brand-400 font-mono font-bold">1 kg = 0.704 L</div>
          <div class="density text-xs text-slate-500 font-mono">(1.420 kg/L)</div>
        </div>
        <div class="conversion-card">
          <h3 class="font-bold text-white text-base">Diesel</h3>
          <div class="conversion-value text-brand-400 font-mono font-bold">1 kg = 1.202 L</div>
          <div class="density text-xs text-slate-500 font-mono">(0.832 kg/L)</div>
        </div>
        <div class="conversion-card">
          <h3 class="font-bold text-white text-base">Gasoline</h3>
          <div class="conversion-value text-brand-400 font-mono font-bold">1 kg = 1.337 L</div>
          <div class="density text-xs text-slate-500 font-mono">(0.748 kg/L)</div>
        </div>
      </div>
      
      <div class="formula-section mt-6">
        <h3 class="text-lg font-bold text-white">Why the Difference?</h3>
        <p class="text-slate-300 text-sm">The conversion depends on density:</p>
        <div class="formula-box my-3">
          <strong>1 kg = 1 ÷ Density (kg/L) in litres</strong>
        </div>
        <ul class="list-disc list-inside text-slate-300 text-sm space-y-1">
          <li>If density &gt; 1.0 kg/L, 1 kg will be &lt; 1 litre (e.g. Honey)</li>
          <li>If density &lt; 1.0 kg/L, 1 kg will be &gt; 1 litre (e.g. Gasoline, Oils)</li>
          <li>If density = 1.0 kg/L, 1 kg = 1 litre (Water)</li>
        </ul>
      </div>
    </section>

    <!-- Keyword 6-7: Are kg and Litres the Same? -->
    <section class="content-block scroll-mt-24" id="are-kg-and-litres-same">
      <h2 class="text-2xl font-bold text-white">Are kg and Litres the Same?</h2>
      
      <div class="comparison-box">
        <div class="kg-box">
          <h3 class="font-bold text-white text-lg mb-2">Kilogram (kg)</h3>
          <ul class="space-y-1 text-sm text-slate-300">
            <li>📦 <strong>Measures Mass</strong></li>
            <li>The amount of matter in an object</li>
            <li>Base unit in the International System of Units (SI)</li>
            <li>1 kg = 1,000 grams</li>
          </ul>
        </div>
        <div class="litre-box">
          <h3 class="font-bold text-white text-lg mb-2">Litre (L)</h3>
          <ul class="space-y-1 text-sm text-slate-300">
            <li>🧪 <strong>Measures Volume</strong></li>
            <li>The amount of space an object occupies</li>
            <li>1 L = 1,000 millilitres (ml)</li>
            <li>1 L = 0.001 cubic metres (m³)</li>
          </ul>
        </div>
      </div>
      
      <div class="answer-box">
        <div class="p-4 bg-surface-950/80 rounded-xl border border-white/[0.08] col-span-full">
          <h4 class="text-base font-bold text-white mb-1">Direct Answer: No, kg and litres are NOT the same.</h4>
          <p class="text-slate-300 text-sm">They measure different physical properties:</p>
          <ul class="list-disc list-inside text-slate-300 text-sm my-2 space-y-1">
            <li><strong>Kilograms</strong> measure mass (how much matter)</li>
            <li><strong>Litres</strong> measure volume (how much space)</li>
          </ul>
          <p class="text-slate-400 text-xs">They can only be converted using <strong>density</strong>: <span class="text-brand-400 font-mono">kg = L × density</span></p>
        </div>
      </div>
      
      <div class="faq-item mt-4">
        <h4 class="text-base font-bold text-white">Is kg equal to litre?</h4>
        <p class="text-slate-300 text-sm"><strong>No.</strong> 1 kg = 1 litre only for water. For other substances, the relationship depends on density.</p>
      </div>
    </section>

    <!-- Keyword 8: What is kg to Litres? -->
    <section class="content-block scroll-mt-24" id="what-is-kg-to-litres">
      <h2 class="text-2xl font-bold text-white">What is kg to Litres?</h2>
      
      <div class="definition-box">
        <p class="text-slate-200"><strong>Kg to litres</strong> is the conversion of mass (in kilograms) to volume (in litres) using the substance's density.</p>
      </div>
      
      <div class="formula-section my-4">
        <h3 class="text-lg font-bold text-white">The Formula</h3>
        <div class="formula-box">
          <strong>Volume (L) = Mass (kg) ÷ Density (kg/L)</strong>
        </div>
      </div>
      
      <div class="example-grid">
        <div class="example-item">
          <span class="substance font-bold text-white block">Water</span>
          <span class="result font-mono text-brand-400 font-bold block">1 kg = 1.000 L</span>
        </div>
        <div class="example-item">
          <span class="substance font-bold text-white block">Milk</span>
          <span class="result font-mono text-brand-400 font-bold block">1 kg = 0.971 L</span>
        </div>
        <div class="example-item">
          <span class="substance font-bold text-white block">Olive Oil</span>
          <span class="result font-mono text-brand-400 font-bold block">1 kg = 1.099 L</span>
        </div>
        <div class="example-item">
          <span class="substance font-bold text-white block">Honey</span>
          <span class="result font-mono text-brand-400 font-bold block">1 kg = 0.704 L</span>
        </div>
      </div>
      
      <div class="use-cases mt-6">
        <h3 class="text-lg font-bold text-white mb-2">When to Use kg to Litres Conversion</h3>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-slate-300 text-sm">
          <li class="p-3 bg-surface-950/60 rounded-lg border border-white/[0.04]">🍳 <strong>Cooking:</strong> Recipes often need volume measurements</li>
          <li class="p-3 bg-surface-950/60 rounded-lg border border-white/[0.04]">⛽ <strong>Fuel:</strong> Fuel is sold by volume but often weighed</li>
          <li class="p-3 bg-surface-950/60 rounded-lg border border-white/[0.04]">🏭 <strong>Industry:</strong> Chemical processes require accurate volume dosing</li>
          <li class="p-3 bg-surface-950/60 rounded-lg border border-white/[0.04]">🔬 <strong>Science:</strong> Lab measurements often need mass-to-volume conversion</li>
        </ul>
      </div>
    </section>

    <!-- Keyword 9: Can You Convert kg to Liters? -->
    <section class="content-block scroll-mt-24" id="can-you-convert-kg-to-liters">
      <h2 class="text-2xl font-bold text-white">Can You Convert kg to Liters?</h2>
      
      <div class="answer-box">
        <div class="answer-yes col-span-full">
