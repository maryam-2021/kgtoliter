---
// src/pages/kg-to-litres-guide/index.astro
import BaseLayout from '@layouts/BaseLayout.astro';
import FAQAccordion from '@components/interactive/FAQAccordion.astro';
import { useI18n } from '../../utils/i18n';
import { getCollection } from 'astro:content';

const { locale = 'en' } = Astro.params;
const { t } = useI18n(locale);

const allGuides = await getCollection('guides');

const guideFaqs = [
  {
    q: 'What is the kg to litre formula?',
    a: 'Volume (L) = Mass (kg) ÷ Density (kg/L). This is the fundamental formula for converting kilograms to litres for any substance.',
  },
  {
    q: 'How many litres is 1 kg of oil?',
    a: '1 kg of olive oil = 1.099 L, 1 kg of canola oil = 1.089 L, 1 kg of coconut oil = 1.082 L, 1 kg of avocado oil = 1.096 L.',
  },
  {
    q: 'What is the kg to litres formula for water?',
    a: '1 kg of water = 1 litre. The formula is Volume (L) = Mass (kg) ÷ 1.000.',
  },
  {
    q: 'How many litres is 1 kg of diesel?',
    a: '1 kg of diesel = 1.202 litres. Diesel has a density of approximately 0.832 kg/L.',
  },
  {
    q: 'How many litres is 1 kg of LPG?',
    a: '1 kg of LPG = 1.96 litres. LPG has a density of approximately 0.510 kg/L.',
  },
  {
    q: 'How many litres is 1 kg of milk?',
    a: '1 kg of milk = 0.971 litres. Milk has a density of approximately 1.030 kg/L.',
  },
  {
    q: 'How many litres is 1 kg of paint?',
    a: '1 kg of latex paint = 0.833 L, 1 kg of oil-based paint = 0.769 L, 1 kg of epoxy paint = 0.667 L, 1 kg of primer = 0.833 L.',
  },
  {
    q: 'How many litres is 1 kg of gasoline?',
    a: '1 kg of gasoline = 1.337 litres. Gasoline has a density of approximately 0.748 kg/L.',
  },
  {
    q: 'How many litres is 1 kg of cat litter?',
    a: '1 kg of clay litter = 1.25 L, 1 kg of crystal litter = 1.67 L, 1 kg of wood litter = 2.00 L, 1 kg of corn/wheat litter = 2.50 L.',
  },
  {
    q: 'How much is kg to litres?',
    a: 'The conversion depends on density. For water: 1 kg = 1 L. For honey: 1 kg = 0.704 L.',
  },
  {
    q: 'How to calculate kg to liter?',
    a: 'Divide the mass in kg by the density in kg/L. Example: 5 kg ÷ 0.910 kg/L = 5.495 L.',
  },
  {
    q: 'Is 1kg = 1 litre?',
    a: 'Only for water at 20°C. For other substances, 1 kg ≠ 1 L.',
  },
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'KG to Litres Guide - Complete Conversion Reference & Formula Calculator',
    description: 'Complete guide to converting kg to litres. Includes formulas, examples, interactive calculator demo, and conversion tables for 772 substances.',
    author: {
      '@type': 'Organization',
      name: 'Kg to Litre Engineering Team',
      url: 'https://kgtoliter.com/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Kg to Litre',
      url: 'https://kgtoliter.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://kgtoliter.com/favicon.svg',
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': 'https://kgtoliter.com/kg-to-litres-guide/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guideFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<BaseLayout 
  title="KG to Litres Guide - Complete Conversion Reference"
  description="Complete guide to converting kg to litres. Includes formulas, examples, and conversion tables for 772 substances."
  locale={locale}
  canonicalUrl="https://kgtoliter.com/kg-to-litres-guide/"
  schema={pageSchema}
>
  <main class="container mx-auto px-4 py-8 max-w-4xl space-y-10">
    <header class="text-center space-y-3 mb-6">
      <span class="px-3 py-1 text-xs font-mono font-semibold rounded-full bg-brand-500/10 text-brand-400 border border-brand-500/20 uppercase tracking-wider inline-block">
        Comprehensive Technical Reference
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white section-title">
        KG to Litres: Complete Conversion Guide
      </h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        Everything you need to know about converting kilograms to litres. This guide covers formulas, examples, interactive calculators, and substance-specific conversions.
      </p>

      <!-- Quick Nav Anchor Pills -->
      <nav aria-label="Guide quick links" class="flex flex-wrap justify-center gap-2 pt-4">
        <a href="#kg-to-litre-formula" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Formula Guide</a>
        <a href="#kg-to-liters-formula-calculator" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Formula Calculator</a>
        <a href="#kg-to-liters-for-oil" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Cooking Oils</a>
        <a href="#kg-to-litre-for-water" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Water</a>
        <a href="#kg-to-litre-for-diesel" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Diesel</a>
        <a href="#kg-to-litre-for-lpg" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">LPG Gas</a>
        <a href="#kg-to-liter-for-milk" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Milk</a>
        <a href="#kg-to-liters-for-paint" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Paint</a>
        <a href="#kg-to-liter-for-gas" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Gasoline</a>
        <a href="#kg-to-liter-for-cat-litter" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">Cat Litter</a>
        <a href="#faq" class="px-3 py-1.5 rounded-lg bg-surface-900 border border-white/[0.08] text-xs text-slate-300 hover:text-brand-400 hover:border-brand-500/30 transition-all">FAQ</a>
      </nav>
    </header>

    <div class="space-y-10">
      <!-- Section 1: kg to litre formula -->
      <section class="content-block scroll-mt-24" id="kg-to-litre-formula">
        <h2 class="text-2xl font-bold text-white">Kg to Litre Formula: Complete Guide</h2>
        
        <div class="formula-section">
          <h3 class="text-lg font-bold text-white">The Formula</h3>
          <div class="formula-box">
            <strong>Volume (L) = Mass (kg) ÷ Density (kg/L)</strong>
          </div>
          <p class="text-slate-300 text-sm">This is the fundamental formula for converting kilograms to litres for any substance.</p>
        </div>
        
        <div class="example-calculation">
          <h4>Example Calculation</h4>
          <p class="text-slate-200"><strong>Convert 5 kg of olive oil to litres</strong></p>
          <ul class="mt-2 space-y-1">
            <li>Mass = 5 kg</li>
            <li>Density of olive oil = 0.910 kg/L</li>
            <li>Volume = 5 ÷ 0.910 = <strong class="text-brand-400 font-mono">5.495 L</strong></li>
          </ul>
        </div>
        
        <div class="quick-reference mt-6">
          <h4 class="text-base font-bold text-white mb-2">Quick Reference Table</h4>
          <div class="overflow-x-auto">
            <table>
              <thead>
                <tr>
                  <th>Substance</th>
                  <th>Density (kg/L)</th>
                  <th>1 kg = ? L</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>Water</td><td class="font-mono">1.000</td><td class="font-mono text-brand-400 font-semibold">1.000 L</td></tr>
                <tr><td>Milk</td><td class="font-mono">1.030</td><td class="font-mono text-brand-400 font-semibold">0.971 L</td></tr>
                <tr><td>Olive Oil</td><td class="font-mono">0.910</td><td class="font-mono text-brand-400 font-semibold">1.099 L</td></tr>
                <tr><td>Honey</td><td class="font-mono">1.420</td><td class="font-mono text-brand-400 font-semibold">0.704 L</td></tr>
                <tr><td>Diesel</td><td class="font-mono">0.832</td><td class="font-mono text-brand-400 font-semibold">1.202 L</td></tr>
                <tr><td>Gasoline</td><td class="font-mono">0.748</td><td class="font-mono text-brand-400 font-semibold">1.337 L</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Section 2: kg to liters for oil -->
      <section class="content-block scroll-mt-24" id="kg-to-liters-for-oil">
        <h2 class="text-2xl font-bold text-white">Kg to Liters for Oil</h2>
        
        <div class="substance-intro">
          <p>Converting kilograms to litres for <strong>cooking oil</strong> depends on the specific type of oil. Most cooking oils have densities between 0.910 and 0.927 kg/L.</p>
        </div>
        
        <div class="conversion-grid">
          <div class="conversion-card">
            <h3>Olive Oil</h3>
            <div class="conversion-value">1 kg = 1.099 L</div>
            <div class="density font-mono">(0.910 kg/L)</div>
          </div>
          <div class="conversion-card">
            <h3>Canola Oil</h3>
            <div class="conversion-value">1 kg = 1.089 L</div>
            <div class="density font-mono">(0.918 kg/L)</div>
          </div>
          <div class="conversion-card">
            <h3>Vegetable Oil</h3>
            <div class="conversion-value">1 kg = 1.087 L</div>
            <div class="density font-mono">(0.920 kg/L)</div>
          </div>
          <div class="conversion-card">
            <h3>Coconut Oil</h3>
            <div class="conversion-value">1 kg = 1.082 L</div>
            <div class="density font-mono">(0.924 kg/L)</div>
          </div>
          <div class="conversion-card">
            <h3>Avocado Oil</h3>
            <div class="conversion-value">1 kg = 1.096 L</div>
            <div class="density font-mono">(0.912 kg/L)</div>
          </div>
          <div class="conversion-card">
            <h3>Peanut Oil</h3>
            <div class="conversion-value">1 kg = 1.096 L</div>
            <div class="density font-mono">(0.912 kg/L)</div>
          </div>
        </div>
        
        <div class="formula-section mt-6">
          <h3 class="text-lg font-bold text-white">Formula for Oil</h3>
          <div class="formula-box my-3">
            <strong>Volume (L) = Mass (kg) ÷ Density (kg/L)</strong>
          </div>
          <p class="text-slate-300 text-sm"><strong>Example:</strong> 5 kg of olive oil = 5 ÷ 0.910 = <strong class="text-brand-400 font-mono">5.495 L</strong></p>
        </div>
      </section>

      <!-- Section 3: kg to liters formula calculator -->
      <section class="content-block scroll-mt-24" id="kg-to-liters-formula-calculator">
        <h2 class="text-2xl font-bold text-white">Kg to Liters Formula Calculator</h2>
        
        <div class="calculator-section">
          <h3 class="text-lg font-bold text-white">Use Our Free Calculator</h3>
          <p class="text-slate-300 text-sm mt-1">Enter the mass and density to get the volume instantly:</p>
          
          <div class="calculator-demo">
            <div class="calc-row">
              <label for="calcMass">Mass (kg):</label>
              <input type="number" id="calcMass" value="5" step="0.1" class="calc-input">
            </div>
            <div class="calc-row">
              <label for="calcDensity">Density (kg/L):</label>
              <input type="number" id="calcDensity" value="0.910" step="0.001" class="calc-input">
            </div>
            <div class="calc-result">
              <span class="result-label">Volume:</span>
              <span class="result-value" id="calcResult">5.495 L</span>
            </div>
          </div>
        </div>
        
        <div class="formula-section">
          <h3 class="text-lg font-bold text-white">The Formula</h3>
          <div class="formula-box">
            <strong>Volume (L) = Mass (kg) ÷ Density (kg/L)</strong>
          </div>
        </div>
        
        <div class="quick-reference mt-6">
          <h4 class="text-base font-bold text-white mb-2">Common Densities</h4>
          <div class="overflow-x-auto">
            <table>
              <thead>
                <tr>
                  <th>Substance</th>
                  <th>Density (kg/L)</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>Water</td><td class="font-mono text-brand-400 font-semibold">1.000</td></tr>
                <tr><td>Milk</td><td class="font-mono text-brand-400 font-semibold">1.030</td></tr>
                <tr><td>Olive Oil</td><td class="font-mono text-brand-400 font-semibold">0.910</td></tr>
                <tr><td>Diesel</td><td class="font-mono text-brand-400 font-semibold">0.832</td></tr>
                <tr><td>Gasoline</td><td class="font-mono text-brand-400 font-semibold">0.748</td></tr>
                <tr><td>Honey</td><td class="font-mono text-brand-400 font-semibold">1.420</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Section 4: kg to litre for water -->
      <section class="content-block scroll-mt-24" id="kg-to-litre-for-water">
        <h2 class="text-2xl font-bold text-white">Kg to Litre for Water</h2>
        
        <div class="substance-intro">
          <p><strong class="text-white">1 kg of water = 1 litre</strong> at standard room temperature (20°C).</p>
          <p>This is because water has a density of exactly <strong>1.000 kg/L</strong>.</p>
        </div>
        
        <div class="conversion-table my-4 overflow-x-auto">
          <h3 class="text-lg font-bold text-white mb-2">Water Conversion Table</h3>
          <table>
            <thead>
              <tr>
                <th>Mass (kg)</th>
                <th>Volume (L)</th>
                <th>Volume (mL)</th>
                <th>Volume (US gal)</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="font-mono">0.1 kg</td><td class="font-mono text-brand-400 font-semibold">0.1 L</td><td class="font-mono">100 mL</td><td class="font-mono">0.026 gal</td></tr>
              <tr><td class="font-mono">0.5 kg</td><td class="font-mono text-brand-400 font-semibold">0.5 L</td><td class="font-mono">500 mL</td><td class="font-mono">0.132 gal</td></tr>
              <tr><td class="font-mono">1 kg</td><td class="font-mono text-brand-400 font-semibold">1.0 L</td><td class="font-mono">1,000 mL</td><td class="font-mono">0.264 gal</td></tr>
              <tr><td class="font-mono">2 kg</td><td class="font-mono text-brand-400 font-semibold">2.0 L</td><td class="font-mono">2,000 mL</td><td class="font-mono">0.528 gal</td></tr>
              <tr><td class="font-mono">5 kg</td><td class="font-mono text-brand-400 font-semibold">5.0 L</td><td class="font-mono">5,000 mL</td><td class="font-mono">1.321 gal</td></tr>
              <tr><td class="font-mono">10 kg</td><td class="font-mono text-brand-400 font-semibold">10.0 L</td><td class="font-mono">10,000 mL</td><td class="font-mono">2.642 gal</td></tr>
              <tr><td class="font-mono">20 kg</td><td class="font-mono text-brand-400 font-semibold">20.0 L</td><td class="font-mono">20,000 mL</td><td class="font-mono">5.283 gal</td></tr>
              <tr><td class="font-mono">50 kg</td><td class="font-mono text-brand-400 font-semibold">50.0 L</td><td class="font-mono">50,000 mL</td><td class="font-mono">13.209 gal</td></tr>
            </tbody>
          </table>
        </div>
        
        <div class="formula-section">
          <h3 class="text-lg font-bold text-white">Formula for Water</h3>
          <div class="formula-box my-3">
            <strong>Volume (L) = Mass (kg) ÷ 1.000</strong>
          </div>
          <p class="text-slate-300 text-sm"><strong>Example:</strong> 5 kg of water = 5 ÷ 1.000 = <strong class="text-brand-400 font-mono">5.000 L</strong></p>
        </div>
      </section>

      <!-- Section 5: kg to litre for diesel -->
      <section class="content-block scroll-mt-24" id="kg-to-litre-for-diesel">
        <h2 class="text-2xl font-bold text-white">Kg to Litre for Diesel</h2>
        
        <div class="substance-intro">
          <p><strong class="text-white">1 kg of diesel = 1.202 litres</strong> at standard room temperature (20°C).</p>
          <p>Diesel has a density of approximately <strong>0.832 kg/L</strong>.</p>
        </div>
        
        <div class="conversion-table my-4 overflow-x-auto">
          <h3 class="text-lg font-bold text-white mb-2">Diesel Conversion Table</h3>
          <table>
            <thead>
              <tr>
                <th>Mass (kg)</th>
                <th>Volume (L)</th>
                <th>Volume (US gal)</th>
                <th>Volume (UK gal)</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="font-mono">1 kg</td><td class="font-mono text-brand-400 font-semibold">1.202 L</td><td class="font-mono">0.318 gal</td><td class="font-mono">0.264 gal</td></tr>
              <tr><td class="font-mono">5 kg</td><td class="font-mono text-brand-400 font-semibold">6.010 L</td><td class="font-mono">1.588 gal</td><td class="font-mono">1.322 gal</td></tr>
              <tr><td class="font-mono">10 kg</td><td class="font-mono text-brand-400 font-semibold">12.019 L</td><td class="font-mono">3.175 gal</td><td class="font-mono">2.644 gal</td></tr>
              <tr><td class="font-mono">20 kg</td><td class="font-mono text-brand-400 font-semibold">24.038 L</td><td class="font-mono">6.351 gal</td><td class="font-mono">5.288 gal</td></tr>
              <tr><td class="font-mono">50 kg</td><td class="font-mono text-brand-400 font-semibold">60.096 L</td><td class="font-mono">15.877 gal</td><td class="font-mono">13.219 gal</td></tr>
              <tr><td class="font-mono">100 kg</td><td class="font-mono text-brand-400 font-semibold">120.192 L</td><td class="font-mono">31.754 gal</td><td class="font-mono">26.438 gal</td></tr>
            </tbody>
          </table>
        </div>
        
        <div class="formula-section">
          <h3 class="text-lg font-bold text-white">Formula for Diesel</h3>
          <div class="formula-box my-3">
            <strong>Volume (L) = Mass (kg) ÷ 0.832</strong>
          </div>
          <p class="text-slate-300 text-sm"><strong>Example:</strong> 10 kg of diesel = 10 ÷ 0.832 = <strong class="text-brand-400 font-mono">12.019 L</strong></p>
        </div>
      </section>

      <!-- Section 6: kg to litre for lpg -->
      <section class="content-block scroll-mt-24" id="kg-to-litre-for-lpg">
        <h2 class="text-2xl font-bold text-white">Kg to Litre for LPG</h2>
        
        <div class="substance-intro">
          <p><strong class="text-white">1 kg of LPG = 1.96 litres</strong> at standard room temperature (20°C).</p>
          <p>LPG has a density of approximately <strong>0.51 kg/L</strong>.</p>
          <p><small class="text-slate-400"><strong>Note:</strong> LPG density varies by composition (propane/butane ratio).</small></p>
        </div>
        
        <div class="conversion-table my-4 overflow-x-auto">
          <h3 class="text-lg font-bold text-white mb-2">LPG Conversion Table</h3>
          <table>
            <thead>
              <tr>
                <th>Mass (kg)</th>
                <th>Volume (L)</th>
                <th>Volume (US gal)</th>
              </tr>
            </thead>
            <tbody>
              <tr><td class="font-mono">1 kg</td><td class="font-mono text-brand-400 font-semibold">1.961 L</td><td class="font-mono">0.518 gal</td></tr>
              <tr><td class="font-mono">5 kg</td><td class="font-mono text-brand-400 font-semibold">9.804 L</td><td class="font-mono">2.590 gal</td></tr>
              <tr><td class="font-mono">10 kg</td><td class="font-mono text-brand-400 font-semibold">19.608 L</td><td class="font-mono">5.180 gal</td></tr>
              <tr><td class="font-mono">14.2 kg</td><td class="font-mono text-brand-400 font-semibold">27.843 L</td><td class="font-mono">7.356 gal</td></tr>
              <tr><td class="font-mono">20 kg</td><td class="font-mono text-brand-400 font-semibold">39.216 L</td><td class="font-mono">10.360 gal</td></tr>
              <tr><td class="font-mono">50 kg</td><td class="font-mono text-brand-400 font-semibold">98.039 L</td><td class="font-mono">25.899 gal</td></tr>
            </tbody>
          </table>
        </div>
        
        <div class="formula-section">
          <h3 class="text-lg font-bold text-white">Formula for LPG</h3>
          <div class="formula-box my-3">
            <strong>Volume (L) = Mass (kg) ÷ 0.510</strong>
          </div>
          <p class="text-slate-300 text-sm"><strong>Example:</strong> 5 kg of LPG = 5 ÷ 0.510 = <strong class="text-brand-400 font-mono">9.804 L</strong></p>
        </div>
        
        <div class="note-box mt-4">
          <h4>⚠️ Important Note</h4>
          <p>LPG density varies with temperature and composition. The values above are approximate for a 60/40 propane/butane mix at 20°C.</p>
        </div>
      </section>

      <!-- Section 7: kg to liter for milk -->
      <section class="content-block scroll-mt-24" id="kg-to-liter-for-milk">
        <h2 class="text-2xl font-bold text-white">Kg to Liter for Milk</h2>
        
        <div class="substance-intro">
          <p><strong class="text-white">1 kg of milk = 0.971 litres</strong> at standard room temperature (20°C).</p>
          <p>Milk has a density of approximately <strong>1.030 kg/L</strong>.</p>
          <p><small class="text-slate-400"><strong>Note:</strong> Milk density varies slightly with fat content and temperature.</small></p>
        </div>
        
        <div class="conversion-table my-4 overflow-x-auto">
          <h3 class="text-lg font-bold text-white mb-2">Milk Conversion Table</h3>
          <table>
            <thead>
              <tr>
