---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import ContainerCalculator from '../components/interactive/ContainerCalculator.astro';
import FAQAccordion from '../components/interactive/FAQAccordion.astro';

const title = 'Container & Tank Volume-to-Mass Calculator | Free 3D Capacity Tool';
const description =
  'Calculate liquid capacity, fill percentage, and payload mass (kg & tonnes) for rectangular tanks, vertical cylinders, horizontal tankers, IBC totes, and 55-gallon drums.';

const tankFaqs = [
  {
    q: 'How do you calculate the liquid weight in a storage tank?',
    a: 'Calculate the liquid volume in litres (Volume = Geometry Volume × Fill Percentage), then multiply by the liquid density in kg/L: Mass (kg) = Volume (L) × Density (kg/L).',
  },
  {
    q: 'How much does a full 1,000L IBC tote weigh with diesel vs water?',
    a: 'A 1,000L IBC tote holding pure water (1.00 kg/L) contains 1,000 kg of liquid (~1,060 kg with tote tare weight). Holding EN 590 diesel (0.832 kg/L), it contains 832 kg of liquid (~892 kg gross).',
  },
  {
    q: 'How does partial fill level (ullage) affect tank mass?',
    a: 'Ullage represents empty vapor space. Liquid mass scales linearly with filled volume: Mass = Total Tank Volume × (Fill Level %) × Density.',
  },
  {
    q: 'What is the formula for horizontal cylindrical tanks?',
    a: 'For a horizontal cylinder of radius r and length L filled to depth h, the partial cross-sectional area is A = r² arccos((r - h)/r) - (r - h)√(2rh - h²), and liquid volume is V = A × L.',
  },
];

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Container & Tank Volume-to-Mass Calculator',
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Any',
    description: description,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: tankFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<BaseLayout title={title} description={description} schema={pageSchema} canonicalUrl="/container-calculator/">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-16 space-y-12">
    <!-- Breadcrumbs -->
    <BreadcrumbNav categoryName="Tools" categorySlug="tools" substanceName="Container & Tank Calculator" />

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto space-y-4 animate-fade-in-up">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/20 mb-2">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
        <span class="text-xs font-semibold text-brand-400 font-mono">Volumetric 3D Tank Solver</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Container &amp; Tank Volume-to-Mass Calculator
      </h1>
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Determine tank capacity, partial liquid volume, and gross material mass across rectangular totes, vertical silos, horizontal tankers, and industrial drums.
      </p>
    </header>

    <!-- Interactive Container Calculator Widget -->
    <section class="reveal-section">
      <ContainerCalculator />
    </section>

    <!-- Industry Standard Presets Reference -->
    <section class="reveal-section glass-card p-6 sm:p-8 rounded-2xl space-y-6">
      <h2 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-brand-500/15 text-brand-400 flex items-center justify-center text-sm font-bold">
          📐
        </span>
        <span>Standard Industrial Container Dimensions &amp; Capacities</span>
      </h2>

      <div class="overflow-x-auto rounded-xl border border-white/[0.06]">
        <table class="table-pro">
          <thead>
            <tr>
              <th scope="col">Container Type</th>
              <th scope="col">Standard Dimensions</th>
              <th scope="col">Gross Volume</th>
              <th scope="col">Water Mass (1.0 kg/L)</th>
              <th scope="col">Diesel Mass (0.832 kg/L)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="font-bold text-white">IBC Tote (1000L)</td>
              <td class="font-mono text-slate-300">1.2m × 1.0m × 1.0m</td>
              <td class="font-mono text-emerald-400 font-bold">1,000 L</td>
              <td class="font-mono text-slate-300">1,000 kg (1.00 t)</td>
              <td class="font-mono text-brand-300">832 kg (0.83 t)</td>
            </tr>
            <tr>
              <td class="font-bold text-white">Steel Drum (55 Gal)</td>
              <td class="font-mono text-slate-300">Ø 0.585m × 0.88m H</td>
              <td class="font-mono text-emerald-400 font-bold">208 L</td>
              <td class="font-mono text-slate-300">208 kg</td>
              <td class="font-mono text-brand-300">173.1 kg</td>
            </tr>
            <tr>
              <td class="font-bold text-white">Fuel Road Tanker</td>
              <td class="font-mono text-slate-300">Ø 2.2m × 8.0m L</td>
              <td class="font-mono text-emerald-400 font-bold">30,410 L</td>
              <td class="font-mono text-slate-300">30,410 kg (30.4 t)</td>
              <td class="font-mono text-brand-300">25,301 kg (25.3 t)</td>
            </tr>
            <tr>
              <td class="font-bold text-white">ISO Tank Container (20ft)</td>
              <td class="font-mono text-slate-300">Ø 2.4m × 5.9m L</td>
              <td class="font-mono text-emerald-400 font-bold">26,000 L</td>
              <td class="font-mono text-slate-300">26,000 kg (26.0 t)</td>
              <td class="font-mono text-brand-300">21,632 kg (21.6 t)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQs -->
    <section class="reveal-section space-y-6">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="badge badge-brand">Knowledge Base</span>
        <h2 class="text-2xl font-bold text-white">Frequently Asked Questions</h2>
      </div>
      <FAQAccordion faqs={tankFaqs} />
    </section>
  </div>
</BaseLayout>
