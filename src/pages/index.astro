---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorWidget from '../components/CalculatorWidget.astro';
import SubstanceCard from '../components/SubstanceCard.astro';
import HeroDensityVisualizer from '../components/interactive/HeroDensityVisualizer.astro';
import FormulaPlayground from '../components/interactive/FormulaPlayground.astro';
import VolumeComparisonSlider from '../components/interactive/VolumeComparisonSlider.astro';
import IndustrialVolumeComparisonCard from '../components/interactive/IndustrialVolumeComparisonCard.astro';
import AdvancedBatchConverter from '../components/interactive/AdvancedBatchConverter.astro';
import SubcategoriesGridCard from '../components/interactive/SubcategoriesGridCard.astro';
import EngineOilViscosityChartCard from '../components/interactive/EngineOilViscosityChartCard.astro';
import TemperatureDensitySlider from '../components/interactive/TemperatureDensitySlider.astro';
import InteractiveConversionTable from '../components/interactive/InteractiveConversionTable.astro';
import FAQAccordion from '../components/interactive/FAQAccordion.astro';
import { catalogItems } from '../data/catalog.ts';
import { featuredSubstances } from '../data/substances';
import { getToolPath, toolsData } from '../data/toolsData.ts';
import { getCollection } from 'astro:content';

// Title
const title = 'Kg to litre & Litre to kg | Free Two-Way Calculator';
const description =
  'Convert kilograms to litres or litres to kilograms for water, milk, oil, diesel, and more using compiled reference density values.';

// Define the Schema Array
const homepageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Kg to litre',
    url: 'https://kgtoliter.com/',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Kg to Litre and Litre to Kg Calculator',
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Any',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is kg to litres?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Kg to litres is a conversion that transforms mass (in kilograms) into volume (in litres). Formula: Volume (L) = Mass (kg) ÷ Density (kg/L). Since different substances have different densities, 1 kg of water equals 1 litre, while 1 kg of honey equals 0.704 litres.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is 1 kg to litres?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "1 kg to litres varies depending on the substance's density. For water at 20°C, 1 kg = 1.000 L (density 1.000 kg/L). For milk, 1 kg = 0.971 L. For olive oil, 1 kg = 1.099 L. For honey, 1 kg = 0.704 L. For diesel, 1 kg = 1.202 L. For gasoline, 1 kg = 1.337 L.",
        },
      },
      {
        '@type': 'Question',
        name: 'What is kg to l?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Kg to l is the shorthand for converting kilograms (kg) to litres (L) based on density: Volume (L) = Mass (kg) ÷ Density (kg/L).',
        },
      },
      {
        '@type': 'Question',
        name: 'How much is 1 kg to 1 litre?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '1 kg equals 1 litre only for pure water at standard temperature (20°C) where density is 1.000 kg/L. For other substances, 1 kg = 1 ÷ Density (kg/L) in litres.',
        },
      },
      {
        '@type': 'Question',
        name: 'How many kg to a litre?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The number of kilograms in a litre depends on density: Mass (kg) = Volume (L) × Density (kg/L). For water, 1 L = 1.000 kg; milk = 1.030 kg; olive oil = 0.910 kg; honey = 1.420 kg; diesel = 0.832 kg; gasoline = 0.748 kg.',
        },
      },
      {
        '@type': 'Question',
        name: 'How to calculate kg to litre?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'To calculate kg to litres: 1. Identify substance. 2. Find its density in kg/L. 3. Apply formula Volume (L) = Mass (kg) ÷ Density (kg/L). Example: 5 kg of olive oil (0.910 kg/L) = 5 ÷ 0.910 = 5.495 litres.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is 1kg equivalent to 1 litre?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '1kg is equivalent to 1 litre only for water at 20°C (density 1.0 kg/L). For other liquids like milk (0.971 L/kg) or olive oil (1.099 L/kg), 1kg is not equivalent to 1 litre.',
        },
      },
    ],
  },
];

const allGuides = await getCollection('guides');
const allBlogPosts = await getCollection('blog', ({ data }) => !data.draft);

const featureLinks = [
  {
    href: '/batch-converter/',
    eyebrow: 'Batch & CSV',
    title: 'Bulk Converter',
    description: 'Convert multiple substances or upload CSV files.',
  },
  {
    href: '/container-calculator/',
    eyebrow: '3D Geometry',
    title: 'Container & Tank Solver',
    description: 'Calculate volume and liquid weight for tanks & drums.',
  },
  {
    href: '/custom-density-calculator/',
    eyebrow: '3-Way Solver',
    title: 'Custom Density Solver',
    description: 'Solve for mass, volume, or density with temperature correction.',
  },
  {
    href: '/api-docs/',
    eyebrow: 'Developer API',
    title: 'REST API & Sandbox',
    description: 'Live test console with code snippets for JS, Python, & cURL.',
  },
  {
    href: '#density-directory',
    eyebrow: 'Directory',
    title: 'Density Catalogue',
    description: `Filter all ${catalogItems.length} verified substance records.`,
  },
  {
    href: '/tools/',
    eyebrow: 'Directory',
    title: 'All Specialised Tools',
    description: `Access our complete suite of unit converters.`,
  },
];
---

<BaseLayout title={title} description={description} schema={homepageSchema}>
  <!-- ======== HERO SECTION ======== -->
  <section class="max-w-5xl mx-auto px-4 pt-16 pb-8 md:pt-24 md:pb-12">
    <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-start mb-8">
      <div class="animate-fade-in-up space-y-6">
        <!-- H1 with gradient -->
        <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold leading-[1.1] tracking-tight">
          <span class="gradient-text">Kg to litre</span>
        </h1>

        <!-- Refined subtitle -->
        <p class="text-lg text-slate-400 leading-relaxed max-w-md">
          Instantly convert <strong class="text-slate-200">kg to litres</strong> or <strong class="text-slate-200">litres to kilograms</strong> for 772+ substances with lab-grade reference density values.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="#calculator-root" class="btn-primary inline-flex items-center gap-2">
            Start Converting
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
          </a>
          <a href="#density-directory" class="btn-secondary inline-flex items-center gap-2">
            Browse 772+ Substances
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
          </a>
        </div>

        <!-- Quick Links -->
        <div class="quick-links pt-1">
          <a href="/kg-to-litres/">What is kg to litres?</a>
          <a href="/kg-to-l/">Kg to L quick reference</a>
          <a href="/substances/water/">1 kg to litres water</a>
          <a href="/substances/milk/">1 kg to litres milk</a>
        </div>
      </div>

      <!-- Interactive Visual Diagram with ambient glow -->
      <div class="animate-slide-in-right hero-glow">
        <HeroDensityVisualizer />
      </div>
    </div>

    <!-- Calculator Widget -->
    <div class="animate-fade-in-up mt-4" style="animation-delay: 0.2s;">
      <CalculatorWidget />
    </div>
  </section>

  <!-- ======== TRUST BAR ======== -->
  <div class="max-w-5xl mx-auto px-4">
    <div class="divider-glow"></div>
    <div class="trust-bar" role="complementary" aria-label="Platform statistics">
      <span class="trust-bar-item">
        <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
        772+ Substances
      </span>
      <span class="trust-bar-divider" aria-hidden="true"></span>
      <span class="trust-bar-item">
        <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        Lab-Grade Density Data
      </span>
      <span class="trust-bar-divider" aria-hidden="true"></span>
      <span class="trust-bar-item">
        <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        Free Forever
      </span>
      <span class="trust-bar-divider" aria-hidden="true"></span>
      <span class="trust-bar-item">
        <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        18 Languages
      </span>
    </div>
    <div class="divider-glow"></div>
  </div>

  <!-- ======== CONTENT SECTIONS ======== -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-24 pb-16">
    <!-- Popular Substance Conversions Section -->
    <section class="reveal-section">
      <div class="text-center max-w-2xl mx-auto space-y-3 mb-8">
        <h2 class="text-2xl md:text-3xl font-bold section-title">Popular Substance Conversions</h2>
        <p class="text-slate-400 text-sm leading-relaxed max-w-lg mx-auto">
          Instant mass-to-volume references for the most frequently calculated liquids.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {
          featuredSubstances.map((substance) => (
            <SubstanceCard
              id={substance.id === 'gasoline' ? 'petrol' : substance.id}
              name={substance.name}
              density={substance.density}
              icon={substance.icon}
            />
          ))
        }
      </div>
    </section>

    <nav aria-label="Interactive feature navigation" class="reveal-section">
      <div class="text-center max-w-2xl mx-auto space-y-3 mb-8">
        <h2 class="text-2xl md:text-3xl font-bold section-title">Choose a Conversion Feature</h2>
        <p class="text-slate-400 text-sm leading-relaxed max-w-lg mx-auto">
          Jump directly to a calculator, simulator, comparison, or searchable density reference.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          featureLinks.map((feature) => (
            <a
              href={feature.href}
              class="glass-card glass-card-hover rounded-2xl p-6 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
            >
              <span class="text-[10px] uppercase tracking-[0.18em] text-brand-400/80 font-semibold">
                {feature.eyebrow}
              </span>
              <span class="flex items-center justify-between gap-3 mt-2.5">
                <strong class="text-white group-hover:text-brand-300 transition-colors">
                  {feature.title}
                </strong>
                <span
                  aria-hidden="true"
                  class="text-slate-600 group-hover:text-brand-400 group-hover:translate-x-1 transition-all"
                >
                  &rarr;
                </span>
              </span>
              <span class="block text-xs text-slate-500 mt-2.5 leading-relaxed">
                {feature.description}
              </span>
            </a>
          ))
        }
      </div>
    </nav>

    <!-- Formula Playground -->
    <section id="interactive-sliders" class="reveal-section scroll-mt-24">
      <div class="text-center max-w-2xl mx-auto space-y-3 mb-10">
        <h2 class="text-2xl md:text-3xl font-bold section-title">
          Kg to Litre and Litre to Kg Formulas
        </h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed max-w-lg mx-auto">
          Divide mass by density for litres: V = m ÷ ρ. Multiply volume by density for kilograms: m
          = V × ρ. Drag the sliders below to explore the relationship in real time.
        </p>
      </div>
      <div class="max-w-3xl mx-auto">
        <FormulaPlayground />
      </div>
    </section>

    <!-- How Many kg to a Litre Section -->
    <section class="content-block reveal-section max-w-4xl mx-auto scroll-mt-24" id="how-many-kg-to-litre">
      <h2 class="text-2xl md:text-3xl font-bold section-title">How Many kg to a Litre?</h2>
      <p class="text-slate-300 mt-2">The number of kilograms in a litre depends on the substance's density. The formula is:</p>
      <div class="formula-box my-4">
        <strong>Mass (kg) = Volume (L) &times; Density (kg/L)</strong>
      </div>
      
      <div class="example-grid my-4">
        <div class="example-item">
          <span class="substance font-bold text-white block">Water</span>
          <span class="result font-mono text-brand-400 font-bold block">1 L = 1.000 kg</span>
          <span class="density text-xs text-slate-500 font-mono block">(1.000 kg/L)</span>
        </div>
        <div class="example-item">
          <span class="substance font-bold text-white block">Milk</span>
          <span class="result font-mono text-brand-400 font-bold block">1 L = 1.030 kg</span>
          <span class="density text-xs text-slate-500 font-mono block">(1.030 kg/L)</span>
        </div>
        <div class="example-item">
          <span class="substance font-bold text-white block">Olive Oil</span>
          <span class="result font-mono text-brand-400 font-bold block">1 L = 0.910 kg</span>
          <span class="density text-xs text-slate-500 font-mono block">(0.910 kg/L)</span>
        </div>
        <div class="example-item">
          <span class="substance font-bold text-white block">Honey</span>
          <span class="result font-mono text-brand-400 font-bold block">1 L = 1.420 kg</span>
          <span class="density text-xs text-slate-500 font-mono block">(1.420 kg/L)</span>
        </div>
        <div class="example-item">
          <span class="substance font-bold text-white block">Diesel</span>
          <span class="result font-mono text-brand-400 font-bold block">1 L = 0.832 kg</span>
          <span class="density text-xs text-slate-500 font-mono block">(0.832 kg/L)</span>
        </div>
        <div class="example-item">
          <span class="substance font-bold text-white block">Gasoline</span>
          <span class="result font-mono text-brand-400 font-bold block">1 L = 0.748 kg</span>
          <span class="density text-xs text-slate-500 font-mono block">(0.748 kg/L)</span>
        </div>
      </div>
      
      <p class="text-slate-300 mt-4"><strong>Quick Answer:</strong> For water, 1 litre = 1 kg. For other substances, it varies based on density.</p>
      <div class="mt-4">
        <a href="/kg-to-litres-guide/" class="read-more">Read full guide &rarr;</a>
      </div>
    </section>

    <!-- How Much Litre to Gallon Section -->
    <section class="content-block reveal-section max-w-4xl mx-auto scroll-mt-24" id="how-much-litre-to-gallon">
      <h2 class="text-2xl md:text-3xl font-bold section-title">How Much Litre to Gallon?</h2>
      <p class="text-slate-300 mt-2">There are two types of gallons:</p>
      
      <div class="conversion-cards">
        <div class="conversion-card">
          <h3 class="text-lg font-bold text-white mb-2">US Gallon</h3>
          <div class="conversion-value text-brand-400 font-mono font-bold">1 US gal = 3.78541 L</div>
          <div class="conversion-value text-slate-300 font-mono text-sm">1 L = 0.26417 US gal</div>
        </div>
        <div class="conversion-card">
          <h3 class="text-lg font-bold text-white mb-2">UK (Imperial) Gallon</h3>
          <div class="conversion-value text-brand-400 font-mono font-bold">1 UK gal = 4.54609 L</div>
          <div class="conversion-value text-slate-300 font-mono text-sm">1 L = 0.21997 UK gal</div>
        </div>
      </div>
      
      <div class="example-calculation">
        <h4 class="text-base font-bold text-white mb-2">Example: 5 Litres to Gallons</h4>
        <p class="text-slate-300">5 L &times; 0.26417 = <strong class="text-white font-mono">1.321 US gallons</strong></p>
        <p class="text-slate-300 mt-1">5 L &times; 0.21997 = <strong class="text-white font-mono">1.100 UK gallons</strong></p>
      </div>
    </section>

    <!-- How Much Litre to ml Section -->
    <section class="content-block reveal-section max-w-4xl mx-auto scroll-mt-24" id="how-much-litre-to-ml">
      <h2 class="text-2xl md:text-3xl font-bold section-title">How Much Litre to ml?</h2>
      <p class="text-slate-300 mt-2"><strong class="text-white">1 litre = 1,000 millilitres (ml)</strong></p>
      
      <div class="conversion-table my-4 overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr>
              <th>Litres (L)</th>
              <th>Millilitres (ml)</th>
            </tr>
          </thead>
          <tbody>
            <tr><td class="font-mono">0.1 L</td><td class="font-mono text-brand-400 font-semibold">100 ml</td></tr>
            <tr><td class="font-mono">0.25 L</td><td class="font-mono text-brand-400 font-semibold">250 ml</td></tr>
            <tr><td class="font-mono">0.5 L</td><td class="font-mono text-brand-400 font-semibold">500 ml</td></tr>
            <tr><td class="font-mono">0.75 L</td><td class="font-mono text-brand-400 font-semibold">750 ml</td></tr>
            <tr><td class="font-mono">1 L</td><td class="font-mono text-brand-400 font-semibold">1,000 ml</td></tr>
            <tr><td class="font-mono">1.5 L</td><td class="font-mono text-brand-400 font-semibold">1,500 ml</td></tr>
            <tr><td class="font-mono">2 L</td><td class="font-mono text-brand-400 font-semibold">2,000 ml</td></tr>
            <tr><td class="font-mono">5 L</td><td class="font-mono text-brand-400 font-semibold">5,000 ml</td></tr>
          </tbody>
        </table>
      </div>
      
      <p class="text-slate-300 mt-3"><strong>Formula:</strong> <span class="font-mono text-brand-400">ml = Litres &times; 1,000</span></p>
    </section>

    <!-- How Much Litre to kg Section -->
    <section class="content-block reveal-section max-w-4xl mx-auto scroll-mt-24" id="how-much-litre-to-kg">
      <h2 class="text-2xl md:text-3xl font-bold section-title">How Much Litre to kg?</h2>
      <p class="text-slate-300 mt-2">To convert litres to kilograms, use this formula:</p>
      <div class="formula-box my-4">
        <strong>Mass (kg) = Volume (L) &times; Density (kg/L)</strong>
      </div>
      
      <div class="example-grid my-4">
        <div class="example-item">
          <span class="substance font-bold text-white block">Water</span>
          <span class="result font-mono text-brand-400 font-bold block">1 L = 1.000 kg</span>
        </div>
        <div class="example-item">
          <span class="substance font-bold text-white block">Milk</span>
          <span class="result font-mono text-brand-400 font-bold block">1 L = 1.030 kg</span>
        </div>
        <div class="example-item">
          <span class="substance font-bold text-white block">Honey</span>
          <span class="result font-mono text-brand-400 font-bold block">1 L = 1.420 kg</span>
        </div>
        <div class="example-item">
          <span class="substance font-bold text-white block">Gasoline</span>
          <span class="result font-mono text-brand-400 font-bold block">1 L = 0.748 kg</span>
        </div>
      </div>
    </section>

    <!-- Volume Comparison -->
    <section id="visual-comparisons" class="reveal-section scroll-mt-24">
      <div class="text-center max-w-2xl mx-auto space-y-3 mb-10">
        <h2 class="text-2xl md:text-3xl font-bold section-title">
          Volume Comparison Across Substances
        </h2>
        <p class="text-slate-400 text-sm leading-relaxed max-w-lg mx-auto">
          See how equal mass (kg) fills different liquid volumes across 5 common materials.
        </p>
      </div>
      <VolumeComparisonSlider />
    </section>

    <!-- Industrial Chemicals 1kg Volume Comparison Card -->
    <section id="batch-conversion" class="reveal-section max-w-5xl mx-auto scroll-mt-24">
      <IndustrialVolumeComparisonCard />
    </section>

    <!-- Batch Conversion Calculator Section -->
    <section class="reveal-section max-w-5xl mx-auto">
      <AdvancedBatchConverter />
    </section>

    <!-- Master Subcategories & Density Filter Grid Section -->
    <section class="reveal-section max-w-6xl mx-auto">
      <div class="text-center max-w-2xl mx-auto space-y-3 mb-10">
        <h2 class="text-2xl md:text-3xl font-bold section-title">Explore Master Density Categories</h2>
        <p class="text-slate-400 text-sm leading-relaxed max-w-lg mx-auto">
          Filter through 25+ subcategories and {catalogItems.length} substances by density range and industry
          domain.
        </p>
      </div>
      <SubcategoriesGridCard />
    </section>

    <!-- Temperature Density -->
    <section id="temperature-simulator" class="reveal-section scroll-mt-24">
      <div class="text-center max-w-2xl mx-auto space-y-3 mb-10">
        <h2 class="text-2xl md:text-3xl font-bold section-title">
          Effect of Temperature on Liquid Density
        </h2>
        <p class="text-slate-400 text-sm leading-relaxed max-w-lg mx-auto">
          Demonstrating thermal expansion physics from 0°C freezing to 100°C boiling point.
        </p>
      </div>
      <TemperatureDensitySlider />
    </section>

    <!-- Interactive Conversion Table -->
    <section id="density-directory" class="reveal-section scroll-mt-24">
      <div class="text-center max-w-2xl mx-auto space-y-3 mb-10">
        <h2 class="text-2xl md:text-3xl font-bold section-title">Substance Density Directory</h2>
      </div>
      <InteractiveConversionTable />
    </section>

    <!-- Guides & Articles -->
    <section class="reveal-section space-y-8">
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <h2 class="text-2xl md:text-3xl font-bold section-title">
          Conversion Guides &amp; Technical Articles
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 stagger-children">
        {
          allGuides.map((guide) => (
            <a
              href={`/guides/${guide.id}/`}
              class="group glass-card glass-card-hover rounded-2xl p-6 block"
            >
              <div class="flex items-center gap-2 text-xs font-mono text-brand-400 mb-3">
                <span class="badge badge-brand capitalize font-sans">{guide.data.category}</span>
                <span class="text-slate-600">•</span>
                <span class="text-slate-500">
                  {new Date(guide.data.pubDate).toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </span>
              </div>
              <h3 class="text-base font-bold text-white group-hover:text-brand-300 transition-colors duration-300 mb-2 leading-snug">
                {guide.data.title}
              </h3>
              <p class="text-slate-500 text-xs line-clamp-2 leading-relaxed">
                {guide.data.description}
              </p>
              <div class="mt-4">
                <span class="text-xs font-semibold text-brand-400 group-hover:translate-x-1 inline-block transition-transform duration-300">
                  Read Guide &rarr;
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ======== BLOG & TECHNICAL INSIGHTS ======== -->
    {
      allBlogPosts.length > 0 && (
        <section class="reveal-section space-y-8">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div class="space-y-2">
              <h2 class="text-2xl md:text-3xl font-bold section-title">Latest Articles &amp; Insights</h2>
            </div>
            <a
              href="/blog/"
              class="text-sm font-semibold text-brand-400 hover:text-brand-300 transition-colors inline-flex items-center gap-1"
            >
              Browse all articles &rarr;
            </a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-5 stagger-children">
            {allBlogPosts.slice(0, 3).map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="group glass-card glass-card-hover rounded-2xl p-6 block"
              >
                <div class="flex items-center gap-2 text-xs font-mono text-brand-400 mb-3">
                  <span class="badge badge-brand capitalize font-sans">{post.data.category}</span>
                  <span class="text-slate-600">•</span>
                  <span class="text-slate-500">
                    {new Date(post.data.date).toLocaleDateString('en-US', {
                      month: 'short',
                      day: 'numeric',
                      year: 'numeric',
                    })}
                  </span>
                </div>
                <h3 class="text-base font-bold text-white group-hover:text-brand-300 transition-colors duration-300 mb-2 leading-snug">
                  {post.data.title}
                </h3>
                <p class="text-slate-500 text-xs line-clamp-2 leading-relaxed">
                  {post.data.description}
                </p>
                <div class="mt-4">
                  <span class="text-xs font-semibold text-brand-400 group-hover:translate-x-1 inline-block transition-transform duration-300">
                    Read Article &rarr;
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- ======== TOOLS SHOWCASE ======== -->
    <section id="advanced-calculators" class="reveal-section scroll-mt-24">
      <div class="glass-card p-8 sm:p-10 rounded-2xl glow-brand space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-3">
          <h2 class="text-2xl sm:text-3xl font-extrabold section-title">
            Explore Dedicated KG to Litre Tools
          </h2>
          <p class="text-sm text-slate-400 leading-relaxed max-w-lg mx-auto">
            Each tool features a unique calculator tailored to the substance density, formula
            mechanics, and search intent.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 stagger-children">
          {
            toolsData.map((tool) => (
              <a
                href={getToolPath(tool)}
                class="block p-5 rounded-xl bg-surface-900/60 border border-white/[0.05] hover:border-brand-500/30 transition-all duration-300 group hover:bg-surface-900/90"
                style="transform: translateY(0); transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;"
                onmouseenter="this.style.transform='translateY(-3px)'"
                onmouseleave="this.style.transform='translateY(0)'"
              >
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-500 to-brand-700 text-white font-mono font-bold text-xs flex items-center justify-center shadow-sm shadow-brand-500/20">
                    &sum;
                  </span>
                  <span class="badge badge-brand text-[9px]">Unique Calculator</span>
                </div>
                <h3 class="text-sm font-bold text-white group-hover:text-brand-300 transition-colors duration-300 mb-1">
                  {tool.h1}
                </h3>
                <p class="text-[11px] text-slate-500 line-clamp-1 font-mono">{tool.mainQuestion}</p>
              </a>
            ))
          }
        </div>

        <div class="text-center pt-2">
          <a href="/tools/" class="btn-primary inline-flex items-center gap-2">
            <span>View All {toolsData.length} Specialised Calculators</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
            >
          </a>
        </div>
      </div>
    </section>

    <!-- Engine Oil Viscosity Comparison Chart Section -->
    <section class="reveal-section max-w-5xl mx-auto">
      <EngineOilViscosityChartCard />
    </section>

    <!-- FAQ Section -->
    <section class="reveal-section space-y-8">
      <div class="text-center max-w-2xl mx-auto space-y-3">
        <h2 class="text-2xl md:text-3xl font-bold section-title">Frequently Asked Questions</h2>
      </div>
      <FAQAccordion />
    </section>
  </div>
</BaseLayout>
