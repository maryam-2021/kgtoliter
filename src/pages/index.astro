---
import BaseLayout from '../layouts/BaseLayout.astro';
import CalculatorWidget from '../components/CalculatorWidget.astro';
import SubstanceCard from '../components/SubstanceCard.astro';
import HeroDensityVisualizer from '../components/interactive/HeroDensityVisualizer.astro';
import FormulaPlayground from '../components/interactive/FormulaPlayground.astro';
import VolumeComparisonSlider from '../components/interactive/VolumeComparisonSlider.astro';
import IndustrialVolumeComparisonCard from '../components/interactive/IndustrialVolumeComparisonCard.astro';
import AdvancedBatchConverter from '../components/interactive/AdvancedBatchConverter.astro';
import SubcategoriesGridCard from '../components/interactive/SubcategoriesGridCard.astro';
import EngineOilViscosityChartCard from '../components/interactive/EngineOilViscosityChartCard.astro';
import TemperatureDensitySlider from '../components/interactive/TemperatureDensitySlider.astro';
import InteractiveConversionTable from '../components/interactive/InteractiveConversionTable.astro';
import FAQAccordion from '../components/interactive/FAQAccordion.astro';
import { catalogItems } from '../data/catalog.ts';
import { featuredSubstances } from '../data/substances';
import { getToolPath, toolsData } from '../data/toolsData.ts';
import { getCollection } from 'astro:content';

// Title
const title = 'KG to Liters Converter | Free Online kg to L Calculator';
const description =
  'Convert kg to liters instantly with our free calculator. 772+ substances. Water, oil, milk, diesel, gasoline. Two-way conversion kg to L and L to kg.';

// Define the Schema Array
const homepageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'KG to Liters Converter',
    url: 'https://kgtoliter.com/',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Kg to Litre and Litre to Kg Calculator',
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'Any',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'kg to liters Converter',
    applicationCategory: 'Calculator Application',
    operatingSystem: 'All',
    browserRequirements: 'JavaScript',
    description: 'Free online kg to liters converter for 772+ substances.',
    url: 'https://kgtoliter.com/',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is kg to litres?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Kg to litres is a conversion that transforms mass (in kilograms) into volume (in litres). Formula: Volume (L) = Mass (kg) ÷ Density (kg/L). Since different substances have different densities, 1 kg of water equals 1 litre, while 1 kg of honey equals 0.704 litres.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is 1 kg to litres?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "1 kg to litres varies depending on the substance's density. For water at 20°C, 1 kg = 1.000 L (density 1.000 kg/L). For milk, 1 kg = 0.971 L. For olive oil, 1 kg = 1.099 L. For honey, 1 kg = 0.704 L. For diesel, 1 kg = 1.202 L. For gasoline, 1 kg = 1.337 L.",
        },
      },
      {
        '@type': 'Question',
        name: 'What is kg to l?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Kg to l is the shorthand for converting kilograms (kg) to litres (L) based on density: Volume (L) = Mass (kg) ÷ Density (kg/L).',
        },
      },
      {
        '@type': 'Question',
        name: 'How much is 1 kg to 1 litre?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '1 kg equals 1 litre only for pure water at standard temperature (20°C) where density is 1.000 kg/L. For other substances, 1 kg = 1 ÷ Density (kg/L) in litres.',
        },
      },
      {
        '@type': 'Question',
        name: 'How many kg to a litre?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The number of kilograms in a litre depends on density: Mass (kg) = Volume (L) × Density (kg/L). For water, 1 L = 1.000 kg; milk = 1.030 kg; olive oil = 0.910 kg; honey = 1.420 kg; diesel = 0.832 kg; gasoline = 0.748 kg.',
        },
      },
      {
        '@type': 'Question',
        name: 'How to calculate kg to litre?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'To calculate kg to litres: 1. Identify substance. 2. Find its density in kg/L. 3. Apply formula Volume (L) = Mass (kg) ÷ Density (kg/L). Example: 5 kg of olive oil (0.910 kg/L) = 5 ÷ 0.910 = 5.495 litres.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is 1kg equivalent to 1 litre?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '1kg is equivalent to 1 litre only for water at 20°C (density 1.0 kg/L). For other liquids like milk (0.971 L/kg) or olive oil (1.099 L/kg), 1kg is not equivalent to 1 litre.',
        },
      },
      {
        '@type': 'Question',
        name: 'How much litre in one barrel?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '1 standard US oil barrel equals 42 US gallons or 158.987 litres. 1 UK barrel equals 163.659 litres.',
        },
      },
      {
        '@type': 'Question',
        name: 'How much litre in 1 gallon?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '1 US liquid gallon equals 3.78541 litres (1 L = 0.26417 US gal). 1 UK (Imperial) gallon equals 4.54609 litres (1 L = 0.21997 UK gal).',
        },
      },
      {
        '@type': 'Question',
        name: 'How many kg is 1 litre of water?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '1 litre of water weighs exactly 1 kilogram at 20°C with density 1.000 kg/L.',
        },
      },
      {
        '@type': 'Question',
        name: 'How much is 1 kilolitre (kL)?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '1 kilolitre (kL) equals exactly 1,000 litres (L), 264.17 US gallons, 219.97 UK gallons, or 6.29 US oil barrels.',
        },
      },
      {
        '@type': 'Question',
        name: 'How much is litre to ml?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: '1 litre (L) equals 1,000 millilitres (ml). Formula: ml = Litres × 1,000.',
        },
      },
      {
        '@type': 'Question',
        name: 'How much is litre to kg?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'To convert litres to kilograms, multiply volume by substance density: Mass (kg) = Volume (L) × Density (kg/L). For water, 1 L = 1 kg; for milk, 1 L = 1.030 kg; for honey, 1 L = 1.420 kg; for petrol, 1 L = 0.748 kg.',
        },
      },
    ],
  },
];

const allGuides = await getCollection('guides');
const allBlogPosts = await getCollection('blog', ({ data }) => !data.draft);

const featureLinks = [
  {
    href: '/batch-converter/',
    eyebrow: 'Batch & CSV',
    title: 'Bulk Converter',
    description: 'Convert multiple substances or upload CSV files.',
  },
  {
    href: '/container-calculator/',
    eyebrow: '3D Geometry',
    title: 'Container & Tank Solver',
    description: 'Calculate volume and liquid weight for tanks & drums.',
  },
  {
    href: '/custom-density-calculator/',
    eyebrow: '3-Way Solver',
    title: 'Custom Density Solver',
    description: 'Solve for mass, volume, or density with temperature correction.',
  },
  {
    href: '/api-docs/',
    eyebrow: 'Developer API',
    title: 'REST API & Docs',
    description: `Access our complete suite of unit converters.`,
  },
  {
    href: '#density-directory',
    eyebrow: 'Directory',
    title: 'Density Catalogue',
    description: `Filter all ${catalogItems.length} verified substance records.`,
  },
  {
    href: '/tools/',
    eyebrow: 'Directory',
    title: 'All Specialised Tools',
    description: `Access our complete suite of unit converters.`,
  },
];
---

<BaseLayout title={title} description={description} schema={homepageSchema}>
  <!-- ======== HERO SECTION ======== -->
  <section class="max-w-5xl mx-auto px-4 pt-16 pb-8 md:pt-24 md:pb-12">
    <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-start mb-8">
      <div class="animate-fade-in-up space-y-6">
        <!-- H1 with gradient -->
        <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-extrabold leading-[1.1] tracking-tight">
          <span class="gradient-text">kg to Liters Converter</span>
          <span class="block text-lg md:text-xl font-semibold text-slate-400 mt-2 tracking-normal">Free Online kg to L Calculator</span>
        </h1>

        <!-- Refined subtitle with keyword in first 100 words -->
        <p class="text-lg text-slate-400 leading-relaxed max-w-md">
          Use our free <strong class="text-slate-200">kg to liters converter</strong> to instantly convert <strong class="text-slate-200">kilograms (kg) to liters (L)</strong> or litres to kilograms for 772+ substances with lab-grade reference density values.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="#calculator-root" class="btn-primary inline-flex items-center gap-2">
            Start Converting
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
          </a>
          <a href="#density-directory" class="btn-secondary inline-flex items-center gap-2">
            Browse 772+ Substances
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
          </a>
        </div>

        <!-- Quick Links -->
        <div class="quick-links pt-1">
          <a href="/kg-to-litres/">What is kg to litres?</a>
          <a href="/kg-to-l/">Kg to L quick reference</a>
          <a href="/substances/water/">1 kg to litres water</a>
          <a href="/substances/milk/">1 kg to litres milk</a>
        </div>
      </div>

      <!-- Interactive Visual Diagram with ambient glow -->
      <div class="animate-slide-in-right hero-glow">
        <HeroDensityVisualizer />
      </div>
    </div>

    <!-- Calculator Widget -->
    <div class="animate-fade-in-up mt-4" style="animation-delay: 0.2s;">
      <CalculatorWidget />
    </div>
  </section>

  <!-- ======== TRUST BAR ======== -->
  <div class="max-w-5xl mx-auto px-4">
    <div class="divider-glow"></div>
    <div class="trust-bar" role="complementary" aria-label="Platform statistics">
      <span class="trust-bar-item">
        <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
        772+ Substances
      </span>
      <span class="trust-bar-divider" aria-hidden="true"></span>
      <span class="trust-bar-item">
        <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        Lab-Grade Density Data
      </span>
      <span class="trust-bar-divider" aria-hidden="true"></span>
      <span class="trust-bar-item">
        <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        Free Forever
      </span>
      <span class="trust-bar-divider" aria-hidden="true"></span>
      <span class="trust-bar-item">
        <svg class="trust-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        18 Languages
      </span>
    </div>
    <div class="divider-glow"></div>
  </div>

  <!-- ======== KEYWORD-OPTIMIZED CONTENT SECTION ======== -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <h2 class="text-2xl md:text-3xl font-bold section-title mb-4">kg to Liters Converter — Free & Accurate</h2>
    <p class="text-slate-300 leading-relaxed max-w-3xl">
      Convert <strong class="text-white">kg to liters</strong> instantly with our free online calculator. Whether you need to convert <strong class="text-white">kg to L</strong> for water, oil, milk, diesel, or gasoline, our tool provides accurate results for 772+ substances. Use our <strong class="text-white">kilograms to liters</strong> converter for cooking, fuel calculations, or industrial applications.
    </p>
    <nav aria-label="Quick conversion links" class="mt-6">
      <ul class="flex flex-wrap gap-3 text-sm">
        <li>
          <a href="/kg-to-liters-converter/" class="text-brand-400 hover:text-brand-300 underline underline-offset-2 transition-colors">kg to liters converter — free tool</a>
        </li>
        <li>
          <a href="/kg-to-l/" class="text-brand-400 hover:text-brand-300 underline underline-offset-2 transition-colors">kg to L — quick conversion guide</a>
        </li>
        <li>
          <a href="/kilogram-to-liter/" class="text-brand-400 hover:text-brand-300 underline underline-offset-2 transition-colors">kilogram to liter — complete reference</a>
        </li>
        <li>
          <a href="/kg-to-litres/" class="text-brand-400 hover:text-brand-300 underline underline-offset-2 transition-colors">kg to litres — UK spelling guide</a>
        </li>
      </ul>
    </nav>
  </section>

  <!-- ======== CONTENT SECTIONS ======== -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-24 pb-16">
    <!-- Popular Substance Conversions Section -->
    <section class="reveal-section">
      <div class="text-center max-w-2xl mx-auto space-y-3 mb-8">
        <h2 class="text-2xl md:text-3xl font-bold section-title">Popular Substance Conversions</h2>
        <p class="text-slate-400 text-sm leading-relaxed max-w-lg mx-auto">
          Instant mass-to-volume references for the most frequently calculated liquids.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {
          featuredSubstances.map((substance) => (
            <SubstanceCard
              id={substance.id === 'gasoline' ? 'petrol' : substance.id}
              name={substance.name}
              density={substance.density}
              icon={substance.icon}
            />
          ))
        }
      </div>
    </section>

    <nav aria-label="Interactive feature navigation" class="reveal-section">
      <div class="text-center max-w-2xl mx-auto space-y-3 mb-8">
        <h2 class="text-2xl md:text-3xl font-bold section-title">Choose a Conversion Feature</h2>
        <p class="text-slate-400 text-sm leading-relaxed max-w-lg mx-auto">
          Jump directly to a calculator, simulator, comparison, or searchable density reference.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {
          featureLinks.map((feature) => (
            <a
              href={feature.href}
              class="glass-card glass-card-hover rounded-2xl p-6 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-400"
            >
              <span class="text-[10px] uppercase tracking-[0.18em] text-brand-400/80 font-semibold">
                {feature.eyebrow}
              </span>
              <span class="flex items-center justify-between gap-3 mt-2.5">
                <strong class="text-white group-hover:text-brand-300 transition-colors">
                  {feature.title}
                </strong>
                <span
                  aria-hidden="true"
                  class="text-slate-600 group-hover:text-brand-400 group-hover:translate-x-1 transition-all"
                >
                  &rarr;
                </span>
              </span>
              <span class="block text-xs text-slate-500 mt-2.5 leading-relaxed">
                {feature.description}
              </span>
            </a>
          ))
        }
      </div>
    </nav>

    <!-- Formula Playground -->
    <section id="interactive-sliders" class="reveal-section scroll-mt-24">
      <div class="text-center max-w-2xl mx-auto space-y-3 mb-10">
        <h2 class="text-2xl md:text-3xl font-bold section-title">
          Kg to Litre and Litre to Kg Formulas
        </h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed max-w-lg mx-auto">
          Divide mass by density for litres: V = m ÷ ρ. Multiply volume by density for kilograms: m
          = V × ρ. Drag the sliders below to explore the relationship in real time.
        </p>
      </div>
      <div class="max-w-3xl mx-auto">
        <FormulaPlayground />
      </div>
    </section>

    <!-- ======== QUICK SUBSTANCE CONVERSIONS GRID ======== -->
    <section class="reveal-section scroll-mt-24" id="quick-substance-conversions">
      <div class="text-center max-w-2xl mx-auto space-y-3 mb-8">
        <h2 class="text-2xl md:text-3xl font-bold section-title">Convert kg to Liters for Any Substance</h2>
        <p class="text-slate-400 text-sm leading-relaxed max-w-lg mx-auto">
          Our <strong class="text-slate-200">kg to liters</strong> converter supports 772+ substances across 25+ categories. Whether you need to convert <strong class="text-slate-200">kg to L</strong> for cooking, fuel, or industrial applications, we have you covered.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 stagger-children">
        <a href="/substances/water/" class="glass-card glass-card-hover rounded-2xl p-5 text-center block group">
          <div class="text-2xl mb-2">💧</div>
          <h3 class="text-sm font-bold text-white group-hover:text-brand-300 transition-colors">kg to Liters Water</h3>
          <div class="font-bold text-brand-400 font-mono mt-1">1 kg = 1.000 L</div>
          <div class="text-[11px] text-slate-500 font-mono">(1.000 kg/L)</div>
          <span class="text-[11px] text-brand-400 mt-2 inline-block font-semibold group-hover:translate-x-0.5 transition-transform">Convert &rarr;</span>
        </a>
        <a href="/substances/milk/" class="glass-card glass-card-hover rounded-2xl p-5 text-center block group">
          <div class="text-2xl mb-2">🥛</div>
          <h3 class="text-sm font-bold text-white group-hover:text-brand-300 transition-colors">kg to Liters Milk</h3>
          <div class="font-bold text-brand-400 font-mono mt-1">1 kg = 0.971 L</div>
          <div class="text-[11px] text-slate-500 font-mono">(1.030 kg/L)</div>
          <span class="text-[11px] text-brand-400 mt-2 inline-block font-semibold group-hover:translate-x-0.5 transition-transform">Convert &rarr;</span>
        </a>
        <a href="/substances/olive-oil/" class="glass-card glass-card-hover rounded-2xl p-5 text-center block group">
          <div class="text-2xl mb-2">🫒</div>
          <h3 class="text-sm font-bold text-white group-hover:text-brand-300 transition-colors">kg to Liters Oil</h3>
          <div class="font-bold text-brand-400 font-mono mt-1">1 kg = 1.099 L</div>
          <div class="text-[11px] text-slate-500 font-mono">(0.910 kg/L)</div>
          <span class="text-[11px] text-brand-400 mt-2 inline-block font-semibold group-hover:translate-x-0.5 transition-transform">Convert &rarr;</span>
        </a>
        <a href="/substances/diesel/" class="glass-card glass-card-hover rounded-2xl p-5 text-center block group">
          <div class="text-2xl mb-2">⛽</div>
          <h3 class="text-sm font-bold text-white group-hover:text-brand-300 transition-colors">kg to Liters Diesel</h3>
          <div class="font-bold text-brand-400 font-mono mt-1">1 kg = 1.202 L</div>
          <div class="text-[11px] text-slate-500 font-mono">(0.832 kg/L)</div>
          <span class="text-[11px] text-brand-400 mt-2 inline-block font-semibold group-hover:translate-x-0.5 transition-transform">Convert &rarr;</span>
        </a>
        <a href="/substances/petrol/" class="glass-card glass-card-hover rounded-2xl p-5 text-center block group">
          <div class="text-2xl mb-2">🚗</div>
          <h3 class="text-sm font-bold text-white group-hover:text-brand-300 transition-colors">kg to Liters Gasoline</h3>
          <div class="font-bold text-brand-400 font-mono mt-1">1 kg = 1.337 L</div>
          <div class="text-[11px] text-slate-500 font-mono">(0.748 kg/L)</div>
          <span class="text-[11px] text-brand-400 mt-2 inline-block font-semibold group-hover:translate-x-0.5 transition-transform">Convert &rarr;</span>
        </a>
        <a href="/substances/honey/" class="glass-card glass-card-hover rounded-2xl p-5 text-center block group">
          <div class="text-2xl mb-2">🍯</div>
          <h3 class="text-sm font-bold text-white group-hover:text-brand-300 transition-colors">kg to Liters Honey</h3>
          <div class="font-bold text-brand-400 font-mono mt-1">1 kg = 0.704 L</div>
          <div class="text-[11px] text-slate-500 font-mono">(1.420 kg/L)</div>
          <span class="text-[11px] text-brand-400 mt-2 inline-block font-semibold group-hover:translate-x-0.5 transition-transform">Convert &rarr;</span>
        </a>
      </div>
    </section>

    <!-- How Much is kg to Litres Section -->
    <section class="content-block reveal-section max-w-4xl mx-auto scroll-mt-24" id="how-much-is-kg-to-litres">
      <h2 class="text-2xl md:text-3xl font-bold section-title">KG to Liters Converter: How Much is kg to Liters?</h2>
      <p class="text-slate-300 mt-2">The conversion from kilograms (kg) to litres (L) depends on the substance's density. The formula is:</p>
      
      <div class="formula-box my-4">
        <strong>Volume (L) = Mass (kg) &divide; Density (kg/L)</strong>
      </div>
      
      <div class="conversion-grid my-4">
        <div class="conversion-card highlight">
          <h3 class="font-bold text-white text-base">Water</h3>
          <div class="conversion-value text-brand-400 font-mono font-bold">1 kg = 1.000 L</div>
          <div class="density text-xs text-slate-500 font-mono">(1.000 kg/L)</div>
        </div>
        <div class="conversion-card">
          <h3 class="font-bold text-white text-base">Milk</h3>
          <div class="conversion-value text-brand-400 font-mono font-bold">1 kg = 0.971 L</div>
          <div class="density text-xs text-slate-500 font-mono">(1.030 kg/L)</div>
        </div>
