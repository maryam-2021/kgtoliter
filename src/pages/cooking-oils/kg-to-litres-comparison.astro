---
// src/pages/cooking-oils/kg-to-litres-comparison.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQAccordion from '../../components/interactive/FAQAccordion.astro';
import VolumeComparisonSlider from '../../components/interactive/VolumeComparisonSlider.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import { comparisonGuides } from '../../data/comparisonGuides';

const guide = comparisonGuides.find(g => g.slug === 'cooking-oils-density')!;

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: 'Kg to Litres: All Cooking Oils Compared',
    description: 'Complete comparison of cooking oil densities (olive, canola, sunflower, coconut oil). Density tables, volume per kg, and culinary scaling.',
    author: {
      '@type': 'Organization',
      name: 'Kg to Litre Engineering Team',
      url: 'https://kgtoliter.com/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Kg to Litre',
      url: 'https://kgtoliter.com/',
      logo: {
        '@type': 'ImageObject',
        url: 'https://kgtoliter.com/favicon.svg',
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': 'https://kgtoliter.com/cooking-oils/kg-to-litres-comparison/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: guide.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];
---

<BaseLayout
  title="Kg to Litres: All Cooking Oils Compared | Full Density Matrix"
  description="Compare densities of all cooking oils (olive, canola, sunflower, coconut, peanut). Instant kg to litres conversion tables and recipe scaling guide."
  canonicalUrl="https://kgtoliter.com/cooking-oils/kg-to-litres-comparison/"
  schema={pageSchema}
>
  <main class="container mx-auto px-4 py-10 max-w-5xl space-y-10">
    <!-- Breadcrumbs -->
    <BreadcrumbNav
      categoryName="Cooking Oils"
      categorySlug="cooking-oils"
      substanceName="All Cooking Oils Compared"
    />

    <!-- Header Block -->
    <header class="text-center space-y-4 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 text-xs font-mono font-semibold rounded-full bg-purple-500/10 text-purple-400 border border-purple-500/20 uppercase tracking-wider">
        <span>🍳 Domain B: Cooking Oils Cluster</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
        Kg to Litres: <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-brand-400">All Cooking Oils Compared</span>
      </h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
        {guide.subtitle}
      </p>
    </header>

    <!-- Side by Side Dual Visual Cards -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="glass-card bg-surface-950/90 border border-brand-500/30 rounded-2xl p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
          <span class="text-xs font-mono font-bold text-brand-400 uppercase tracking-wider">{guide.itemA.category}</span>
          <span class="text-xs font-mono text-slate-400">{guide.itemA.temp}°C Ref</span>
        </div>
        <div>
          <h2 class="text-2xl font-black text-white">{guide.itemA.name}</h2>
          <p class="text-xs text-slate-400 mt-1">{guide.itemA.notes}</p>
        </div>
        <div class="grid grid-cols-3 gap-2 text-center pt-2">
          <div class="p-3 rounded-xl bg-surface-900 border border-white/5">
            <span class="text-[10px] font-mono text-slate-500 uppercase block">Density</span>
            <span class="text-sm font-bold text-brand-400 font-mono block mt-1">{guide.itemA.density.toFixed(3)} kg/L</span>
          </div>
          <div class="p-3 rounded-xl bg-surface-900 border border-white/5">
            <span class="text-[10px] font-mono text-slate-500 uppercase block">1 Litre</span>
            <span class="text-sm font-bold text-white font-mono block mt-1">{guide.itemA.massPerLiter}</span>
          </div>
          <div class="p-3 rounded-xl bg-surface-900 border border-white/5">
            <span class="text-[10px] font-mono text-slate-500 uppercase block">1 kg Volume</span>
            <span class="text-sm font-bold text-emerald-400 font-mono block mt-1">{guide.itemA.volumePerKg}</span>
          </div>
        </div>
      </div>

      <div class="glass-card bg-surface-950/90 border border-purple-500/30 rounded-2xl p-6 space-y-4 shadow-xl">
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
          <span class="text-xs font-mono font-bold text-purple-400 uppercase tracking-wider">{guide.itemB.category}</span>
          <span class="text-xs font-mono text-slate-400">{guide.itemB.temp}°C Ref</span>
        </div>
        <div>
          <h2 class="text-2xl font-black text-white">{guide.itemB.name}</h2>
          <p class="text-xs text-slate-400 mt-1">{guide.itemB.notes}</p>
        </div>
        <div class="grid grid-cols-3 gap-2 text-center pt-2">
          <div class="p-3 rounded-xl bg-surface-900 border border-white/5">
            <span class="text-[10px] font-mono text-slate-500 uppercase block">Density</span>
            <span class="text-sm font-bold text-purple-400 font-mono block mt-1">{guide.itemB.density.toFixed(3)} kg/L</span>
          </div>
          <div class="p-3 rounded-xl bg-surface-900 border border-white/5">
            <span class="text-[10px] font-mono text-slate-500 uppercase block">1 Litre</span>
            <span class="text-sm font-bold text-white font-mono block mt-1">{guide.itemB.massPerLiter}</span>
          </div>
          <div class="p-3 rounded-xl bg-surface-900 border border-white/5">
            <span class="text-[10px] font-mono text-slate-500 uppercase block">1 kg Volume</span>
            <span class="text-sm font-bold text-emerald-400 font-mono block mt-1">{guide.itemB.volumePerKg}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Master Comparative Table of All Cooking Oils -->
    <section class="glass-card bg-surface-950/80 border border-white/[0.08] rounded-2xl p-6 sm:p-8 space-y-4">
      <h2 class="text-2xl font-bold text-white">Full 12-Oil Density &amp; Volume Conversion Matrix</h2>
      <div class="overflow-x-auto rounded-xl border border-white/5">
        <table class="w-full text-left text-sm font-sans">
          <thead class="bg-surface-900 text-xs font-mono uppercase text-slate-400">
            <tr>
              {guide.comparisonTable.headers.map((h) => (
                <th class="py-3.5 px-4">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5 text-slate-300 font-mono text-xs sm:text-sm">
            {guide.comparisonTable.rows.map((row) => (
              <tr class="hover:bg-white/[0.02]">
                {row.map((cell, idx) => (
                  <td class={`py-3.5 px-4 ${idx === 0 ? 'font-semibold text-white font-sans' : idx === 2 ? 'text-brand-400' : idx === 3 ? 'text-emerald-400' : ''}`}>
                    {cell}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Interactive Visualizer -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-white">Interactive Volume Comparison</h2>
      <VolumeComparisonSlider />
    </section>

    <!-- FAQs -->
    <section class="space-y-4">
      <div class="text-center space-y-2">
        <h2 class="text-2xl font-bold text-white">Frequently Asked Questions</h2>
        <p class="text-xs sm:text-sm text-slate-400">Culinary conversion and cooking oil density FAQs.</p>
      </div>
      <FAQAccordion faqs={guide.faqs} />
    </section>

  </main>
</BaseLayout>
