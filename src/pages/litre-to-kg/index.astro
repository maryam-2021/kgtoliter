  { name: 'Heavy Fuel Oil (HFO / Bunker C)', density: 0.960, cat: 'fuels', id: 'fuel-oil', note: 'Marine propulsion bunker fuel', standard: 'ISO 8217' },
  { name: 'Engine Oil (SAE 0W-20 Full Synth)', density: 0.845, cat: 'automotive', id: 'engine-oil', note: 'PAO synthetic lubricant', standard: 'SAE J300 / API SP' },
  { name: 'Engine Oil (SAE 5W-30 Synthetic)', density: 0.855, cat: 'automotive', id: 'engine-oil', note: 'Standard passenger car oil', standard: 'SAE J300 / API SP' },
  { name: 'Engine Oil (SAE 10W-40 Semi-Synth)', density: 0.872, cat: 'automotive', id: 'engine-oil', note: 'Part synthetic blend', standard: 'SAE J300' },
  { name: 'Engine Oil (SAE 15W-40 Heavy Duty)', density: 0.880, cat: 'automotive', id: 'engine-oil', note: 'Commercial diesel engine oil', standard: 'API CK-4 / CJ-4' },
