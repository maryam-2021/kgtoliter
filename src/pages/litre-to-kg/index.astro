  { name: 'Engine Coolant / Antifreeze (50/50)', density: 1.065, cat: 'automotive', id: 'coolant', note: '50% Ethylene glycol aqueous', standard: 'ASTM D3306' },
  { name: 'Pure Ethylene Glycol (100%)', density: 1.113, cat: 'industrial', id: 'ethylene-glycol', note: 'Industrial coolant concentrate', standard: 'CRC Handbook' },
  { name: 'Pure Propylene Glycol (USP)', density: 1.036, cat: 'industrial', id: 'propylene-glycol', note: 'Non-toxic food grade chiller fluid', standard: 'USP / EP Monograph' },
