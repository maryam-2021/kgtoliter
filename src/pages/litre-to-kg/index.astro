  { name: 'Acetone (HPLC / Tech Grade)', density: 0.784, cat: 'industrial', id: 'acetone', note: 'Volatile polar solvent (UN 1090)', standard: 'ASTM D329 / CRC' },
  { name: 'Ethanol (100% Anhydrous Alcohol)', density: 0.789, cat: 'industrial', id: 'ethanol', note: 'Absolute ethyl alcohol (UN 1170)', standard: 'USP / BP Standards' },
  { name: 'Ethanol (96% Azeotropic / Rectified)', density: 0.806, cat: 'industrial', id: 'ethanol', note: 'Distilled spirit / disinfectant', standard: 'Ph. Eur.' },
  { name: 'Isopropyl Alcohol (99% IPA)', density: 0.786, cat: 'industrial', id: 'isopropyl-alcohol', note: 'Precision electronic solvent (UN 1219)', standard: 'ASTM D770' },
  { name: 'Methanol (Methyl Alcohol 99.9%)', density: 0.792, cat: 'industrial', id: 'methanol', note: 'Industrial solvent (UN 1230)', standard: 'IMPCA Standard' },
  { name: 'Toluene (Methylbenzene 99.8%)', density: 0.867, cat: 'industrial', id: 'toluene', note: 'Aromatic solvent (UN 1294)', standard: 'ASTM D841' },
