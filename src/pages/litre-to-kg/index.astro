  { name: 'Premium Super Unleaded (98 RON)', density: 0.755, cat: 'fuels', id: 'petrol', note: 'High aromatic octane blend', standard: 'EN 228' },
  { name: 'E10 Petrol (10% Ethanol Blend)', density: 0.752, cat: 'fuels', id: 'petrol', note: 'Standard pump gasoline', standard: 'EN 228 / ASTM D4814' },
  { name: 'E85 Flex-Fuel (85% Ethanol)', density: 0.782, cat: 'fuels', id: 'ethanol', note: 'High ethanol renewable fuel', standard: 'ASTM D5798' },
