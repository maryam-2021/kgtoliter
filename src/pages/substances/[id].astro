---
import Layout from '../../layouts/Layout.astro';
import Converter from '../../components/Converter.astro';
import FormulaGuide from '../../components/FormulaGuide.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { substances } from '../../data/substances';
import type { Substance } from '../../data/substances';

export async function getStaticPaths() {
  return substances.map((substance) => ({
    params: { id: substance.id },
    props: { substance },
  }));
}

interface Props {
  substance: Substance;
}

const { substance } = Astro.props;
const canonicalUrl = `/${substance.category}/kg-to-litres-${substance.id}/`;

const volumePer1Kg = (1 / substance.density_kg_per_l).toFixed(3);
const massPer1L = substance.density_kg_per_l.toFixed(3);

// Get related substances in the same category from top substances
const categoryMatches = substances.filter(
  (s) => s.category === substance.category && s.id !== substance.id,
);
const relatedSubstances = (
  categoryMatches.length > 0
    ? categoryMatches
    : substances.filter((s) => s.id !== substance.id)
).slice(0, 4);

// Calculate conversions table
const conversionSteps = [1, 5, 10, 25, 50, 100];
const conversions = Object.fromEntries(
  conversionSteps.map((kg) => [`${kg}kg`, kg / substance.density_kg_per_l]),
);

const substanceFaqs = [
  {
    q: 'Is 1 kg equal to 1 litre?',
    a: `Only for water approximately (at 4°C, 1 kg = 1.000 litre). For other substances like ${substance.name}, you need density (${substance.density_kg_per_l} kg/L).`,
  },
  {
    q: `How many litres is 1 kg of ${substance.name}?`,
    a: `Using density ${substance.density_kg_per_l} kg/L, 1 kg of ${substance.name} is approximately ${volumePer1Kg} litres (${(parseFloat(volumePer1Kg) * 1000).toFixed(0)} mL).`,
  },
  {
    q: 'How do you convert kg to litres?',
    a: `Divide mass in kg by density in kg/L. Formula: Volume (L) = Mass (kg) ÷ Density (kg/L). For ${substance.name}, divide mass in kg by ${substance.density_kg_per_l}.`,
  },
  {
    q: `How much does 1 litre of ${substance.name} weigh in kg?`,
    a: `1 litre of ${substance.name} weighs approximately ${massPer1L} kilograms (${(parseFloat(massPer1L) * 1000).toFixed(0)} grams). Formula: Mass (kg) = Volume (L) × Density (kg/L).`,
  },
];

const substanceSchema: Record<string, any>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://kgtoliter.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: `${substance.category.charAt(0).toUpperCase() + substance.category.slice(1)} Category`,
        item: `https://kgtoliter.com/${substance.category}/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: `Convert Kg to Litres of ${substance.name}`,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: `Kg to Litres of ${substance.name} Calculator`,
    applicationCategory: 'UtilityApplication',
    description: substance.seo.description,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: substanceFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  },
];

const sourceAuthority =
  substance.source ||
  (substance.category === 'fuels'
    ? 'European Standard EN 590 / ASTM D1298'
    : substance.category === 'cooking' || substance.category === 'basic'
      ? 'USDA FoodData Central / IUPAC'
      : substance.category === 'construction'
        ? 'ASTM International C29 / C138'
        : substance.category === 'automotive'
          ? 'SAE International / ASTM D4052'
          : 'CRC Handbook of Chemistry & Physics (104th Ed)');

const refTemp =
  substance.temperature ||
  (substance.category === 'fuels' ? 15 : substance.id === 'water' ? 4 : 20);

const minDensity = (substance.density_kg_per_l * 0.97).toFixed(3);
const maxDensity = (substance.density_kg_per_l * 1.03).toFixed(3);
const densityRangeDisplay = substance.densityRange
  ? `${substance.densityRange.min.toFixed(3)} – ${substance.densityRange.max.toFixed(3)} kg/L`
  : `${minDensity} – ${maxDensity} kg/L`;

const lastUpdated = 'August 2026';
---

<Layout
  title={substance.seo.title}
  description={substance.seo.description}
  canonicalUrl={canonicalUrl}
  schema={substanceSchema}
>
  <section class="relative pt-12 pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <!-- Hero Header -->
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <a
          href="/"
          class="text-xs font-semibold text-brand-400 hover:text-brand-300 transition-colors inline-flex items-center gap-1 mb-2 font-mono"
        >
          &larr; Back to All Substances
        </a>
        <div
          class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-500/10 text-brand-400 text-xs font-mono border border-brand-500/20"
        >
          <span class="capitalize">{substance.category} Category</span>
          <span>•</span>
          <span>{substance.density_kg_per_l} kg/L</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Convert Kg to Litres of <span class="gradient-text">{substance.name}</span>
        </h1>
        <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
          {substance.seo.description}
        </p>
      </div>

      <!-- Main Interactive Calculator -->
      <Converter defaultSubstanceId={substance.id} />

      <!-- Quick Reference Conversion Table -->
      <div class="max-w-4xl mx-auto glass-card rounded-2xl p-6 sm:p-8 border border-slate-800 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-800">
          <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
            <span>{substance.name} Quick Conversion Table</span>
          </h2>
          <span class="text-xs font-mono text-slate-400">Standard {refTemp}&deg;C Reference</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm font-mono">
            <thead>
              <tr class="border-b border-slate-800 text-slate-400 text-xs uppercase tracking-wider">
                <th class="py-3 px-4 font-semibold">Mass (kg)</th>
                <th class="py-3 px-4 font-semibold text-brand-400">Volume (Litres)</th>
                <th class="py-3 px-4 font-semibold text-sky-400">Volume (mL)</th>
                <th class="py-3 px-4 font-semibold text-indigo-400">US Gallons</th>
                <th class="py-3 px-4 font-semibold text-purple-400">UK Gallons</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60">
              {
                Object.entries(conversions).map(([mass, volume]) => (
                  <tr class="hover:bg-slate-800/40 transition-colors">
                    <td class="py-3 px-4 font-bold text-white">{mass.replace('kg', ' kg')}</td>
                    <td class="py-3 px-4 font-bold text-brand-400">{volume.toFixed(3)} L</td>
                    <td class="py-3 px-4 text-slate-300">{(volume * 1000).toLocaleString('en-US', { maximumFractionDigits: 0 })} mL</td>
                    <td class="py-3 px-4 text-slate-300">{(volume / 3.78541).toFixed(3)} gal</td>
                    <td class="py-3 px-4 text-slate-300">{(volume / 4.54609).toFixed(3)} gal</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- Formula Explanation Section -->
      <div class="max-w-4xl mx-auto glass-card rounded-2xl p-6 sm:p-8 border border-slate-800 space-y-4">
        <h2 class="text-xl font-bold text-white">How to Convert {substance.name} from kg to Litres</h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          To convert {substance.name} from kilograms to litres, divide the mass (in kg) by its density (<span class="text-brand-400 font-mono font-bold">{substance.density_kg_per_l} kg/L</span>).
        </p>
        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 font-mono text-sm space-y-2">
          <div class="text-emerald-400 font-bold">Formula: Volume (L) = Mass (kg) ÷ Density (kg/L)</div>
          <div class="text-slate-400 text-xs">
            Example: 1 kg ÷ {substance.density_kg_per_l} kg/L = <span class="text-brand-400 font-bold">{volumePer1Kg} Litres</span>
          </div>
        </div>
      </div>

      <!-- Substance Detail & Authority Card -->
      <div
        class="max-w-4xl mx-auto glass-card rounded-2xl p-6 sm:p-8 border border-slate-800 space-y-6"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-slate-800">
          <h2 class="text-xl font-bold text-white">Physical Properties of {substance.name}</h2>
          <div class="flex items-center gap-2 text-[11px] text-slate-400 font-mono">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Verified: {lastUpdated}</span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
          <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
            <span class="block text-slate-400 text-xs font-mono uppercase">Density (&rho;)</span>
            <span class="text-xl font-extrabold text-brand-400 font-mono mt-1 block"
              >{substance.density_kg_per_l} kg/L</span
            >
            <span class="text-[11px] text-slate-500 block mt-1">{substance.density_note}</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
            <span class="block text-slate-400 text-xs font-mono uppercase">1 Kg equals</span>
            <span class="text-xl font-extrabold text-emerald-400 font-mono mt-1 block"
              >{volumePer1Kg} L</span
            >
            <span class="text-[11px] text-slate-500 block mt-1">Liquid volume</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-900 border border-slate-800">
            <span class="block text-slate-400 text-xs font-mono uppercase">1 Litre weighs</span>
            <span class="text-xl font-extrabold text-cyan-400 font-mono mt-1 block"
              >{massPer1L} kg</span
            >
            <span class="text-[11px] text-slate-500 block mt-1">Mass weight</span>
          </div>
        </div>

        <!-- Trust & Verification Metadata Box -->
        <div class="p-4 rounded-xl bg-surface-900/60 border border-white/[0.06] grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
          <div>
            <span class="text-slate-500 font-mono block uppercase">Source Authority</span>
            <span class="text-slate-300 font-semibold block mt-0.5">{sourceAuthority}</span>
          </div>
          <div>
            <span class="text-slate-500 font-mono block uppercase">Density Range / Tolerance</span>
            <span class="text-brand-400 font-mono font-bold block mt-0.5">{densityRangeDisplay}</span>
          </div>
          <div>
            <span class="text-slate-500 font-mono block uppercase">Standard Temperature</span>
            <span class="text-slate-300 font-mono font-bold block mt-0.5">{refTemp}°C Reference</span>
          </div>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-t border-slate-800/80">
          <div class="flex flex-wrap gap-2">
            <span
              class="px-2.5 py-1 rounded-md text-xs bg-brand-500/10 text-brand-300 border border-brand-500/20 font-mono"
            >
              {substance.seo.primary_kw}
            </span>
            {
              substance.seo.secondary_kws.map((kw) => (
                <span class="px-2.5 py-1 rounded-md text-xs bg-slate-800 text-slate-300 border border-slate-700/60 font-mono">
                  {kw}
                </span>
              ))
            }
          </div>
          <a
            href="/density-methodology/"
            class="text-[11px] font-mono text-brand-400 hover:text-brand-300 transition-colors inline-flex items-center gap-1 shrink-0"
          >
            Methodology &amp; Standards Policy &rarr;
          </a>
        </div>
      </div>

      <!-- Related Substances Section -->
      {
        relatedSubstances.length > 0 && (
          <div class="max-w-4xl mx-auto space-y-4">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>Related {substance.category.charAt(0).toUpperCase() + substance.category.slice(1)} Substances</span>
            </h2>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              {relatedSubstances.map((related) => (
                <a
                  href={`/substances/${related.id}/`}
                  class="glass-card glass-card-hover p-4 rounded-xl border border-slate-800 block group"
                >
                  <div class="text-xl mb-1">{related.id === 'water' ? '💧' : related.id === 'milk' ? '🥛' : related.id === 'olive-oil' ? '🫒' : related.id === 'honey' ? '🍯' : related.id === 'diesel' ? '⛽' : '⚗️'}</div>
                  <div class="font-bold text-sm text-white group-hover:text-brand-400 transition-colors truncate">
                    {related.name}
                  </div>
                  <div class="text-xs font-mono text-slate-400 mt-1">{related.density_kg_per_l.toFixed(3)} kg/L</div>
                  <div class="text-[11px] font-mono text-emerald-400 mt-0.5">
                    {(1 / related.density_kg_per_l).toFixed(3)} L/kg
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <FormulaGuide />
  <section class="max-w-4xl mx-auto px-4 py-8">
    <h2 class="text-2xl font-bold text-white text-center mb-6">Frequently Asked Questions</h2>
    <FAQAccordion faqs={substanceFaqs} />
  </section>
</Layout>
