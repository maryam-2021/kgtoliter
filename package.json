    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.0",
