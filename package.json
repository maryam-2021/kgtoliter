  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:api": "tsx watch server.js",
    "start": "astro dev",
    "api": "tsx server.js",
    "build": "astro build",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name kgtoliter --branch main",
